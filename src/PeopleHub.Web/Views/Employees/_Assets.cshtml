@model (AssetView V,int EmployeeId)
@{var v=Model.V;var id=Model.EmployeeId;bool hr=Me.Can(Perm.EmpManage);Func<string,string,string>X=(e,a)=>T.IsAr?a:e;var inventory=hr?(List<CompanyAsset>)ViewBag.Inventory:v.Assets;string State(string s)=>X(s,s switch{"Assigned"=>"مسند","Available"=>"متاح","Maintenance"=>"صيانة","Retired"=>"مستبعد",_=>s});}
<div class="card"><div class="card-h"><h2>@X("Assets and handover","العهد وتسليم الأصول")</h2></div><div class="card-b"><p class="muted small">@X("Fictional inventory. Assignment and return require condition and receipt evidence. Returning an asset does not automatically complete clearance. No payroll deduction is created.","مخزون وهمي. التسليم والاسترداد يتطلبان الحالة ودليل الاستلام. الاسترداد لا يكمل إخلاء الطرف تلقائيا ولا ينشئ خصما من الراتب.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Tag / asset","الكود / الأصل")</th><th>@X("State","الحالة")</th><th>@X("Condition","حالة الأصل")</th><th>@X("Due","موعد الرد")</th><th>@X("Holder","المستلم")</th></tr></thead><tbody>@foreach(var a in inventory){<tr><td><b>@a.Tag · @a.Name</b><div class="small muted">@a.Serial</div></td><td>@State(a.Status)</td><td>@a.Condition</td><td>@(a.DueOn is {} due?T.Date(due):"-")</td><td>@(a.AssignedEmployeeId?.ToString()??"-")</td></tr>}</tbody></table></div>
@if(hr){<form method="post" action="/Employees/MoveAsset" asp-antiforgery="true" class="form-grid" style="margin-top:20px"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Asset","الأصل")</label><select name="assetId">@foreach(var a in inventory.Where(a=>a.Status!="Retired")){<option value="@a.Id">@a.Tag · @a.Name · @State(a.Status)</option>}</select></div><div class="field"><label>@X("Action","الإجراء")</label><select name="movement"><option value="Assign">@X("Assign to this employee","تسليم لهذا الموظف")</option><option value="Return">@X("Return from holder","استرداد من المستلم")</option><option value="Maintenance">@X("Send to maintenance","إرسال للصيانة")</option><option value="Release">@X("Release from maintenance","انتهاء الصيانة")</option><option value="Retire">@X("Retire","استبعاد")</option></select></div><div class="field"><label>@X("Return due, optional for assignment","موعد الرد، اختياري عند التسليم")</label><input type="date" name="dueOn"></div><div class="field"><label>@X("Condition","حالة الأصل")</label><input name="condition" required maxlength="500"></div><div class="field full"><label>@X("Receipt / evidence and reason","محضر الاستلام / الدليل والسبب")</label><input name="evidence" required maxlength="1000"></div><div class="full"><button class="btn btn-primary">@X("Record movement","تسجيل الحركة")</button></div></form>}
</div></div>
@if(hr){<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Register asset","تسجيل أصل")</h2></div><div class="card-b"><form method="post" action="/Employees/RegisterAsset" asp-antiforgery="true" class="form-grid"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Unique tag","كود فريد")</label><input name="tag" required maxlength="50"></div><div class="field"><label>@X("Name","الاسم")</label><input name="name" required maxlength="150"></div><div class="field"><label>@X("Serial, optional","الرقم التسلسلي، اختياري")</label><input name="serial" maxlength="100"></div><div class="field"><label>@X("Initial condition","الحالة الأولية")</label><input name="condition" required maxlength="500"></div><div class="full"><button class="btn">@T["common.add"]</button></div></form></div></div>}
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("This employee's movement evidence","سجل حركات هذا الموظف")</h2></div><div class="card-b"><ul class="timeline">@foreach(var h in v.History){<li><b>@X(h.Kind,h.Kind switch{"Assign"=>"تسليم","Return"=>"استرداد",_=>h.Kind}) · #@h.AssetId</b><div>@h.Condition · @h.Evidence</div><div class="muted small">@T.Date(h.At) · @h.Actor</div></li>}</ul></div></div>
