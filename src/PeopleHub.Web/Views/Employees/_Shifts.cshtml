@model (List<EmployeeShiftDay> Days,int EmployeeId)
@{var shifts=(List<Shift>)ViewBag.Shifts;Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
<div class="card"><div class="card-h"><h2>@X("Dated shift calendar","جدول الورديات المؤرخ")</h2></div><div class="card-b"><p class="muted">@X("A dated assignment takes precedence over employment history and the current default. No rotation pattern is assumed. Overnight check-out at or before the shift end belongs to the previous workday. Missing check-out is shown, never invented.","وردية اليوم المحددة تسبق السجل الوظيفي والوردية الافتراضية. لا نفترض نمطا للتناوب. خروج الوردية الليلية حتى وقت نهايتها يتبع يوم العمل السابق. الخروج المفقود يظهر ولا يختلق.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Date","التاريخ")</th><th>@X("Shift","الوردية")</th><th>@T["common.reason"]</th><th>@X("Recorded by","سجل بواسطة")</th></tr></thead><tbody>@foreach(var d in Model.Days){var s=shifts.FirstOrDefault(s=>s.Id==d.ShiftId);<tr><td>@T.Date(d.Date)</td><td>@(s==null?d.ShiftId.ToString():T.Name(s.Name,s.NameAr))</td><td>@d.Reason</td><td>@d.Actor</td></tr>}</tbody></table></div>@if(Me.Can(Perm.AttManage)){<form method="post" action="/Employees/SetShift" asp-antiforgery="true" class="form-grid" style="margin-top:18px"><input type="hidden" name="employeeId" value="@Model.EmployeeId"><div class="field"><label>@X("Work date","يوم العمل")</label><input name="date" type="date" required></div><div class="field"><label>@X("Shift","الوردية")</label><select name="shiftId">@foreach(var s in shifts){<option value="@s.Id">@T.Name(s.Name,s.NameAr) · @s.Start.ToString(@"hh\:mm") / @s.End.ToString(@"hh\:mm")</option>}</select></div><div class="field full"><label>@T["common.reason"]</label><input name="reason" required></div><div class="full"><button class="btn btn-primary">@T["common.save"]</button></div></form>}</div></div>
@if(Me.Can(Perm.OrgManage)){<div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("Define shift","تعريف وردية")</h2></div><div class="card-b"><form method="post" action="/Employees/AddShift" asp-antiforgery="true" class="form-grid"><input type="hidden" name="employeeId" value="@Model.EmployeeId"><div class="field"><label>@X("English name","الاسم بالإنجليزية")</label><input name="name" required></div><div class="field"><label>@X("Arabic name","الاسم بالعربية")</label><input name="nameAr"></div><div class="field"><label>@X("Start","البداية")</label><input name="start" type="time" required></div><div class="field"><label>@X("End (next day when earlier)","النهاية (اليوم التالي إذا كانت أبكر)")</label><input name="end" type="time" required></div><div class="field"><label>@X("Grace minutes","دقائق السماح")</label><input name="grace" type="number" min="0" required></div><div class="field"><label>@X("Maximum late minutes before absence","أقصى دقائق تأخير قبل الغياب")</label><input name="maxLate" type="number" min="0" max="1440" required></div><div class="full"><button class="btn btn-primary">@T["common.add"]</button></div></form></div></div>}
