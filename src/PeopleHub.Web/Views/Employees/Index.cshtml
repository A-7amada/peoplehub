@model List<Employee>
@{ ViewData["Title"] = T["nav.employees"]; var f = (EmployeeFilter)ViewBag.Filter; var depts = (List<Department>)ViewBag.Depts; var br = (List<Branch>)ViewBag.Branches; bool hr = Me.Can(Perm.EmpManage); bool pay = Model.Count > 0 && Me.Can(Perm.EmpSalary); }
<div class="page-head"><div><h1>@T["nav.employees"]</h1><div class="sub">@Model.Count @T["emp.found"]</div></div>
<div class="actions"><a class="btn" href="/Reports/Csv?key=employees">@Ui.Icon("download", 16) CSV</a>@if (hr) { <a class="btn" href="/ImportValidation">@(T.IsAr?"فحص CSV دون استيراد":"CSV dry-run validation")</a> <a class="btn btn-primary" href="/Employees/Edit">@Ui.Icon("plus", 16) @T["emp.add"]</a> }</div></div>
<div class="card"><form class="filters" method="get">
  <div class="search">@Ui.Icon("search", 16)<input type="search" name="q" value="@f.Search" placeholder="@T["emp.search"]"></div>
  <select name="dept"><option value="">@T["emp.allDepts"]</option>@foreach (var d in depts) { <option value="@d.Id" selected="@(f.DepartmentId == d.Id)">@T.Name(d.Name, d.NameAr)</option> }</select>
  <select name="branch"><option value="">@T["emp.allBranches"]</option>@foreach (var b in br) { <option value="@b.Id" selected="@(f.BranchId == b.Id)">@T.Name(b.Name, b.NameAr)</option> }</select>
  <select name="status"><option value="">@T["emp.allStatus"]</option>@foreach (var s in Enum.GetValues<EmployeeStatus>()) { <option value="@s" selected="@(f.Status == s)">@T.E(s)</option> }</select>
  <button class="btn">@T["common.filter"]</button></form>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["emp.name"]</th><th>@T["emp.code"]</th><th>@T["emp.department"]</th><th>@T["emp.branch"]</th><th>@T["emp.hireDate"]</th>@if (pay) { <th class="right">@T["emp.basic"]</th> }<th>@T["common.status"]</th></tr></thead><tbody>
@foreach (var e in Model) { <tr>
 <td><a class="person" href="/Employees/Profile/@e.Id">@Ui.Avatar(e, T, 36)<span><div class="nm">@T.Name(e.FullName, e.FullNameAr)</div><div class="sb">@T.Name(e.JobTitle!.Name, e.JobTitle.NameAr)</div></span></a></td>
 <td class="num muted">@e.Code</td><td>@T.Name(e.Department!.Name, e.Department.NameAr)</td><td>@T.Name(e.Branch!.Name, e.Branch.NameAr)</td><td class="num muted">@T.Date(e.HireDate)</td>
 @if (pay) { <td class="right num">@T.Money(e.BasicSalary)</td> }
 <td>@Ui.Chip(T.E(e.Status), Ui.StatusTone(e.Status))</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="empty">@T["common.none"]</td></tr> }
</tbody></table></div></div>
