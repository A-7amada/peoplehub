@model (LifecycleView V,int EmployeeId)
@{var v=Model.V;var id=Model.EmployeeId;bool hr=Me.Can(Perm.EmpManage);Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
@if(v.AssignedTasks.Count>0){<div class="card" style="margin-bottom:20px"><div class="card-h"><h2>@X("Tasks assigned to me for other employees","مهام مسندة إلي لموظفين آخرين")</h2></div><div class="card-b"><p class="muted small">@X("Only task details are shared, not the other employee's private profile.","تظهر تفاصيل المهمة فقط دون الملف الخاص للموظف الآخر.")</p>@foreach(var task in v.AssignedTasks){<div style="padding:12px 0;border-bottom:1px solid var(--line2)"><b>@task.Title</b><p class="small">@X("Employee","الموظف") #@task.EmployeeId · @T.Date(task.DueOn)</p><form method="post" action="/Employees/CompleteLifecycleTask" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@task.Id"><input type="hidden" name="employeeId" value="@id"><input name="note" required placeholder="@X("Completion evidence / note","دليل الإكمال / ملاحظة")"><button class="btn">@X("Complete","إكمال")</button></form></div>}</div></div>}
<div class="grid g2">
<div class="card"><div class="card-h"><h2>@X("Onboarding, offboarding and clearance","التعيين والمغادرة وإخلاء الطرف")</h2></div><div class="card-b"><p class="muted small">@X("Tasks are explicitly assigned. Completing a checklist does not terminate employment or settle payroll.","المهام تسند صراحة. إكمال القائمة لا ينهي الخدمة ولا يسوي المرتبات.")</p>
@foreach(var x in v.Tasks){<div style="border-bottom:1px solid var(--line2);padding:12px 0"><b>@x.Title</b><p class="small">@T.Date(x.DueOn) · @X(x.Process,x.Process switch{"Onboarding"=>"تعيين","Offboarding"=>"مغادرة",_=>"إخلاء طرف"}) · @X(x.Status,x.Status=="Open"?"مفتوح":"مكتمل")</p><p class="muted small">@x.CompletionNote @x.CompletedBy</p>@if(x.Status=="Open"&&(hr||x.AssignedEmployeeId==Me.EmployeeId)){<form method="post" action="/Employees/CompleteLifecycleTask" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@x.Id"><input type="hidden" name="employeeId" value="@id"><input name="note" required placeholder="@X("Completion evidence / note","دليل الإكمال / ملاحظة")"><button class="btn">@X("Complete","إكمال")</button></form>}</div>}
@if(hr){<form method="post" action="/Employees/AddLifecycleTask" asp-antiforgery="true" style="margin-top:16px"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Process","الإجراء")</label><select name="process"><option value="Onboarding">@X("Onboarding","تعيين")</option><option value="Offboarding">@X("Offboarding","مغادرة")</option><option value="Clearance">@X("Clearance","إخلاء طرف")</option></select></div><div class="field"><label>@X("Task","المهمة")</label><input name="title" required maxlength="250"></div><div class="field"><label>@X("Assigned employee","الموظف المكلف")</label><select name="assignedEmployeeId"><option value="">-</option>@foreach(var e in (List<Employee>)ViewBag.Managers){<option value="@e.Id">@T.Name(e.FullName,e.FullNameAr)</option>}</select></div><div class="field"><label>@X("Due date","تاريخ الاستحقاق")</label><input name="dueOn" type="date" required></div><button class="btn btn-primary">@T["common.add"]</button></form>}
</div></div>
<div class="card"><div class="card-h"><h2>@X("Dependents","المعالون")</h2></div><div class="card-b"><p class="muted small">@X("Visible only to the employee and HR. No benefits eligibility is inferred.","للـموظف والموارد البشرية فقط. لا تستنتج أهلية المزايا تلقائيا.")</p>@foreach(var d in v.Dependents){<p><b>@d.Name</b> · @X(d.Relationship,d.Relationship switch{"Spouse"=>"زوج/زوجة","Child"=>"ابن/ابنة",_=>"آخر"}) · @(d.BirthDate is {} b?T.Date(b):"-")</p>@if(hr){<form method="post" action="/Employees/RemoveDependent" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@d.Id"><input type="hidden" name="employeeId" value="@id"><input name="reason" placeholder="@T["common.reason"]" required><button class="btn">@X("Remove","حذف")</button></form>}}
@if(hr){<form method="post" action="/Employees/AddDependent" asp-antiforgery="true" style="margin-top:16px"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Name","الاسم")</label><input name="name" required maxlength="150"></div><div class="field"><label>@X("Relationship","صلة القرابة")</label><select name="relationship"><option value="Spouse">@X("Spouse","زوج/زوجة")</option><option value="Child">@X("Child","ابن/ابنة")</option><option value="Other">@X("Other","آخر")</option></select></div><div class="field"><label>@X("Birth date","تاريخ الميلاد")</label><input name="birthDate" type="date"></div><button class="btn btn-primary">@T["common.add"]</button></form>}
</div></div>
<div class="card"><div class="card-h"><h2>@X("Probation and confirmation","فترة الاختبار والتثبيت")</h2></div><div class="card-b">@if(v.Probation is {} p){<p>@T.Date(p.EndsOn) · @X(p.Decision,p.Decision switch{"Confirmed"=>"تم التثبيت","NotConfirmed"=>"لم يتم التثبيت",_=>"بانتظار القرار"})</p><p>@p.Reason</p>@if(hr&&p.Decision=="Pending"){<form method="post" action="/Employees/DecideProbation" asp-antiforgery="true" class="inline-form"><input type="hidden" name="employeeId" value="@id"><select name="decision"><option value="Confirmed">@X("Confirm","تثبيت")</option><option value="NotConfirmed">@X("Do not confirm","عدم التثبيت")</option></select><input name="reason" required placeholder="@T["common.reason"]"><button class="btn">@T["common.save"]</button></form>}}@if(hr&&(v.Probation==null||v.Probation.Decision=="Pending")){<form method="post" action="/Employees/SetProbation" asp-antiforgery="true" style="margin-top:16px"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Probation end","نهاية فترة الاختبار")</label><input name="endsOn" type="date" required></div><div class="field"><label>@T["common.reason"]</label><input name="reason" required></div><button class="btn">@T["common.save"]</button></form>}<p class="muted small">@X("No default probation length. Confirmation does not change salary or employment status.","لا توجد مدة افتراضية. القرار لا يغير الراتب أو الحالة الوظيفية تلقائيا.")</p></div></div>
@if(hr){<div class="card"><div class="card-h"><h2>@X("HR custom fields","حقول الموارد البشرية المخصصة")</h2></div><div class="card-b"><p class="muted small">@X("HR-only metadata. Do not store passwords, bank credentials or medical details here.","بيانات للموارد البشرية فقط. لا تخزن كلمات مرور أو بيانات دخول بنكية أو معلومات طبية هنا.")</p>@foreach(var f in v.Fields.Where(f=>f.Active)){<form method="post" action="/Employees/SetField" asp-antiforgery="true" class="inline-form" style="margin-bottom:12px"><input type="hidden" name="employeeId" value="@id"><input type="hidden" name="fieldId" value="@f.Id"><label>@T.Name(f.Label,f.LabelAr)</label><input name="value" value="@v.Values.FirstOrDefault(x=>x.FieldId==f.Id)?.Value" type="@(f.Kind=="Date"?"date":f.Kind=="Number"?"number":"text")" step="any" maxlength="1000"><button class="btn">@T["common.save"]</button></form>}<hr><form method="post" action="/Employees/AddField" asp-antiforgery="true"><input type="hidden" name="employeeId" value="@id"><div class="field"><label>@X("Field label (English)","اسم الحقل بالإنجليزية")</label><input name="label" maxlength="100" required></div><div class="field"><label>@X("Arabic label","الاسم بالعربية")</label><input name="labelAr"></div><div class="field"><label>@X("Type","النوع")</label><select name="kind"><option value="Text">@X("Text","نص")</option><option value="Date">@X("Date","تاريخ")</option><option value="Number">@X("Number","رقم")</option></select></div><button class="btn btn-primary">@X("Add field definition","إضافة حقل")</button></form></div></div>}
</div>
