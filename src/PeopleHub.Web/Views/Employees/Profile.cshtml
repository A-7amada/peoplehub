@model EmployeeProfile
@{
  var e = Model.Employee; ViewData["Title"] = T.Name(e.FullName, e.FullNameAr); string tab = ViewBag.Tab;
  bool hr = Me.Can(Perm.EmpManage);
  bool self = User.FindFirst("emp")?.Value == e.Id.ToString();
  var comps = (List<SalaryComponent>)ViewBag.Components; var bal = (List<LeaveBalance>)ViewBag.Balances; DateTime today = ViewBag.Today;
  string Tab(string k) => tab == k ? "on" : "";
}
<div class="card" style="margin-bottom:20px"><div class="profile-hero">@Ui.Avatar(e, T, 72)
  <div><h1>@T.Name(e.FullName, e.FullNameAr)</h1><div class="muted">@T.Name(e.JobTitle!.Name, e.JobTitle.NameAr) · @T.Name(e.Department!.Name, e.Department.NameAr) · @T.Name(e.Branch!.Name, e.Branch.NameAr)</div>
   <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">@Ui.Chip(T.E(e.Status), Ui.StatusTone(e.Status))<span class="chip chip-gray">@e.Code</span><span class="chip chip-violet">@T.E(e.EmploymentType)</span></div></div>
  <div style="margin-inline-start:auto;display:flex;gap:10px">@if (hr) { <a class="btn" href="/Employees/Edit/@e.Id">@T["emp.edit"]</a> }<a class="btn" href="/Attendance?id=@e.Id">@Ui.Icon("clock", 16) @T["nav.attendance"]</a></div></div></div>
<div class="tabs">@if(hr||self){<a class="@Tab("assets")" href="?tab=assets">@(T.IsAr?"العهد والأصول":"Assets")</a>}<a class="@Tab("shifts")" href="?tab=shifts">@(T.IsAr?"جدول الورديات":"Shift calendar")</a>@if(hr||self){<a class="@Tab("documents")" href="?tab=documents">@(T.IsAr?"المستندات":"Documents")</a>}<a class="@Tab("lifecycle")" href="?tab=lifecycle">@(T.IsAr?"دورة الموظف":"Lifecycle")</a><a class="@Tab("overview")" href="?tab=overview">@T["emp.tab.overview"]</a><a class="@Tab("contracts")" href="?tab=contracts">@T["emp.tab.contracts"]</a><a class="@Tab("history")" href="?tab=history">@T["emp.tab.history"]</a><a class="@Tab("leave")" href="?tab=leave">@T["nav.leave"]</a>@if (Model.CanSeeSalary||Model.CanSeeBank) { <a class="@Tab("pay")" href="?tab=pay">@T["emp.tab.pay"]</a> }</div>

@if (tab == "overview") {
<div class="grid g2">
 <div class="card"><div class="card-h"><h2>@T["emp.personal"]</h2></div><div class="card-b"><dl class="dl">
  <dt>@T["emp.email"]</dt><dd dir="ltr" style="text-align:start">@e.Email</dd><dt>@T["emp.phone"]</dt><dd dir="ltr" style="text-align:start">@e.Phone</dd>
  <dt>@T["emp.nationalId"]</dt><dd class="num">@(Model.CanSeeIdentity ? e.NationalId : "-")</dd><dt>@T["emp.birthDate"]</dt><dd>@(e.BirthDate == null ? "-" : T.Date(e.BirthDate.Value))</dd>
  <dt>@T["emp.gender"]</dt><dd>@T.E(e.Gender)</dd><dt>@T["emp.marital"]</dt><dd>@(Model.CanSeeIdentity?T.E(e.MaritalStatus):"-")</dd><dt>@T["emp.address"]</dt><dd>@(Model.CanSeeIdentity?e.Address:"-")</dd></dl>
  @if (self) { <hr style="border:0;border-top:1px solid var(--line2);margin:18px 0"><form method="post" action="/Employees/MyContact" asp-antiforgery="true" class="inline-form"><input type="text" name="phone" value="@e.Phone" dir="ltr"><input type="text" name="address" value="@e.Address" placeholder="@T["emp.address"]"><button class="btn btn-sm">@T["common.save"]</button></form> }</div></div>
 <div class="card"><div class="card-h"><h2>@T["emp.work"]</h2></div><div class="card-b"><dl class="dl">
  <dt>@T["emp.manager"]</dt><dd>@(Model.ManagerName == null ? "-" : T.Name(Model.ManagerName, Model.ManagerNameAr ?? ""))</dd><dt>@T["emp.hireDate"]</dt><dd>@T.Date(e.HireDate)</dd>
  <dt>@T["emp.shift"]</dt><dd>@(Model.Shift == null ? "-" : T.Name(Model.Shift.Name, Model.Shift.NameAr))</dd><dt>@T["emp.insurance"]</dt><dd class="num">@(Model.CanSeeIdentity ? e.InsuranceNumber : "-")</dd></dl></div></div>
</div>
}
@if (tab == "contracts") {
<div class="card"><div class="card-h"><h2>@T["emp.tab.contracts"]</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["common.type"]</th><th>@T["common.from"]</th><th>@T["common.to"]</th><th>@T["common.status"]</th><th></th></tr></thead><tbody>
@foreach (var c in Model.Contracts) { <tr><td>@T.E(c.Type)</td><td class="num">@T.Date(c.StartDate)</td><td class="num">@(c.EndDate == null ? "-" : T.Date(c.EndDate.Value))</td><td>@Ui.Chip(c.IsCurrent ? T["common.current"] : T["common.past"], c.IsCurrent ? "green" : "gray")</td>
 <td class="right">@if (hr && c.IsCurrent && c.EndDate != null) { <form method="post" action="/Employees/RenewContract" asp-antiforgery="true" class="inline-form" style="justify-content:flex-end"><input type="hidden" name="id" value="@e.Id"><input type="hidden" name="contractId" value="@c.Id"><input type="date" name="newEnd" value="@c.EndDate.Value.AddYears(1).ToString("yyyy-MM-dd")"><button class="btn btn-sm">@T["emp.renew"]</button></form> }</td></tr> }
</tbody></table></div></div>
@if (hr) { <div class="card" style="margin-top:18px"><div class="card-h"><h2>@T["emp.newContract"]</h2></div><div class="card-b"><form method="post" action="/Employees/AddContract" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@e.Id">
 <div class="field"><label>@T["common.type"]</label><select name="type">@foreach (var t in Enum.GetValues<ContractType>()) { <option value="@((int)t)">@T.E(t)</option> }</select></div>
 <div class="field"><label>@T["common.from"]</label><input type="date" name="start" value="@today.ToString("yyyy-MM-dd")"></div><div class="field"><label>@T["common.to"]</label><input type="date" name="end"></div><div class="field"><label>@T["common.notes"]</label><input type="text" name="notes"></div>
 <div class="full"><button class="btn btn-primary">@T["common.save"]</button></div></form></div></div> }
}
@if (tab == "history") {
<div class="grid g2">
 <div class="card"><div class="card-h"><h2>@T["emp.career"]</h2></div><div class="card-b"><ul class="timeline">@foreach (var ev in Model.Events) { <li><b>@T.E(ev.Type)</b> <span class="faint small">· @T.Date(ev.Date)</span><div class="muted">@ev.Details</div></li> }</ul>
  @if (hr) { <form method="post" action="/Employees/AddEvent" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@e.Id"><select name="type">@foreach (var t in Enum.GetValues<CareerEventType>()) { <option value="@((int)t)">@T.E(t)</option> }</select><input type="text" name="details" placeholder="@T["common.notes"]" style="flex:1"><button class="btn btn-sm">@T["common.add"]</button></form> }</div></div>
 <div class="card"><div class="card-h"><h2>@T["emp.statusHistory"]</h2></div><div class="card-b"><ul class="timeline">@foreach (var h in Model.StatusHistory) { <li>@Ui.Chip(T.E(h.From), "gray") → @Ui.Chip(T.E(h.To), Ui.StatusTone(h.To)) <span class="faint small">· @T.Date(h.At)</span><div class="muted small">@h.ChangedBy @(string.IsNullOrEmpty(h.Reason) ? "" : "· " + h.Reason)</div></li> }
  @if (Model.StatusHistory.Count == 0) { <li class="faint">@T["common.none"]</li> }</ul>
  @if (hr && e.IsWorking) { <form method="post" action="/Employees/Status" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@e.Id"><select name="to">@foreach (var s in Enum.GetValues<EmployeeStatus>().Where(s => s != e.Status)) { <option value="@((int)s)">@T.E(s)</option> }</select><input type="text" name="reason" placeholder="@T["common.reason"]" style="flex:1"><button class="btn btn-sm">@T["emp.changeStatus"]</button></form> }</div></div>
</div>
}
@if (tab == "leave") {
@if(!self&&!Me.Can(Perm.LeaveEvidence)){<div class="alert info">@(T.IsAr?"أرصدة الإجازات وسجلها متاحان لصاحب البيانات أو لصلاحية الاطلاع على أدلة الإجازات فقط.":"Leave balances and ledger are limited to the employee or the leave-evidence permission.")</div>}
<div class="card"><div class="card-h"><h2>@T["leave.balances"] @ViewBag.Year</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["common.type"]</th><th>@T["leave.entitled"]</th><th>@T["leave.carried"]</th><th>@T["leave.used"]</th><th>@T["leave.remaining"]</th>@if (hr) { <th></th> }</tr></thead><tbody>
@foreach (var b in bal) { <tr><td>@(self||Me.Can(Perm.LeaveEvidence)?T.Name(b.LeaveType!.Name,b.LeaveType.NameAr):(T.IsAr?"إجازة خاصة":"Private leave"))</td><td class="num">@b.Entitled</td><td class="num">@b.CarriedOver</td><td class="num">@b.Used</td><td class="num"><b>@b.Remaining</b></td>
 @if (hr) { <td class="right"><form method="post" action="/Employees/AdjustBalance" asp-antiforgery="true" class="inline-form" style="justify-content:flex-end"><input type="hidden" name="id" value="@e.Id"><input type="hidden" name="typeId" value="@b.LeaveTypeId"><input type="number" name="entitled" value="@b.Entitled" style="width:70px"><input type="text" name="reason" placeholder="@T["common.reason"]" style="width:130px"><button class="btn btn-sm">@T["common.save"]</button></form></td> }</tr> }
</tbody></table></div></div>
}
@if (tab == "pay" && (Model.CanSeeSalary||Model.CanSeeBank)) {
<div class="grid g2">
 <div class="card"><div class="card-h"><h2>@T["emp.salary"]</h2></div><div class="card-b">@if(Model.CanSeeSalary){<div class="kv"><span>@T["emp.basic"]</span><b class="num">@T.Money(e.BasicSalary)</b></div>
  @foreach (var c in Model.Components) { <div class="kv"><span>@T.Name(c.Component!.Name, c.Component.NameAr) @Ui.Chip(T.E(c.Component.Type), c.Component.Type == ComponentType.Earning ? "green" : "red")</span><b class="num">@T.Money(c.Amount)</b></div> }
  }
  @if(Model.CanSeeBank){<div class="kv"><span>@T["emp.bankName"]</span><span>@e.BankName</span></div><div class="kv"><span>IBAN</span><span class="num" dir="ltr">@e.Iban</span></div>}</div></div>
 @if (Me.Can(Perm.EmpPay)) { <div class="card"><div class="card-h"><h2>@T["emp.setComponent"]</h2></div><div class="card-b"><form method="post" action="/Employees/SetComponent" asp-antiforgery="true"><input type="hidden" name="id" value="@e.Id">
  <div class="field"><label>@T["common.type"]</label><select name="componentId">@foreach (var c in comps) { <option value="@c.Id">@T.Name(c.Name, c.NameAr) (@T.E(c.Type))</option> }</select></div>
  <div class="field"><label>@T["common.amount"]</label><input type="number" step="0.01" min="0" name="amount"></div><button class="btn btn-primary">@T["common.save"]</button></form></div></div> }
</div>
}

@if(tab=="history") {
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"سجل التكليفات الوظيفية":"Historical assignments")</h2></div><div class="card-b"><p class="muted small">@(T.IsAr?"السجلات القديمة غير المتاحة لا يعاد إنشاؤها. التغييرات الحالية تسري من تاريخ تسجيلها؛ من شامل وإلى غير شامل، وقد تحدث عدة تغييرات في نفس اليوم.":"Unavailable old history is not reconstructed. Current changes take effect when recorded. From is inclusive, to is exclusive; multiple same-day changes are retained.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["common.from"]</th><th>@T["common.to"]</th><th>@T["emp.department"]</th><th>@T["emp.title"]</th><th>@T["emp.manager"]</th>@if(Model.CanSeeSalary){<th>@T["emp.basic"]</th>}<th>@T["common.reason"]</th></tr></thead><tbody>@foreach(var a in (List<EmployeeAssignment>)ViewBag.Assignments){<tr><td class="nowrap">@T.Date(a.EffectiveFrom)</td><td class="nowrap">@(a.EffectiveTo is {} end?T.Date(end):"-")</td><td>#@a.DepartmentId</td><td>#@a.JobTitleId</td><td>@a.ManagerId</td>@if(Model.CanSeeSalary){<td>@T.Money(a.BasicSalary)</td>}<td>@a.Reason</td></tr>}</tbody></table></div></div></div>
}
@if(tab=="leave") {<partial name="_LeaveLedger" model="(List<LeaveTransaction>)ViewBag.Ledger" />}
@if(tab=="history"){
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"تغييرات مستقبلية مؤرخة":"Future employment changes")</h2></div><div class="card-b"><p class="muted">@(T.IsAr?"التاريخ شامل. لا نعيد كتابة الماضي. تنفذ التغييرات المستحقة عند فتح الملف أو خلال فحص الخدمة كل 15 دقيقة. الجدولة ليست احتسابا تلقائيا لفروق المرتبات.":"Effective date is inclusive. Past evidence is not rewritten. Due changes apply when this profile opens or at the 15-minute maintenance check. Scheduling does not calculate retroactive pay.")</p>
@foreach(var x in (List<EmploymentChange>)ViewBag.Scheduled){<div class="kv"><span>@T.Date(x.EffectiveOn) · @(x.Kind=="Status"?(T.IsAr?"حالة الموظف":"Status"):(T.IsAr?"تكليف وظيفي":"Assignment")) · @x.Reason</span><b>@(x.Cancelled?(T.IsAr?"ملغي":"Cancelled"):x.AppliedAt!=null?(T.IsAr?"تم التنفيذ":"Applied"):(T.IsAr?"مجدول":"Scheduled"))</b></div>@if(hr && !x.Cancelled && x.AppliedAt==null && x.EffectiveOn>today){<form method="post" action="/Employees/CancelSchedule" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@x.Id"><input type="hidden" name="employeeId" value="@e.Id"><input name="reason" placeholder="@T["common.reason"]" required><button class="btn">@(T.IsAr?"إلغاء":"Cancel")</button></form>}}
@if(hr){<form method="post" action="/Employees/Schedule" asp-antiforgery="true" class="form-grid" style="margin-top:18px"><input type="hidden" name="EmployeeId" value="@e.Id"><div class="field"><label>@(T.IsAr?"نوع التغيير":"Change type")</label><select name="Kind"><option value="Assignment">@(T.IsAr?"تكليف وظيفي":"Assignment")</option><option value="Status">@(T.IsAr?"حالة الموظف":"Status")</option></select></div><div class="field"><label>@(T.IsAr?"يسري من":"Effective from")</label><input type="date" name="EffectiveOn" min="@today.AddDays(1).ToString("yyyy-MM-dd")" required></div><div class="field"><label>@T["emp.department"]</label><select name="DepartmentId">@foreach(var d in (List<Department>)ViewBag.Depts){<option value="@d.Id" selected="@(d.Id==e.DepartmentId)">@T.Name(d.Name,d.NameAr)</option>}</select></div><div class="field"><label>@T["emp.branch"]</label><select name="BranchId">@foreach(var d in (List<Branch>)ViewBag.Branches){<option value="@d.Id" selected="@(d.Id==e.BranchId)">@T.Name(d.Name,d.NameAr)</option>}</select></div><div class="field"><label>@T["emp.title"]</label><select name="JobTitleId">@foreach(var d in (List<JobTitle>)ViewBag.Titles){<option value="@d.Id" selected="@(d.Id==e.JobTitleId)">@T.Name(d.Name,d.NameAr)</option>}</select></div><div class="field"><label>@T["emp.manager"]</label><select name="ManagerId"><option value="">-</option>@foreach(var d in (List<Employee>)ViewBag.Managers){<option value="@d.Id" selected="@(d.Id==e.ManagerId)">@T.Name(d.FullName,d.FullNameAr)</option>}</select></div><div class="field"><label>@T["emp.shift"]</label><select name="ShiftId"><option value="">-</option>@foreach(var d in (List<Shift>)ViewBag.Shifts){<option value="@d.Id" selected="@(d.Id==e.ShiftId)">@T.Name(d.Name,d.NameAr)</option>}</select></div>@if(Me.Can(Perm.EmpPay)){<div class="field"><label>@T["emp.basic"]</label><input name="BasicSalary" type="number" min="0" step="0.01" value="@e.BasicSalary"></div>}<div class="field"><label>@(T.IsAr?"الحالة (لتغيير الحالة فقط)":"Status (status change only)")</label><select name="Status">@foreach(var st in Enum.GetValues<EmployeeStatus>()){<option value="@((int)st)">@T.E(st)</option>}</select></div><div class="field full"><label>@T["common.reason"]</label><input name="Reason" required></div><div class="full"><button class="btn btn-primary">@(T.IsAr?"جدولة التغيير":"Schedule change")</button></div></form>}
</div></div>}

@if(tab=="lifecycle"){<partial name="_Lifecycle" model="((LifecycleView)ViewBag.Lifecycle,e.Id)" />}

@if(tab=="documents"){<partial name="_Documents" model="((List<EmployeeDocument>)ViewBag.Documents,e.Id)" />}

@if(tab=="shifts"){<partial name="_Shifts" model="((List<EmployeeShiftDay>)ViewBag.ShiftDays,e.Id)" />}

@if(tab=="assets"){<partial name="_Assets" model="((AssetView)ViewBag.Assets,e.Id)" />}
