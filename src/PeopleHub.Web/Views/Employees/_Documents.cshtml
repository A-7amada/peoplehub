@model (List<EmployeeDocument> Docs,int EmployeeId)
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
<div class="card"><div class="card-h"><h2>@X("Employee documents","مستندات الموظف")</h2></div><div class="card-b"><p class="muted">@X("Private to the employee and HR. File type and signature are checked. Malware scanning is not connected. Use fictional demo files only. Expiry alerts run daily once within the 30-day warning window and after expiry while the service is awake.","للموظف والموارد البشرية فقط. يتم التحقق من نوع الملف وتوقيعه. فحص البرمجيات الضارة غير متصل. استخدم ملفات وهمية فقط. تنبيهات الانتهاء مرة يوميا خلال 30 يوما قبل الانتهاء وبعده حين تكون الخدمة نشطة.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Document","المستند")</th><th>@X("Expires","الانتهاء")</th><th>@X("Uploaded by","رفع بواسطة")</th><th></th></tr></thead><tbody>@foreach(var d in Model.Docs){<tr><td>@d.Title</td><td>@(d.ExpiresOn is {} end?T.Date(end):"-")</td><td>@d.UploadedBy</td><td><a class="btn btn-sm" href="/Files/Get/@d.AttachmentToken">@X("Download","تنزيل")</a></td></tr>}</tbody></table></div>
@if(Me.Can(Perm.EmpManage)){<form method="post" action="/Employees/AddDocument" enctype="multipart/form-data" asp-antiforgery="true" class="form-grid" style="margin-top:18px"><input type="hidden" name="employeeId" value="@Model.EmployeeId"><div class="field"><label>@X("Title","العنوان")</label><input name="title" required maxlength="150"></div><div class="field"><label>@X("Expiry date (optional)","تاريخ الانتهاء (اختياري)")</label><input name="expiresOn" type="date"></div><div class="field full"><label>@X("PDF, PNG or JPEG, up to 2 MB","PDF أو PNG أو JPEG حتى 2 ميجابايت")</label><input style="width:100%;min-width:0;max-width:100%" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg" required></div><div class="full"><button class="btn btn-primary">@X("Upload document","رفع مستند")</button></div></form>}</div></div>
