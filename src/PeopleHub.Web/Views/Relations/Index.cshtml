@using PeopleHub.Application.Modules.Relations
@model EmployeeCaseView
@{
 ViewData["Title"]=T.IsAr?"علاقات الموظفين السرية":"Confidential employee relations";
 Func<string,string,string>X=(e,a)=>T.IsAr?a:e;
 string K(string kind)=>kind switch{"Grievance"=>X("Grievance","تظلم"),"Warning"=>X("Warning record","سجل إنذار"),"Investigation"=>X("Investigation evidence","دليل التحقيق"),"ProposedDiscipline"=>X("Proposed action","إجراء مقترح"),"ApprovedDiscipline"=>X("Approved internally","معتمد داخلياً"),"RejectedDiscipline"=>X("Rejected internally","مرفوض داخلياً"),"Closed"=>X("Closed","مغلق"),_=>kind};
 bool manage=Me.Can(Perm.RelationsManage);
 var employees=(List<Employee>)ViewBag.Employees;
 var investigators=(List<CaseInvestigator>)ViewBag.Investigators;
}
<div class="page-head"><h1>@ViewData["Title"]</h1></div>
<div class="card"><div class="card-b">
 <p>@X("Restricted case register. The separate relations-management grant allows access to every case and controls explicit per-case investigator access. An assigned investigator can read only assigned cases and append investigation notes, not propose or decide discipline, close cases or grant access. General HR, manager, company-scope and audit access do not grant case access.","سجل قضايا مقيد. تتيح صلاحية إدارة العلاقات الاطلاع على جميع القضايا وتحديد وصول المحقق لكل قضية. يقرأ المحقق القضايا المسندة إليه فقط ويضيف ملاحظات التحقيق، ولا يقترح أو يعتمد جزاءً أو يغلق قضية أو يمنح صلاحيات. صلاحيات الموارد البشرية العامة والمدير ونطاق الشركة والتدقيق لا تمنح الاطلاع على القضايا.")</p>
 <p class="muted small">@X("Internal records only, not served warnings or legal findings. Approval excludes the creator, proposer and affected employee. No notice, employee status change, payroll deduction or sanction is executed. No access assignments are created automatically. Case files are private PDF/JPEG/PNG up to 2 MB, signature-checked only, not malware-scanned or authenticated. Employee intake and employee-visible responses are separate under Grievance intake; appeals and legal review remain open.","سجلات داخلية فقط، وليست إنذارات مُبلّغة أو نتائج قانونية. الاعتماد يستبعد المنشئ ومقترح الإجراء والموظف المعني. لا يُرسل إشعار ولا تتغير حالة الموظف ولا يُخصم راتب ولا يُنفذ جزاء. لا تُنشأ صلاحيات وصول تلقائياً. ملفات القضية خاصة بصيغة PDF/JPEG/PNG حتى ٢ ميجابايت، ويُفحص توقيع النوع فقط دون فحص برمجيات ضارة أو إثبات أصالة. طلبات الموظفين والردود الظاهرة لهم منفصلة في طلبات التظلم الداخلية؛ التظلم من القرارات والمراجعة القانونية يظلان مفتوحين.")</p>
</div></div>
@foreach(var c in Model.Cases)
{
 var events=Model.Events.Where(x=>x.CaseId==c.Id).ToList();bool closed=events.Any(x=>x.Kind=="Closed");
 var proposal=events.LastOrDefault(x=>x.Kind=="ProposedDiscipline");var decision=events.LastOrDefault(x=>x.Kind is "ApprovedDiscipline" or "RejectedDiscipline");bool pending=proposal!=null&&(decision==null||decision.Id<proposal.Id);
 <div class="card" style="margin-top:20px"><div class="card-h"><h2>#@c.Id · @c.Title</h2><span class="chip">@(closed?K("Closed"):K(c.Kind))</span></div><div class="card-b">
 <p>@X("Affected employee","الموظف المعني") #@c.EmployeeId · @K(c.Kind)</p><p style="white-space:pre-wrap">@c.Statement</p><p class="small faint">@c.Actor · @T.Date(c.At)</p>
 <h3>@X("Append-only case evidence","أدلة القضية غير القابلة للتعديل")</h3>
 @foreach(var ev in events){<div style="border-inline-start:3px solid var(--brand);padding:10px 16px;margin:10px 0"><b>@K(ev.Kind)</b><p style="white-space:pre-wrap">@ev.Note</p><small class="faint">@ev.Actor · @T.Date(ev.At)</small></div>}
 <h3>@X("Private evidence files","ملفات الأدلة الخاصة")</h3>
 @foreach(var f in (Model.Files??[]).Where(x=>x.CaseId==c.Id)){
 <div style="border-inline-start:3px solid var(--brand);padding:10px 16px;margin:10px 0"><a href="/Relations/File/@f.Token">@f.FileName</a><p style="white-space:pre-wrap">@f.SourceReference</p><small class="faint">@f.Actor · @T.Date(f.At)</small><details><summary>SHA-256</summary><code dir="ltr" style="overflow-wrap:anywhere">@f.Sha256</code></details></div>}
 @if(!closed){<form method="post" action="/Relations/Evidence" enctype="multipart/form-data" asp-antiforgery="true" class="form-grid" style="margin-bottom:24px"><input type="hidden" name="caseId" value="@c.Id"><div class="field"><label>@X("Evidence file, PDF/JPEG/PNG, 2 MB maximum","ملف الدليل PDF/JPEG/PNG، بحد أقصى ٢ ميجابايت")</label><input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required></div><div class="field"><label>@X("Source reference and context","مرجع المصدر والسياق")</label><textarea name="sourceReference" maxlength="2000" required></textarea></div><div class="full"><button class="btn">@X("Retain private evidence file","حفظ ملف الدليل الخاص")</button></div></form>}
 @if(!closed){<form method="post" action="/Relations/Record" asp-antiforgery="true" class="form-grid"><input type="hidden" name="caseId" value="@c.Id"><div class="field full"><label>@X("Evidence, source reference and reason","الدليل ومرجع المصدر والسبب")</label><textarea name="note" maxlength="8000" required></textarea></div><div class="full actions"><button class="btn" name="kind" value="Investigation">@X("Add investigation evidence","إضافة دليل تحقيق")</button>
 @if(manage){if(!pending&&!events.Any(x=>x.Kind=="ApprovedDiscipline")){<button class="btn" name="kind" value="ProposedDiscipline">@X("Propose internal action","اقتراح إجراء داخلي")</button>}if(pending&&proposal!.ActorUserId!=Me.UserId&&c.CreatedByUserId!=Me.UserId&&c.EmployeeId!=Me.EmployeeId){<button class="btn btn-primary" name="kind" value="ApprovedDiscipline">@X("Approve internally","اعتماد داخلي")</button><button class="btn" name="kind" value="RejectedDiscipline">@X("Reject internally","رفض داخلي")</button>}if(!pending){<button class="btn" name="kind" value="Closed">@X("Close case record","إغلاق سجل القضية")</button>}}
 </div></form>}
 @if(manage){
 <details style="margin-top:24px"><summary>@X("Per-case investigator access","وصول المحقق لهذه القضية")</summary>
 <p class="muted small">@X("Changes require a recent password check. Access is limited to an active account and working employee where linked. The affected employee cannot be assigned. Revocation stops future access, not information already read.","تتطلب التغييرات تحققاً حديثاً بكلمة المرور. الوصول لحساب نشط وموظف على رأس العمل عند الربط. لا يمكن إسناد القضية للموظف المعني. يمنع الإلغاء الوصول اللاحق ولا يسترد ما سبق الاطلاع عليه.")</p>
 <form method="post" action="/Relations/Access" asp-antiforgery="true" class="form-grid"><input type="hidden" name="caseId" value="@c.Id"><input type="hidden" name="granted" value="true"><div class="field"><label>@X("Investigator account","حساب المحقق")</label><select name="userId">@foreach(var u in investigators){<option value="@u.UserId">@u.Email</option>}</select></div><div class="field"><label>@X("Access reason","سبب الوصول")</label><input name="reason" maxlength="2000" required></div><div class="full"><button class="btn">@X("Grant case access","منح الوصول للقضية")</button></div></form>
 @foreach(var g in (Model.Access??[]).Where(x=>x.CaseId==c.Id).GroupBy(x=>x.UserId).Select(g=>g.OrderByDescending(x=>x.Id).First()).Where(x=>x.Granted)){
 <form method="post" action="/Relations/Access" asp-antiforgery="true" class="form-grid" style="margin-top:16px"><input type="hidden" name="caseId" value="@c.Id"><input type="hidden" name="userId" value="@g.UserId"><input type="hidden" name="granted" value="false"><div class="field"><label>@X("Assigned account","الحساب المسند")</label><input value="@(investigators.FirstOrDefault(u=>u.UserId==g.UserId)?.Email??("#"+g.UserId))" readonly></div><div class="field"><label>@X("Revocation reason","سبب الإلغاء")</label><input name="reason" maxlength="2000" required></div><div><button class="btn">@X("Revoke case access","إلغاء الوصول للقضية")</button></div></form>}
 <h4>@X("Access change history","سجل تغييرات الوصول")</h4>
 @foreach(var g in (Model.Access??[]).Where(x=>x.CaseId==c.Id)){<p class="small">#@g.UserId · @(g.Granted?X("Granted","تم المنح"):X("Revoked","تم الإلغاء")) · @g.Actor · @T.Date(g.At)<br>@g.Reason</p>}
 </details>}
 </div></div>
}
@if(manage){<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Record a case","تسجيل قضية")</h2></div><div class="card-b"><form method="post" action="/Relations/Create" asp-antiforgery="true" class="form-grid"><div class="field"><label>@X("Affected employee","الموظف المعني")</label><select name="employeeId">@foreach(var e in employees){<option value="@e.Id">#@e.Id @T.Name(e.FullName,e.FullNameAr)</option>}</select></div><div class="field"><label>@X("Case type","نوع القضية")</label><select name="kind"><option value="Grievance">@K("Grievance")</option><option value="Warning">@K("Warning")</option><option value="Investigation">@K("Investigation")</option></select></div><div class="field full"><label>@X("Title","العنوان")</label><input name="title" maxlength="200" required></div><div class="field full"><label>@X("Statement, source reference and reason","البيان ومرجع المصدر والسبب")</label><textarea name="statement" maxlength="8000" required></textarea></div><div><button class="btn btn-primary">@X("Save confidential case","حفظ القضية السرية")</button></div></form></div></div>}
