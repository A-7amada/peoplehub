@model EmployeeCaseView
@{ViewData["Title"]=T.IsAr?"علاقات الموظفين السرية":"Confidential employee relations";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;string K(string kind)=>kind switch{"Grievance"=>X("Grievance","تظلم"),"Warning"=>X("Warning record","سجل إنذار"),"Investigation"=>X("Investigation evidence","دليل التحقيق"),"ProposedDiscipline"=>X("Proposed action","إجراء مقترح"),"ApprovedDiscipline"=>X("Approved internally","معتمد داخلياً"),"RejectedDiscipline"=>X("Rejected internally","مرفوض داخلياً"),"Closed"=>X("Closed","مغلق"),_=>kind};var employees=(List<Employee>)ViewBag.Employees;}
<div class="page-head"><h1>@ViewData["Title"]</h1></div>
<div class="card"><div class="card-b"><p>@X("Restricted case register. The separate relations-management grant allows access to every case here and is initially unassigned outside SystemAdmin. General HR, manager, company-scope and audit access do not grant case access.","سجل قضايا مقيد. تسمح صلاحية إدارة علاقات الموظفين المنفصلة بالاطلاع على جميع القضايا هنا، ولا تُمنح مبدئياً إلا لمدير النظام. صلاحيات الموارد البشرية العامة والمدير ونطاق الشركة والتدقيق لا تمنح الاطلاع على القضايا.")</p><p class="muted small">@X("Internal records only, not served warnings or legal findings. Approval must be recorded by someone other than the case creator, action proposer and affected employee. No notice is sent, employee status changed, payroll deduction made or disciplinary action executed. The organization must choose its lawful process and access grants. Per-case investigator access, evidence files, employee submissions/appeals and legal review remain separate.","سجلات داخلية فقط، وليست إنذارات تم تبليغها أو نتائج قانونية. يسجل الاعتماد شخص غير منشئ القضية ومقترح الإجراء والموظف المعني. لا يرسل إشعاراً ولا يغير حالة الموظف ولا يخصم راتباً ولا ينفذ جزاءً. تحدد المؤسسة الإجراء القانوني وصلاحيات الوصول. صلاحية المحقق لكل قضية وملفات الأدلة وطلبات الموظفين والتظلمات والمراجعة القانونية تظل منفصلة.")</p></div></div>
@foreach(var c in Model.Cases){var events=Model.Events.Where(x=>x.CaseId==c.Id).ToList();bool closed=events.Any(x=>x.Kind=="Closed");var proposal=events.LastOrDefault(x=>x.Kind=="ProposedDiscipline");var decision=events.LastOrDefault(x=>x.Kind is "ApprovedDiscipline" or "RejectedDiscipline");bool pending=proposal!=null&&(decision==null||decision.Id<proposal.Id);<div class="card" style="margin-top:20px"><div class="card-h"><h2>#@c.Id · @c.Title</h2><span class="chip">@(closed?K("Closed"):K(c.Kind))</span></div><div class="card-b"><p>@X("Affected employee","الموظف المعني") #@c.EmployeeId · @K(c.Kind)</p><p style="white-space:pre-wrap">@c.Statement</p><p class="small faint">@c.Actor · @T.Date(c.At)</p><h3>@X("Append-only case evidence","أدلة القضية غير القابلة للتعديل")</h3>@foreach(var ev in events){<div style="border-inline-start:3px solid var(--brand);padding:10px 16px;margin:10px 0"><b>@K(ev.Kind)</b><p style="white-space:pre-wrap">@ev.Note</p><small class="faint">@ev.Actor · @T.Date(ev.At)</small></div>}@if(!closed){<form method="post" action="/Relations/Record" asp-antiforgery="true" class="form-grid"><input type="hidden" name="caseId" value="@c.Id"><div class="field full"><label>@X("Evidence, source reference and reason","الدليل ومرجع المصدر والسبب")</label><textarea name="note" maxlength="8000" required></textarea></div><div class="full actions"><button class="btn" name="kind" value="Investigation">@X("Add investigation evidence","إضافة دليل تحقيق")</button>@if(!pending&&!events.Any(x=>x.Kind=="ApprovedDiscipline")){<button class="btn" name="kind" value="ProposedDiscipline">@X("Propose internal action","اقتراح إجراء داخلي")</button>}@if(pending&&proposal!.ActorUserId!=Me.UserId&&c.CreatedByUserId!=Me.UserId&&c.EmployeeId!=Me.EmployeeId){<button class="btn btn-primary" name="kind" value="ApprovedDiscipline">@X("Approve internally","اعتماد داخلي")</button><button class="btn" name="kind" value="RejectedDiscipline">@X("Reject internally","رفض داخلي")</button>}@if(!pending){<button class="btn" name="kind" value="Closed">@X("Close case record","إغلاق سجل القضية")</button>}</div></form>}</div></div>}
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Record a case","تسجيل قضية")</h2></div><div class="card-b"><form method="post" action="/Relations/Create" asp-antiforgery="true" class="form-grid"><div class="field"><label>@X("Affected employee","الموظف المعني")</label><select name="employeeId">@foreach(var e in employees){<option value="@e.Id">#@e.Id @T.Name(e.FullName,e.FullNameAr)</option>}</select></div><div class="field"><label>@X("Case type","نوع القضية")</label><select name="kind"><option value="Grievance">@K("Grievance")</option><option value="Warning">@K("Warning")</option><option value="Investigation">@K("Investigation")</option></select></div><div class="field full"><label>@X("Title","العنوان")</label><input name="title" maxlength="200" required></div><div class="field full"><label>@X("Statement, source reference and reason","البيان ومرجع المصدر والسبب")</label><textarea name="statement" maxlength="8000" required></textarea></div><div><button class="btn btn-primary">@X("Save confidential case","حفظ القضية السرية")</button></div></form></div></div>
