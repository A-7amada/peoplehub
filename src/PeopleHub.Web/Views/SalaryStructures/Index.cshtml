@model List<SalaryStructure>
@{ViewData["Title"]=T.IsAr?"هياكل الرواتب":"Salary structures";var components=(List<SalaryComponent>)ViewBag.Components;}
<div class="page-head"><h1>@ViewData["Title"]</h1><a class="btn" href="/Payroll">@T["nav.payroll"]</a></div>
<div class="flash">@(T.IsAr?"قوالب صريحة غير قابلة للتعديل حسب الدرجة الوظيفية. لا تطبق تلقائياً. التطبيق الفردي يغير الأساسي والبنود المذكورة من اليوم، ويترك البنود غير المذكورة كما هي، ويحفظ الدليل. لا تعديل رجعي أو إعادة حساب لدورة موجودة أو ضمان للامتثال القانوني. العملة EGP. لا تطبق مع تغيير توظيف مجدول. راجع المبالغ قبل التنفيذ.":"Immutable explicit job-grade templates. Never applied automatically. Individual application changes basic salary and listed components from today, leaves unlisted components unchanged and retains evidence. No backdating, existing-run recalculation or legal compliance guarantee. Currency EGP. Pending employment changes block application. Review amounts before applying.")</div>
<div class="card"><div class="card-h"><h2>@(T.IsAr?"القوالب المحفوظة":"Recorded structures")</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>@T["common.name"]</th><th>@(T.IsAr?"الدرجة":"Grade")</th><th>@T["pay.basic"]</th><th>@(T.IsAr?"البنود المحددة":"Listed components")</th><th>@T["common.reason"]</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Id</td><td>@s.Name</td><td>@s.JobGrade</td><td class="num">@s.Basic.ToString("N2") EGP</td><td>@foreach(var part in System.Text.Json.JsonSerializer.Deserialize<Dictionary<int,decimal>>(s.ComponentsJson)!){var c=components.FirstOrDefault(x=>x.Id==part.Key);<div>@(c==null?"#"+part.Key:T.Name(c.Name,c.NameAr)): @part.Value.ToString("N2")</div>}</td><td>@s.Reason<div class="faint small">@s.Actor · @s.At.ToString("yyyy-MM-dd") UTC</div></td></tr>}</tbody></table></div></div>
<div class="grid g2" style="margin-top:18px"><div class="card"><div class="card-h"><h2>@(T.IsAr?"تسجيل قالب جديد":"Record new structure")</h2></div><div class="card-b"><form method="post" action="/SalaryStructures/Create" asp-antiforgery="true" class="form-grid"><div class="field full"><label>@T["common.name"]</label><input name="name" maxlength="160" required></div><div class="field"><label>@(T.IsAr?"الدرجة الوظيفية":"Job grade")</label><input type="number" min="1" max="100" name="grade" required></div><div class="field"><label>@T["pay.basic"] (EGP)</label><input type="number" min="0" max="100000000" step="0.01" name="basic" required></div><div class="field full"><label>@(T.IsAr?"البنود: معرف=مبلغ، سطر لكل بند (اختياري)":"Components: ID=amount, one per line (optional)")</label><textarea name="componentAmounts" dir="ltr" placeholder="1=500.00"></textarea><small>@foreach(var c in components.Where(x=>x.IsFixed)){<span>@c.Id = @T.Name(c.Name,c.NameAr) (@T.E(c.Type)) · </span>}</small></div><div class="field full"><label>@T["common.reason"]</label><input name="reason" maxlength="2000" required></div><div><button class="btn btn-primary">@T["common.save"]</button></div></form></div></div>
@if(Me.Can(Perm.EmpManage)){<div class="card"><div class="card-h"><h2>@(T.IsAr?"تطبيق صريح على موظف":"Explicit individual application")</h2></div><div class="card-b"><form method="post" action="/SalaryStructures/Apply" asp-antiforgery="true" class="form-grid"><div class="field full"><label>@(T.IsAr?"معرف الموظف الداخلي من رابط الملف":"Internal employee ID from profile URL")</label><input name="employeeId" type="number" min="1" required></div><div class="field full"><label>@(T.IsAr?"القالب، يجب تطابق الدرجة":"Structure, grade must match")</label><select name="structureId">@foreach(var s in Model){<option value="@s.Id">#@s.Id @s.Name · @s.Basic.ToString("N2") EGP · @(T.IsAr?"درجة":"Grade") @s.JobGrade</option>}</select></div><div class="field full"><label>@T["common.reason"]</label><input name="reason" maxlength="2000" required></div><div><button class="btn btn-primary">@(T.IsAr?"تطبيق من اليوم":"Apply from today")</button></div></form></div></div>}</div>
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"آخر 100 دليل تطبيق":"Latest 100 application records")</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th>@(T.IsAr?"القالب":"Structure")</th><th>@T["common.reason"]</th><th>@(T.IsAr?"الدليل المحفوظ":"Retained evidence")</th><th>UTC</th></tr></thead><tbody>@foreach(var h in (List<SalaryStructureApplication>)ViewBag.History){<tr><td>#@h.EmployeeId</td><td>#@h.StructureId</td><td>@h.Reason<div class="small">@h.Actor</div></td><td><code>@h.Sha256[..12]</code><details><summary>@(T.IsAr?"قبل وبعد":"Before and after")</summary><pre dir="ltr" style="max-width:420px;white-space:pre-wrap">@h.BeforeJson
@h.AfterJson</pre></details></td><td>@h.At.ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div></div>
