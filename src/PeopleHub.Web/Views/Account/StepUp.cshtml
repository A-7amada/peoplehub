@{ViewData["Title"]=T.IsAr?"تحقق إضافي":"Confirm sensitive action";bool totp=ViewBag.Totp==true;}
<div class="page-head"><h1>@ViewData["Title"]</h1></div><div class="card" style="max-width:620px"><div class="card-b"><p>@(T.IsAr?"أدخل كلمة مرور حسابك الحالية وكود المصادقة إذا كان مفعلاً. يمنح التحقق هذه الجلسة خمس دقائق فقط للإجراءات الحساسة، ولا يوسع صلاحياتك. لن نعيد إرسال الإجراء السابق تلقائياً؛ بعد التحقق راجع الإجراء ونفذه مرة أخرى.":"Enter your current account password and authenticator code if enabled. Verification lasts five minutes in this session only and does not expand your permissions. We will not replay the previous action. After verification, review and repeat the action.")</p>@if(ViewBag.Error is string error){<div class="flash err">@error</div>}<form method="post" action="/Account/StepUp" asp-antiforgery="true" class="form-grid"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><div class="field full"><label>@(T.IsAr?"كلمة المرور الحالية":"Current password")</label><input type="password" name="password" autocomplete="current-password" required></div>@if(totp){<div class="field full"><label>@(T.IsAr?"كود المصادقة":"Authenticator code")</label><input name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required></div>}<div><button class="btn btn-primary">@(T.IsAr?"تحقق من الجلسة":"Verify this session")</button></div></form></div></div>
