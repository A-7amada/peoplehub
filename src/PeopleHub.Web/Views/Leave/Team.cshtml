@using PeopleHub.Application.Modules.Requests
@model List<(Employee Employee, LeaveRequest Leave)>
@{ ViewData["Title"] = T["leave.team"]; var up = (List<RequestRow>)ViewBag.Upcoming; }
<div class="page-head"><div><h1>@T["leave.team"]</h1><div class="sub">@T["leave.onLeaveToday"]</div></div><a class="btn" href="/Leave/Calendar">@T["leave.calendar"]</a></div>
<div class="grid g2"><div class="card"><div class="card-h"><h2>@T["dash.onLeave"]</h2></div><div class="card-b tight">@if (Model.Count == 0) { <div class="empty">@T["common.none"]</div> } else { <table class="tbl"><tbody>@foreach (var (e, l) in Model) { <tr><td><a class="person" href="/Employees/Profile/@e.Id">@Ui.Avatar(e, T)<span><div class="nm">@T.Name(e.FullName, e.FullNameAr)</div><div class="sb">@(Me.EmployeeId==e.Id||Me.Can(Perm.LeaveEvidence)?T.Name(l.LeaveType!.Name,l.LeaveType.NameAr):(T.IsAr?"إجازة خاصة":"Private leave"))</div></span></a></td><td class="right num small">@T.Date(l.StartDate) → @T.Date(l.EndDate)</td></tr> }</tbody></table> }</div></div>
<div class="card"><div class="card-h"><h2>@T["leave.upcoming"]</h2></div><div class="card-b tight">@if (up.Count == 0) { <div class="empty">@T["common.none"]</div> } else { <table class="tbl"><tbody>@foreach (var r in up) { <tr><td><a class="person" href="/Employees/Profile/@r.Employee.Id">@Ui.Avatar(r.Employee, T)<span><div class="nm">@T.Name(r.Employee.FullName, r.Employee.FullNameAr)</div><div class="sb">@T.Name(r.TypeName, r.TypeNameAr)</div></span></a></td><td class="right num small">@r.Detail</td></tr> }</tbody></table> }</div></div></div>
