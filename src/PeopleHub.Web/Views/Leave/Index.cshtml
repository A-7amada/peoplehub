@model List<RequestRow>
@{ ViewData["Title"] = T["nav.leave"]; var types = (List<LeaveType>)ViewBag.Types; var bal = (List<LeaveBalance>)ViewBag.Balances; DateTime today = ViewBag.Today; }
<div class="page-head"><div><h1>@T["nav.leave"]</h1><div class="sub">@T["leave.sub"]</div></div><div class="actions"><a class="btn" href="/Leave/Calendar">@T["leave.calendar"]</a><a class="btn" href="/Leave/Team">@Ui.Icon("users", 16) @T["leave.team"]</a></div></div>
<div class="grid g3" style="margin-bottom:18px">
@foreach (var b in bal) { var tot = Math.Max(1, b.Entitled + b.CarriedOver); <div class="card kpi"><div class="lbl">@T.Name(b.LeaveType!.Name, b.LeaveType.NameAr)</div><div class="val">@b.Remaining <span class="faint small" style="font-weight:500">/ @tot @T["common.days"]</span></div><div class="progress" style="margin-top:10px"><i style="width:@(100 * b.Remaining / tot)%"></i></div></div> }
</div>
<div class="grid g-main leave-workspace">
<div class="card"><div class="card-h"><h2>@T["leave.myRequests"]</h2></div>
 <partial name="_ReqTable" model="Model" />
</div>
<div class="card" style="align-self:start"><div class="card-h"><h2>@T["leave.request"]</h2></div><div class="card-b"><form method="post" action="/Leave/Request" asp-antiforgery="true" enctype="multipart/form-data">
 <div class="field"><label>@T["common.type"]</label><select name="typeId">@foreach (var t in types) { <option value="@t.Id">@T.Name(t.Name, t.NameAr)</option> }</select></div>
 <div class="form-grid"><div class="field"><label>@T["common.from"]</label><input type="date" name="start" value="@today.AddDays(7).ToString("yyyy-MM-dd")" required></div><div class="field"><label>@T["common.to"]</label><input type="date" name="end" value="@today.AddDays(8).ToString("yyyy-MM-dd")" required></div></div>
 <div class="field"><label>@T["common.reason"]</label><input type="text" name="reason"></div>
 <div class="field"><label>@T["leave.document"]</label><input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png"><span class="faint small">@T["leave.docHint"]</span></div>
 <button class="btn btn-primary">@T["common.submit"]</button><p class="muted small">@T["leave.routeHint"]</p></form></div></div>
</div>

<partial name="_LeaveLedger" model="(List<LeaveTransaction>)ViewBag.Ledger" />
