@using PeopleHub.Application.Modules.Benefits
@model BenefitView
@{ViewData["Title"]=T.IsAr?"مزايا الموظفين":"Employee benefits";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;bool hr=Me.Can(Perm.BenefitsManage);var employees=(List<Employee>)ViewBag.Employees;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("Plans and recorded coverage, separate from payroll","الخطط والتغطية المسجلة، منفصلة عن المرتبات")</p></div><a class="btn" href="/BenefitClaims">@X("Claims record","سجل المطالبات")</a></div>
<p class="muted small">@X("Internal records only. Eligibility is reviewed by an authorized benefits manager against the stated plan rules. Nothing buys insurance, notifies an insurer, deducts salary, pays money or guarantees coverage. Costs are monthly planning amounts per enrolled person, not invoices. Cancellation takes effect at the start of its recorded date. Expiry does not trigger an external cancellation. The benefits-management grant is separate and initially unassigned outside SystemAdmin.","سجلات داخلية فقط. يراجع مسؤول المزايا المخول الأهلية وفق شروط الخطة المكتوبة. لا تشتري تأميناً ولا تخطر شركة تأمين ولا تخصم راتباً ولا تدفع مبلغاً ولا تضمن تغطية. التكاليف تقديرات تخطيط شهرية لكل شخص مسجل وليست فواتير. يسري الإلغاء من بداية تاريخه المسجل. انتهاء السجل لا يلغي التغطية خارجياً. صلاحية إدارة المزايا منفصلة وغير ممنوحة مبدئياً إلا لمدير النظام.")</p>
@if(hr){var allocation=(BenefitAllocation)ViewBag.Allocation;
<div class="card" style="margin-bottom:24px"><div class="card-h"><h2>@X("Cost-centre planning snapshot","لقطة تخطيط مراكز التكلفة")</h2></div><div class="card-b">
<form method="get" action="/Benefits" class="inline-form"><label>@X("Active on","نشط في") <input type="date" name="asOf" value="@allocation.AsOf.ToString("yyyy-MM-dd")" required></label><button class="btn">@X("View snapshot","عرض اللقطة")</button></form>
<p class="muted small">@X("Full monthly planning shares for each active enrolment on this date, including dependents. Cancellation excludes its effective date. Currencies stay separate. Enrolment count is not a unique-person count across plans; employee counts are distinct within each row only. No daily proration, invoice, payroll deduction, payment or proof of insurer coverage.","حصص تخطيط شهرية كاملة لكل اشتراك نشط في هذا التاريخ، بما يشمل المعالين. يُستبعد الاشتراك من تاريخ سريان إلغائه. العملات منفصلة. عدد الاشتراكات ليس عدد أشخاص فريدين عبر الخطط، وعدد الموظفين فريد داخل كل صف فقط. لا توجد تجزئة يومية أو فاتورة أو خصم راتب أو دفع أو إثبات لتغطية شركة التأمين.")</p>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Cost centre","مركز التكلفة")</th><th>@X("Currency","العملة")</th><th>@X("Active enrolments","الاشتراكات النشطة")</th><th>@X("Employees","الموظفون")</th><th>@X("Employer monthly","حصة جهة العمل الشهرية")</th><th>@X("Employee monthly","حصة الموظف الشهرية")</th></tr></thead><tbody>
@foreach(var row in allocation.Rows){<tr><td>@row.CostCenter</td><td>@row.Currency</td><td>@row.ActiveEnrollments</td><td>@row.Employees</td><td><bdi>@row.EmployerMonthly.ToString("N2")</bdi></td><td><bdi>@row.EmployeeMonthly.ToString("N2")</bdi></td></tr>}
@if(allocation.Rows.Count==0){<tr><td colspan="6">@X("No active recorded enrolments on this date.","لا توجد اشتراكات مسجلة نشطة في هذا التاريخ.")</td></tr>}
</tbody></table></div></div></div>}
<div class="grid g2">@foreach(var p in Model.Plans){<div class="card"><div class="card-h"><h2>@p.Name</h2><span class="chip">@p.Currency</span></div><div class="card-b"><p>@p.Provider</p><h3>@X("Eligibility","شروط الأهلية")</h3><p class="muted">@p.Eligibility</p><h3>@X("Coverage description","وصف التغطية")</h3><p class="muted">@p.Coverage</p><p>@X("Dependents permitted","يسمح بالمعالين"): @X(p.DependentsAllowed?"Yes":"No",p.DependentsAllowed?"نعم":"لا")</p><div class="kv"><span>@X("Employer monthly","حصة جهة العمل الشهرية")</span><bdi>@p.EmployerMonthly.ToString("N2") @p.Currency</bdi></div><div class="kv"><span>@X("Employee monthly","حصة الموظف الشهرية")</span><bdi>@p.EmployeeMonthly.ToString("N2") @p.Currency</bdi></div></div></div>}</div>
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Recorded enrolments","التسجيلات المسجلة")</h2></div><div class="card-b">@if(Model.Enrollments.Count==0){<p class="muted">@X("No recorded coverage is visible to you.","لا توجد تغطية مسجلة متاحة لك.")</p>}@foreach(var e in Model.Enrollments){var plan=Model.Plans.First(x=>x.Id==e.PlanId);var cancel=Model.Cancellations.FirstOrDefault(x=>x.EnrollmentId==e.Id);<div class="card" style="margin-bottom:12px"><div class="card-b"><h3>@e.CoveredName · @plan.Name</h3><p>@X("Employee","الموظف") #@e.EmployeeId · @(e.CoveredRelationship switch{"Employee"=>X("Employee","الموظف"),"Spouse"=>X("Spouse","الزوج أو الزوجة"),"Child"=>X("Child","ابن أو ابنة"),_=>X("Other","آخر")}) · @T.Date(e.StartsOn) - @T.Date(e.EndsOn)</p><p class="muted">@e.EligibilityEvidence</p><p>@X("Cost centre","مركز التكلفة"): @e.CostCenter</p><p class="small faint">@e.Actor · @T.Date(e.At)</p>@if(cancel!=null){<p>@X("Cancellation effective","يسري الإلغاء"): @T.Date(cancel.EffectiveOn) · @cancel.Reason</p>}else if(hr){<form method="post" action="/Benefits/Cancel" asp-antiforgery="true" class="inline-form"><input type="hidden" name="enrollmentId" value="@e.Id"><label>@X("Effective on","يسري في") <input type="date" name="effectiveOn" required></label><input name="reason" maxlength="2000" placeholder="@X("Cancellation reason","سبب الإلغاء")" required><button class="btn">@X("Record cancellation","تسجيل الإلغاء")</button></form>}</div></div>}</div></div>
@if(hr){<div class="grid g2" style="margin-top:20px"><div class="card"><div class="card-h"><h2>@X("Record a plan","تسجيل خطة")</h2></div><div class="card-b"><form method="post" action="/Benefits/AddPlan" asp-antiforgery="true" class="form-grid">
<div class="field full"><label>@X("Plan name","اسم الخطة")</label><input name="name" maxlength="150" required></div><div class="field full"><label>@X("Provider","مقدم الخدمة")</label><input name="provider" maxlength="200" required></div><div class="field full"><label>@X("Eligibility rules","شروط الأهلية")</label><textarea name="eligibility" maxlength="2000" required></textarea></div><div class="field full"><label>@X("Coverage and exclusions","التغطية والاستثناءات")</label><textarea name="coverage" maxlength="4000" required></textarea></div><div class="field"><label>@X("Employer monthly per person","حصة جهة العمل شهرياً للفرد")</label><input type="number" step="0.01" min="0" name="employerMonthly" required></div><div class="field"><label>@X("Employee monthly per person","حصة الموظف شهرياً للفرد")</label><input type="number" step="0.01" min="0" name="employeeMonthly" required></div><div class="field"><label>@X("Currency (3 uppercase letters)","العملة (٣ حروف كبيرة)")</label><input name="currency" pattern="[A-Z]{3}" maxlength="3" required></div><label><input type="checkbox" name="dependentsAllowed" value="true"> @X("Dependent coverage allowed","يسمح بتغطية المعالين")</label><div class="full"><button class="btn btn-primary">@X("Save plan record","حفظ سجل الخطة")</button></div></form></div></div>
<div class="card"><div class="card-h"><h2>@X("Record eligibility and enrolment","تسجيل الأهلية والاشتراك")</h2></div><div class="card-b"><form method="post" action="/Benefits/Enroll" asp-antiforgery="true" class="form-grid"><div class="field full"><label>@X("Plan","الخطة")</label><select name="planId">@foreach(var p in Model.Plans){<option value="@p.Id">@p.Name</option>}</select></div><div class="field full"><label>@X("Employee","الموظف")</label><select name="employeeId">@foreach(var e in employees){<option value="@e.Id">#@e.Id @T.Name(e.FullName,e.FullNameAr)</option>}</select></div><div class="field full"><label>@X("Covered person","الشخص المغطى")</label><select name="dependentId"><option value="">@X("Employee","الموظف")</option>@foreach(var d in Model.Dependents){<option value="@d.Id">@d.Name · @X("employee","موظف") #@d.EmployeeId</option>}</select></div><div class="field"><label>@X("Starts on","يبدأ في")</label><input type="date" name="startsOn" required></div><div class="field"><label>@X("Ends on (inclusive)","ينتهي في (شامل)")</label><input type="date" name="endsOn" required></div><div class="field full"><label>@X("Eligibility evidence and source reference","دليل الأهلية ومرجع المصدر")</label><textarea name="eligibilityEvidence" maxlength="2000" required></textarea></div><div class="field full"><label>@X("Allocation cost centre","مركز تكلفة التخصيص")</label><input name="costCenter" maxlength="100" required></div><button class="btn btn-primary">@X("Record enrolment","تسجيل الاشتراك")</button></form></div></div></div>}
