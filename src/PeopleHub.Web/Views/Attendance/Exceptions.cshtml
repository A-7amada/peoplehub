@model PunchExceptionView
@{ViewData["Title"]=T.IsAr?"استثناءات البصمات":"Punch exceptions";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;DateTime from=ViewBag.From,to=ViewBag.To;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="muted">@X("Missing punches on recorded days after the scheduled shift ends. No times are invented. Days with no record use the normal absence calendar. Unknown device users need a separate verified mapping.","البصمات الناقصة في الأيام المسجلة بعد نهاية الوردية. لا تختلق أوقات. الأيام بلا سجل تظهر في تقويم الغياب. معرف الجهاز غير المعروف يحتاج مطابقة منفصلة موثقة.")</p></div></div>
<form method="get" class="inline-form" style="margin-bottom:20px"><label>@T["common.from"]</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")"><label>@T["common.to"]</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")"><button class="btn">@X("Review, max 93 days","مراجعة، حد أقصى 93 يوما")</button></form>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["emp.name"]</th><th>@T["common.date"]</th><th>@X("Exception","الاستثناء")</th><th>@X("Recorded in / out","الدخول / الخروج المسجل")</th><th>@X("Period","الفترة")</th><th></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@T.Name(row.EmployeeName,row.EmployeeNameAr)</td><td>@T.Date(row.Date)</td><td>@X(row.Kind,row.Kind switch{"MissingIn"=>"دخول مفقود","MissingOut"=>"خروج مفقود",_=>"بلا بصمات"})</td><td dir="ltr">@(row.CheckIn?.ToString("yyyy-MM-dd HH:mm")??"-") / @(row.CheckOut?.ToString("yyyy-MM-dd HH:mm")??"-")</td><td>@(row.Locked?X("Locked","مقفلة"):X("Open","مفتوحة"))</td><td><a href="/Attendance?id=@row.EmployeeId&year=@row.Date.Year&month=@row.Date.Month">@X("Review evidence","مراجعة الأدلة")</a>@if(row.EmployeeId==Me.EmployeeId&&!row.Locked){<span> · </span><a href="/Requests?kind=Correction">@X("Request correction","طلب تصحيح")</a>}</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="6" class="empty">@T["common.none"]</td></tr>}</tbody></table></div></div>
@if(Me.Can(Perm.AttManage)){<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Unmatched device evidence, latest 100","أدلة الجهاز غير المطابقة، آخر 100")</h2></div><div class="card-b"><ul class="timeline">@foreach(var punch in Model.Unmatched){<li><b>@punch.DeviceUserId</b> · @punch.Time.ToString("yyyy-MM-dd HH:mm:ss")</li>}</ul><form method="post" action="/Attendance/Reprocess" asp-antiforgery="true"><p class="muted small">@X("Rebuild recorded projections from retained evidence only. Manual and locked records remain unchanged. Reprocessing cannot infer a missing time or change an unknown user's mapping.","إعادة بناء الملخصات من الأدلة المحفوظة فقط. لا تتغير السجلات اليدوية والمقفلة. لا تستنتج وقتا ناقصا أو تغير مطابقة مستخدم مجهول.")</p><button class="btn">@X("Reprocess retained evidence","إعادة معالجة الأدلة المحفوظة")</button></form></div></div>}
