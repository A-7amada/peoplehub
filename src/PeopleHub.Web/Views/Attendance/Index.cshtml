@model List<DayRow>
@{
  var e = (Employee)ViewBag.Emp; int y = ViewBag.Year, m = ViewBag.Month; var today = (AttendanceRecord?)ViewBag.Today; var s = (AttendanceSummary)ViewBag.Summary; bool own = ViewBag.Own;
  ViewData["Title"] = T["nav.attendance"]; var first = new DateTime(y, m, 1); var prev = first.AddMonths(-1); var next = first.AddMonths(1);
  int offset = ((int)first.DayOfWeek + 1) % 7; // week starts Saturday
  var dows = new[] { DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
  string idq = own ? "" : "&id=" + e.Id;
}
<div class="page-head"><div><h1>@(own ? T["nav.attendance"] : T.Name(e.FullName, e.FullNameAr))</h1><div class="sub">@first.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</div></div>
 <div class="actions"><a class="btn" href="/Attendance/Daily">@Ui.Icon("users", 16) @T["att.daily"]</a><div class="seg"><a href="?year=@prev.Year&month=@prev.Month@idq">‹</a><a class="on">@first.ToString("MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</a><a href="?year=@next.Year&month=@next.Month@idq">›</a></div></div></div>
@if (own && SettingsService.DeviceMode) {
<div class="card" style="margin-bottom:18px"><div class="card-b" style="display:flex;gap:14px;align-items:center"><span class="avatar" style="width:52px;height:52px;background:#efeaff;color:#6b4ee6">@Ui.Icon("clock", 24)</span><div><b style="font-size:1.05rem">@(T.IsAr ? "الحضور من ماكينة البصمة" : "Attendance comes from the fingerprint device")</b><div class="muted">@(T.IsAr ? "سجّل حضورك وانصرافك على الماكينة. تظهر البصمات هنا بعد المزامنة." : "Punch in and out on the machine. Punches show here after the device syncs.") @(today?.CheckIn != null ? (T.IsAr ? "اليوم: " : "Today: ") + today.CheckIn.Value.ToString("HH:mm") + (today.CheckOut != null ? " - " + today.CheckOut.Value.ToString("HH:mm") : "") : "")</div></div></div></div>
} else if (own) {
<div class="card" style="margin-bottom:18px"><div class="card-b" style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
 <span class="avatar" style="width:52px;height:52px;background:#e7f8f0;color:#0b7f57">@Ui.Icon("clock", 24)</span>
 <div><b style="font-size:1.1rem">@T["att.today"]</b><div class="muted">@(today?.CheckIn == null ? T["att.notCheckedIn"] : T["att.in"] + " " + today.CheckIn.Value.ToString("HH:mm") + (today.CheckOut != null ? " · " + T["att.out"] + " " + today.CheckOut.Value.ToString("HH:mm") : ""))</div></div>
 <div style="margin-inline-start:auto;display:flex;gap:10px">
  <form method="post" action="/Attendance/CheckIn" asp-antiforgery="true" style="margin:0"><button class="btn btn-primary" disabled="@(today?.CheckIn != null)">@T["att.checkIn"]</button></form>
  <form method="post" action="/Attendance/CheckOut" asp-antiforgery="true" style="margin:0"><button class="btn" disabled="@(today?.CheckIn == null || today.CheckOut != null)">@T["att.checkOut"]</button></form></div></div></div> }
<div class="grid g4" style="margin-bottom:18px">
 <div class="card kpi t-green"><div class="lbl">@T["att.present"]</div><div class="val">@s.PresentDays<span class="faint small" style="font-weight:500"> / @s.WorkingDays</span></div></div>
 <div class="card kpi t-amber"><div class="lbl">@T["att.late"]</div><div class="val">@s.LateCount</div><div class="sub">@s.LateMinutes @T["att.min"]</div></div>
 <div class="card kpi t-rose"><div class="lbl">@T["att.absent"]</div><div class="val">@s.AbsentDays</div><div class="sub">@s.ExcusedAbsences @T["att.excused"]</div></div>
 <div class="card kpi t-violet"><div class="lbl">@T["att.overtime"]</div><div class="val">@s.OvertimeHours.ToString("0.#")</div><div class="sub">@s.LeaveDays @T["att.leaveDays"]</div></div></div>
<div class="card"><div class="card-b"><div class="cal">
 @foreach (var d in dows) { <div class="dow">@T["dow." + d]</div> }
 @for (var i = 0; i < offset; i++) { <div class="day pad"></div> }
 @foreach (var r in Model) {
  var cls = r.IsWorkingDay ? "" : "off"; if (r.Date == DateTime.Today) { cls += " today"; }
  <div class="day @cls"><b>@r.Date.Day</b>
   @if (r.HolidayName != null) { <span class="tag tag-b">@T.Name(r.HolidayName, r.HolidayNameAr ?? "")</span> }
   else if (r.Leave != null) { <span class="tag tag-b">@T.Name(r.Leave.LeaveType!.Name, r.Leave.LeaveType.NameAr)</span> }
   else if (r.Record?.CheckIn != null && r.Record.Status != AttendanceStatus.Absent) { <span dir="ltr" class="tag @(r.Record.Status == AttendanceStatus.Late ? "tag-a" : "tag-g")">@r.Record.CheckIn.Value.ToString("HH:mm")@(r.Record.CheckOut != null ? "–" + r.Record.CheckOut.Value.ToString("HH:mm") : "")</span>
     @if (r.Record.LateMinutes > 0) { <span class="faint">+@r.Record.LateMinutes @T["att.min"]</span> } }
   else if (r.IsAbsent) { <span class="tag tag-r">@T["att.absent"]</span> }
   else if (!r.IsWorkingDay) { <span class="faint">@T["att.weekend"]</span> }
  </div> }
</div></div></div>

<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"سجل أدلة الحضور غير القابل للتعديل":"Append-only attendance evidence")</h2></div><div class="card-b"><p class="muted small">@(T.IsAr?"تبدأ الأدلة من هذا التحديث. السجلات السابقة لا يعاد اختلاقها. أوقات الدخول والخروج محلية كما سجلت، ووقت التسجيل UTC. بصمات الجهاز الأصلية محفوظة ولا تتغير بالتصحيح.":"Evidence starts with this upgrade. Earlier history is not reconstructed. In/out times are local as recorded; recorded-at is UTC. Raw device punches remain unchanged by corrections.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@(T.IsAr?"التاريخ":"Date")</th><th>@T["common.type"]</th><th>@(T.IsAr?"قبل":"Before")</th><th>@(T.IsAr?"بعد":"After")</th><th>@T["common.reason"]</th><th>UTC</th></tr></thead><tbody>@foreach(var x in (List<AttendanceEvidence>)ViewBag.Evidence){<tr><td class="nowrap">@x.Date.ToString("yyyy-MM-dd")</td><td>@(T.IsAr ? x.Event switch {"CheckIn"=>"تسجيل دخول","CheckOut"=>"تسجيل خروج","ManualEntry"=>"إدخال يدوي","ExcusedAbsence"=>"عذر غياب","DeviceProjection"=>"معالجة بصمات الجهاز","ApprovedCorrection"=>"تصحيح معتمد",_=>x.Event} : x.Event)</td><td dir="ltr">@(x.BeforeIn?.ToString("HH:mm")??"-") / @(x.BeforeOut?.ToString("HH:mm")??"-")</td><td dir="ltr">@(x.AfterIn?.ToString("HH:mm")??"-") / @(x.AfterOut?.ToString("HH:mm")??"-")</td><td>@x.Reason @if(x.CorrectionId!=null){<span>#@x.CorrectionId</span>}</td><td class="nowrap">@x.At.ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div></div></div>

<div class="card" style="margin-top:18px"><div class="card-b"><b>@((bool)ViewBag.Locked?(T.IsAr?"فترة الحضور مغلقة":"Attendance period locked"):(T.IsAr?"فترة الحضور مفتوحة":"Attendance period open"))</b><p class="muted">@(T.IsAr?"الإغلاق نهائي. تصل بصمات الجهاز المتأخرة للسجل الأصلي دون تغيير ملخص الفترة المغلقة. التصحيحات المالية تتبع إجراء تسوية منفصل.":"Locks are permanent. Late device punches remain in the raw ledger without changing a locked daily summary. Financial corrections need a separate adjustment process.")</p>@if(Me.Can(Perm.AttManage) && !(bool)ViewBag.Locked){<form method="post" action="/Attendance/Lock" asp-antiforgery="true" class="inline-form"><input type="hidden" name="employeeId" value="@ViewBag.Emp.Id"><input type="hidden" name="year" value="@ViewBag.Year"><input type="hidden" name="month" value="@ViewBag.Month"><input name="reason" placeholder="@T["common.reason"]" required><button class="btn">@(T.IsAr?"اعتماد وإغلاق الشهر المكتمل":"Approve and lock completed month")</button></form>}</div></div>
