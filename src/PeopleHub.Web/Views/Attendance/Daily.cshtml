@model List<DailyRow>
@{ ViewData["Title"] = T["att.daily"]; DateTime date = ViewBag.Date; int? dept = ViewBag.Dept; var depts = (List<Department>)ViewBag.Depts;
   bool officer = Me.Can(Perm.AttManage); }
<div class="page-head"><div><h1>@T["att.daily"]</h1><div class="sub">@date.ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</div></div>
 <div class="actions"><form class="inline-form" method="get"><input type="date" name="date" value="@date.ToString("yyyy-MM-dd")"><select name="dept"><option value="">@T["emp.allDepts"]</option>@foreach (var d in depts) { <option value="@d.Id" selected="@(dept == d.Id)">@T.Name(d.Name, d.NameAr)</option> }</select><button class="btn">@T["common.filter"]</button></form></div></div>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th>@T["att.checkIn"]</th><th>@T["att.checkOut"]</th><th>@T["att.late"]</th><th>@T["att.overtime"]</th><th>@T["common.status"]</th>@if (officer) { <th></th> }</tr></thead><tbody>
@foreach (var r in Model) {
 var rec = r.Record; var st = r.OnLeave ? "OnLeave" : rec == null ? (date.Date < DateTime.Today && !PeopleHub.Domain.Entities.AttendanceCalculator.IsWeekend(date) ? "Absent" : "None") : rec.Status.ToString();
 <tr><td><a class="person" href="/Attendance?id=@r.Employee.Id">@Ui.Avatar(r.Employee, T)<span><div class="nm">@T.Name(r.Employee.FullName, r.Employee.FullNameAr)</div><div class="sb">@T.Name(r.Employee.Department!.Name, r.Employee.Department.NameAr)</div></span></a></td>
  <td class="num">@(rec?.CheckIn?.ToString("HH:mm") ?? "-")</td><td class="num">@(rec?.CheckOut?.ToString("HH:mm") ?? "-")</td><td class="num">@(rec?.LateMinutes > 0 ? rec.LateMinutes + " " + T["att.min"] : "-")</td><td class="num">@(rec?.OvertimeMinutes > 0 ? rec.OvertimeMinutes + " " + T["att.min"] : "-")</td>
  <td>@if (st == "None") { <span class="faint">-</span> } else { @Ui.Chip(T.E(st), Ui.StatusTone(st)) }@if (rec?.IsExcused == true) { <span class="faint small"> @T["att.excused"]</span> }</td>
  @if (officer) { <td class="right"><details class="more"><summary>@T["att.edit"]</summary>
   <form method="post" action="/Attendance/Manual" asp-antiforgery="true" class="inline-form" style="margin-top:8px"><input type="hidden" name="employeeId" value="@r.Employee.Id"><input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")"><input type="time" name="checkIn" value="@rec?.CheckIn?.ToString("HH:mm")"><input type="time" name="checkOut" value="@rec?.CheckOut?.ToString("HH:mm")"><input type="hidden" name="source" value="0"><button class="btn btn-sm">@T["common.save"]</button></form>
   <form method="post" action="/Attendance/Excuse" asp-antiforgery="true" class="inline-form" style="margin-top:6px"><input type="hidden" name="employeeId" value="@r.Employee.Id"><input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")"><input type="text" name="note" placeholder="@T["common.reason"]" style="width:120px"><button class="btn btn-sm">@T["att.excuse"]</button></form></details></td> }</tr> }
</tbody></table></div></div>
