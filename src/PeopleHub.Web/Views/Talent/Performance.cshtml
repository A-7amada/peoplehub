@model List<PerformanceReview>
@{ ViewData["Title"] = T.IsAr ? "تقييم الأداء" : "Performance"; Func<string, string, string> X = (en, a) => T.IsAr ? a : en; var emps = (List<Employee>)ViewBag.Reviewable; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Periodic reviews with goals, a 1 to 5 score and manager comments. You see your own and your team's.", "تقييمات دورية بالأهداف ودرجة من 1 إلى 5 وتعليق المدير. ترى تقييماتك وتقييمات فريقك.")</div></div></div>
<div class="grid g-main-r">
 <div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th>@X("Period", "الفترة")</th><th>@X("Score", "الدرجة")</th><th>@X("Goals and comment", "الأهداف والتعليق")</th></tr></thead><tbody>
 @foreach (var r in Model) { <tr><td>@T.Name(r.Employee!.FullName, r.Employee.FullNameAr)</td><td>@r.Period</td><td>@for (var i = 1; i <= 5; i++) { <span style="color:@(i <= r.Score ? "#f5a623" : "#d8dbe8")">★</span> }</td><td class="small">@r.Goals<div class="faint">@r.Comment</div></td></tr> }
 @if (Model.Count == 0) { <tr><td colspan="4" class="empty">@T["common.none"]</td></tr> }</tbody></table></div></div>
 @if (emps.Count > 0) { <div class="card"><div class="card-h"><h2>@X("New review", "تقييم جديد")</h2></div><div class="card-b"><form method="post" action="/Talent/AddReview" asp-antiforgery="true">
  <div class="field"><label>@T["req.employee"]</label><select name="employeeId">@foreach (var e in emps) { <option value="@e.Id">@T.Name(e.FullName, e.FullNameAr)</option> }</select></div>
  <div class="field"><label>@X("Period", "الفترة")</label><input name="period" value="@DateTime.Today.Year H1" required></div>
  <div class="field"><label>@X("Score (1 to 5)", "الدرجة (1 إلى 5)")</label><input type="number" name="score" min="1" max="5" value="3" required></div>
  <div class="field"><label>@X("Goals", "الأهداف")</label><textarea name="goals" rows="2"></textarea></div><div class="field"><label>@X("Comment", "تعليق")</label><textarea name="comment" rows="2"></textarea></div>
  <button class="btn btn-primary">@T["common.save"]</button></form></div></div> }
</div>
