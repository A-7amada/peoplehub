@model List<TrainingCourse>
@{ ViewData["Title"] = T.IsAr ? "التدريب" : "Training"; Func<string, string, string> X = (en, a) => T.IsAr ? a : en; var en = (List<TrainingParticipant>)ViewBag.Enrollments; var evidence=(TrainingEvidenceView)ViewBag.Evidence; bool mgr = Context.User.Claims.Any() && PermissionCache.Has(Context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value), Perm.TalentManage); }
<p class="muted small">@X("Certificate expiry reminders are private in-app alerts for the employee and training managers, within 30 days and after expiry, at most daily while this service is awake. No email is sent and delivery time is not guaranteed.","تنبيهات انتهاء الشهادات داخل التطبيق فقط للموظف ومسؤولي التدريب، خلال ٣٠ يوماً قبل الانتهاء وبعده، مرة يومياً كحد أقصى أثناء تشغيل الخدمة. لا تُرسل رسالة بريد ولا يوجد ضمان لموعد التسليم.")</p>
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Course catalogue, enrolment and completion tracking.", "كتالوج الدورات والتسجيل ومتابعة الإتمام.")</div></div></div>
<div class="grid g2">
@foreach (var c in Model) { var mine = en.Where(e => e.CourseId == c.Id).ToList();
 <div class="card"><div class="card-h"><h2>@(T.IsAr && c.TitleAr != "" ? c.TitleAr : c.Title)</h2><span class="faint small">@c.Hours @X("hours", "ساعات") · @c.Date.ToString("yyyy-MM-dd")</span></div>
  <div class="card-b"><div class="small muted">@X("Course approval","اعتماد الدورة"): @(c.ApprovalStatus switch{"Pending"=>X("Pending","قيد الاعتماد"),"Approved"=>X("Approved","معتمدة"),"Rejected"=>X("Rejected","مرفوضة"),_=>X("Legacy, approval evidence unavailable","سجل سابق، دليل الاعتماد غير متاح")})</div>
@if(mgr){<p class="muted small">@c.Need</p>@if(c.PlannedBudget is {} budget){<p>@X("Planned budget","الميزانية المخططة"): <bdi>@budget.ToString("N2") @c.Currency</bdi> · @X("Planning only, no payment authorization","للتخطيط فقط، ليس إذناً بالدفع")</p>}@if(c.DecidedAt is {} decided){<p class="small muted">@T.Date(decided) · @c.DecisionReason</p>}}
@if(mgr&&c.ApprovalStatus=="Pending"&&c.CreatedByUserId!=Me.UserId){<form method="post" action="/Talent/DecideCourse" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@c.Id"><div class="field full"><label>@T["common.reason"]</label><input name="reason" maxlength="2000" required></div><div class="full"><button class="btn btn-primary" name="approve" value="true">@X("Approve course plan","اعتماد خطة الدورة")</button><button class="btn" name="approve" value="false">@X("Reject","رفض")</button></div></form>}
<div class="small muted" style="margin-bottom:8px">@mine.Count @X("enrolled", "مسجل") · @mine.Count(m => m.Completed) @X("completed", "أتم")</div>
  @foreach (var m in mine) { <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0"><span>@T.Name(m.FullName, m.FullNameAr)</span>
   @if (m.Completed) { @Ui.Chip(X("Completed", "مكتمل"), "green") } else if (mgr) { <form method="post" action="/Talent/Complete" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@m.Id"><button class="btn btn-sm">@X("Mark complete", "تم الإتمام")</button></form> } else { @Ui.Chip(X("In progress", "جارٍ"), "amber") } </div> }
  @if((c.ApprovalStatus is "Approved" or "Legacy")&&!mine.Any(x=>x.EmployeeId==Me.EmployeeId)){<form method="post" action="/Talent/Enroll" asp-antiforgery="true" style="margin-top:10px"><input type="hidden" name="courseId" value="@c.Id"><button class="btn btn-sm btn-primary">@X("Enrol me", "سجّلني")</button></form>}</div></div> }
</div>
@if (mgr) { <div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("New course", "دورة جديدة")</h2></div><div class="card-b"><form method="post" action="/Talent/AddCourse" asp-antiforgery="true" class="grid g2">
 <div class="field"><label>@X("Title", "العنوان")</label><input name="title" required></div><div class="field"><label>@X("Title (Arabic)", "العنوان بالعربية")</label><input name="titleAr"></div>
 <div class="field"><label>@X("Hours", "الساعات")</label><input type="number" name="hours" min="1" value="4"></div><div class="field"><label>@X("Date", "التاريخ")</label><input type="date" name="date" value="@(Today().AddDays(14).ToString("yyyy-MM-dd"))"></div>
 <div class="field full"><label>@X("Training need and expected application","الاحتياج التدريبي والتطبيق المتوقع")</label><textarea name="need" maxlength="2000" required></textarea></div><div class="field"><label>@X("Planned budget, optional","الميزانية المخططة، اختياري")</label><input name="budget" type="number" min="0" max="1000000000" step="0.01"></div><div class="field"><label>@X("Currency code when budget entered","رمز العملة عند إدخال الميزانية")</label><input name="currency" maxlength="3" pattern="[A-Z]{3}" placeholder="EGP"></div><p class="muted small full">@X("A different HR account must approve this plan before enrolment. Budget is a planning estimate, never a purchase or payment authorization. No approval is invented for existing legacy courses.","يجب اعتماد الخطة من حساب موارد بشرية آخر قبل التسجيل. الميزانية تقدير تخطيطي وليست شراءً أو إذناً بالدفع. لا يتم اختراع اعتماد للدورات السابقة.")</p><div><button class="btn btn-primary">@X("Propose course","اقتراح دورة")</button></div></form></div></div> }

<div class="card" style="margin-top:24px"><div class="card-h"><h2>@X("Certificates and learning evidence","الشهادات وأدلة التعلم")</h2></div><div class="card-b"><p class="muted small">@X("Private employee/HR evidence. Expiry is a recorded date, not issuer verification. No automatic pay, promotion or compliance decision. Budgets, needs analysis and course approval remain separate.","أدلة خاصة بالموظف والموارد البشرية. تاريخ الصلاحية مسجل وليس تحققاً من الجهة المصدرة. لا يترتب عليها قرار آلي بالأجر أو الترقية أو الامتثال. الميزانيات وتحليل الاحتياجات واعتماد الدورات مسارات منفصلة.")</p>
@foreach(var item in en.Where(x=>x.Completed && (mgr || x.EmployeeId==Me.EmployeeId))){
<div class="card" style="margin-top:16px"><div class="card-h"><h3>@T.Name(item.FullName,item.FullNameAr) · @T.Name(Model.Single(x=>x.Id==item.CourseId).Title,Model.Single(x=>x.Id==item.CourseId).TitleAr)</h3></div><div class="card-b">
@foreach(var cert in evidence.Certificates.Where(x=>x.EnrollmentId==item.Id)){var expired=cert.ExpiresOn is {} end && end.Date<Today();<div class="kv"><span><a href="/Files/Get/@cert.AttachmentToken">@cert.Reference</a> · @cert.Issuer · @T.Date(cert.IssuedOn)</span><span>@if(cert.ExpiresOn is {} expiry){@T.Date(expiry) @Ui.Chip(expired?X("Expired","منتهية"):X("Valid date","سارية بالتاريخ"),expired?"red":"green")}</span></div>}
@foreach(var outcome in evidence.Outcomes.Where(x=>x.EnrollmentId==item.Id)){<div style="margin:12px 0"><b>@(outcome.Kind=="Participant"?X("Participant reflection","تقييم المشارك"):X("Effectiveness evidence","أدلة الفاعلية"))</b><div class="muted">@outcome.Note</div><small class="faint">@T.Date(outcome.At) · @outcome.Actor</small></div>}
@if(item.EmployeeId==Me.EmployeeId || mgr){<form method="post" action="/Talent/TrainingOutcome" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="enrollmentId" value="@item.Id"><input type="hidden" name="kind" value="@(item.EmployeeId==Me.EmployeeId?"Participant":"Effectiveness")"><div class="field full"><label>@(item.EmployeeId==Me.EmployeeId?X("What did you learn and apply?","ماذا تعلمت وطبقت؟"):X("Observed effectiveness and evidence","الفاعلية الملحوظة وأدلتها"))</label><textarea name="note" maxlength="2000" required></textarea></div><div class="full"><button class="btn">@X("Record evidence","تسجيل الدليل")</button></div></form>}
@if(mgr){<details style="margin-top:16px"><summary>@X("Record certificate","تسجيل شهادة")</summary><form method="post" action="/Talent/TrainingCertificate" enctype="multipart/form-data" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="enrollmentId" value="@item.Id"><div class="field"><label>@X("Issuer","الجهة المصدرة")</label><input name="issuer" maxlength="200" required></div><div class="field"><label>@X("Certificate reference","مرجع الشهادة")</label><input name="reference" maxlength="150" required></div><div class="field"><label>@X("Issued on","تاريخ الإصدار")</label><input name="issuedOn" type="date" max="@Today().ToString("yyyy-MM-dd")" required></div><div class="field"><label>@X("Expires on (optional)","تاريخ الانتهاء (اختياري)")</label><input name="expiresOn" type="date"></div><div class="field full"><label>@X("Certificate file, PDF/JPG/PNG, up to 2MB","ملف الشهادة PDF/JPG/PNG بحد أقصى 2 ميجابايت")</label><input name="file" type="file" accept=".pdf,.jpg,.jpeg,.png" required></div><div class="full"><button class="btn btn-primary">@X("Save certificate evidence","حفظ دليل الشهادة")</button></div></form></details>}
</div></div>
}
</div></div>
@functions { DateTime Today()=>Context.RequestServices.GetRequiredService<AppClock>().Today; }
