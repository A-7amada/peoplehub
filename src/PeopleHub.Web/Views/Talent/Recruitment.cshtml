@using PeopleHub.Application.Common
@using PeopleHub.Application.Modules.Talent
@model List<Candidate>
@{ ViewData["Title"] = T.IsAr ? "التوظيف" : "Recruitment"; Func<string, string, string> X = (en, a) => T.IsAr ? a : en; var jobs = (List<JobOpening>)ViewBag.Jobs; var depts = (List<Department>)ViewBag.Depts;
   var stages = new[] { CandidateStage.Applied, CandidateStage.Screening, CandidateStage.Interview, CandidateStage.Offer, CandidateStage.Hired, CandidateStage.Rejected };
   var stageAr = new Dictionary<CandidateStage, string> { [CandidateStage.Applied] = "تقدّم", [CandidateStage.Screening] = "فرز", [CandidateStage.Interview] = "مقابلة", [CandidateStage.Offer] = "عرض", [CandidateStage.Hired] = "تم التعيين", [CandidateStage.Rejected] = "مرفوض" }; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Job openings and a candidate pipeline. Candidates here are fictional.", "الوظائف الشاغرة ومسار المرشحين. المرشحون هنا وهميون.")</div></div></div>
<div class="kanban">
@foreach (var st in stages) { var list = Model.Where(c => c.Stage == st).ToList();
 <div class="kcol"><div class="kh">@(T.IsAr ? stageAr[st] : st.ToString()) <span class="kn">@list.Count</span></div>
 @foreach (var c in list) { <div class="kcard"><b>@c.Name</b><div class="faint small">@(T.IsAr && !string.IsNullOrEmpty(c.Job?.TitleAr) ? c.Job.TitleAr : c.Job?.Title)</div>@if (!string.IsNullOrEmpty(c.Note)) { <div class="small muted">@c.Note</div> }
  @if (Candidate.Next(c.Stage) is { } nx) { <div style="display:flex;gap:6px;margin-top:8px"><form method="post" action="/Talent/Move" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@c.Id"><button class="btn btn-sm btn-primary">@X("Advance", "تقدّم")</button></form>
   <form method="post" action="/Talent/Move" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@c.Id"><input type="hidden" name="reject" value="true"><button class="btn btn-sm">@X("Reject", "رفض")</button></form></div> }</div> }
 </div> }
</div>
<div class="grid" style="margin-top:18px">
 <div class="card"><div class="card-h"><h2>@X("Openings", "الوظائف")</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Title", "المسمى")</th><th>@T["emp.department"]</th><th>@X("Positions", "العدد")</th><th>@X("Approval","الاعتماد")</th><th></th></tr></thead><tbody>
  @foreach (var j in jobs) { <tr><td>@(T.IsAr && j.TitleAr != "" ? j.TitleAr : j.Title)</td><td>@(j.Department == null ? "-" : T.Name(j.Department.Name, j.Department.NameAr))</td><td class="num">@j.Positions</td>
   <td>@(j.ApprovalStatus switch{"Pending"=>X("Pending","قيد الاعتماد"),"Approved"=>X("Approved","معتمدة"),"Rejected"=>X("Rejected","مرفوضة"),_=>X("Legacy, approval unknown","سابق، الاعتماد غير معلوم")})<div class="muted small">@j.Justification</div>@if(j.DecidedAt is {} when){<div class="muted small">@T.Date(when) · @j.ApprovalReason</div>}</td><td class="right">
   @if(j.ApprovalStatus=="Pending"&&j.RequestedByUserId!=Me.UserId){<form method="post" action="/Talent/DecideJob" asp-antiforgery="true"><input type="hidden" name="id" value="@j.Id"><input name="reason" maxlength="2000" placeholder="@T["common.reason"]" required><button class="btn btn-sm btn-primary" name="approve" value="true">@X("Approve requisition","اعتماد الطلب")</button><button class="btn btn-sm" name="approve" value="false">@X("Reject","رفض")</button></form>}
   @if(j.ApprovalStatus is "Approved" or "Legacy"){<form method="post" action="/Talent/ToggleJob" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@j.Id"><button class="btn btn-sm">@(j.IsOpen ? X("Close", "إغلاق") : X("Reopen", "إعادة فتح"))</button></form>}</td></tr> }</tbody></table></div>
  <div class="card-b"><form method="post" action="/Talent/AddJob" asp-antiforgery="true" class="grid g2"><div class="field"><label>@X("Title", "المسمى")</label><input name="title" required></div><div class="field"><label>@X("Title (Arabic)", "المسمى بالعربية")</label><input name="titleAr"></div>
   <div class="field"><label>@T["emp.department"]</label><select name="dept"><option value="">-</option>@foreach (var d in depts) { <option value="@d.Id">@T.Name(d.Name, d.NameAr)</option> }</select></div><div class="field"><label>@X("Positions", "العدد")</label><input type="number" name="positions" value="1" min="1"></div>
   <div class="field"><label>@X("Business need and justification","الاحتياج ومبرر التوظيف")</label><textarea name="justification" maxlength="2000" required></textarea></div><p class="small muted">@X("A different HR user must approve before candidates can be added. This does not publish a job or authorize an offer or spend.","يلزم اعتماد مستخدم موارد بشرية آخر قبل إضافة المرشحين. هذا لا ينشر الوظيفة ولا يعتمد عرضاً أو مصروفاً.")</p><div><button class="btn btn-primary">@X("Request opening", "طلب وظيفة")</button></div></form></div></div>
 <div class="card"><div class="card-h"><h2>@X("Add candidate", "إضافة مرشح")</h2></div><div class="card-b"><form method="post" action="/Talent/AddCandidate" asp-antiforgery="true">
  <div class="field"><label>@X("Opening", "الوظيفة")</label><select name="jobId">@foreach (var j in jobs.Where(j => j.IsOpen)) { <option value="@j.Id">@(T.IsAr && j.TitleAr != "" ? j.TitleAr : j.Title)</option> }</select></div>
  <div class="field"><label>@T["common.name"]</label><input name="name" required></div><div class="field"><label>@T["login.email"]</label><input type="email" name="email" dir="ltr"></div><div class="field"><label>@X("Note", "ملاحظة")</label><input name="note"></div>
  <button class="btn btn-primary">@T["common.add"]</button></form></div></div>
</div>
@{var interviewData=(RecruitmentInterviewView)ViewBag.Interviews;var interviewers=(List<Employee>)ViewBag.Interviewers;var cairo=TimeZoneInfo.FindSystemTimeZoneById("Africa/Cairo");}
<div class="card" style="margin-top:24px"><div class="card-h"><h2>@X("Interview plans","خطط المقابلات")</h2></div><div class="card-b"><p class="muted small">@X("Internal scheduling in Africa/Cairo time. No calendar invitation, candidate message or room booking is sent. Availability is checked against interview plans here only, not external calendars. Cancel and create a new plan to reschedule.","جدولة داخلية بتوقيت القاهرة Africa/Cairo. لا ترسل دعوة تقويم أو رسالة للمرشح ولا تحجز غرفة. فحص التعارض مع خطط المقابلات هنا فقط وليس التقويمات الخارجية. لتغيير الموعد ألغ الخطة وأنشئ أخرى.")</p>
@foreach(var item in interviewData.Interviews){var candidate=Model.FirstOrDefault(x=>x.Id==item.CandidateId);var interviewer=interviewers.FirstOrDefault(x=>x.Id==item.InterviewerEmployeeId);<div class="card" style="margin-top:12px"><div class="card-b"><b>@candidate?.Name · @(interviewer==null?"#"+item.InterviewerEmployeeId:T.Name(interviewer.FullName,interviewer.FullNameAr))</b><div class="kv"><span><bdi>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(item.StartsAt,DateTimeKind.Utc),cairo).ToString("yyyy-MM-dd HH:mm") Africa/Cairo</bdi> · @item.Minutes @X("minutes","دقيقة")</span>@Ui.Chip(item.Status switch{"Scheduled"=>X("Scheduled","مجدولة"),"Completed"=>X("Completed","مكتملة"),_=>X("Cancelled","ملغاة")},item.Status=="Completed"?"green":"gray")</div><div class="muted">@item.Place · @item.Note</div>
@if(item.Status=="Scheduled"){<form method="post" action="/Talent/CloseInterview" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="interviewId" value="@item.Id"><div class="field full"><label>@X("Outcome or cancellation reason","النتيجة أو سبب الإلغاء")</label><textarea name="note" maxlength="2000" required></textarea></div><div class="full">@if(item.StartsAt.AddMinutes(item.Minutes)<=Context.RequestServices.GetRequiredService<AppClock>().UtcNow){<button class="btn btn-primary" name="complete" value="true">@X("Record completed","تسجيل الإتمام")</button>}<button class="btn" name="complete" value="false">@X("Cancel plan","إلغاء الخطة")</button></div></form>}
@foreach(var ev in interviewData.History.Where(x=>x.InterviewId==item.Id)){<p class="muted small">@T.Date(ev.At) · @ev.Actor · @ev.Note</p>}
</div></div>}
<details style="margin-top:20px"><summary>@X("Schedule an interview plan","جدولة خطة مقابلة")</summary><form method="post" action="/Talent/ScheduleInterview" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><div class="field"><label>@X("Candidate","المرشح")</label><select name="candidateId">@foreach(var c in Model.Where(x=>x.Stage is not(CandidateStage.Hired or CandidateStage.Rejected))){<option value="@c.Id">@c.Name</option>}</select></div><div class="field"><label>@X("Interviewer","المحاور")</label><select name="interviewerEmployeeId">@foreach(var e in interviewers){<option value="@e.Id">@T.Name(e.FullName,e.FullNameAr)</option>}</select></div><div class="field"><label>@X("Starts at, Cairo time","البداية بتوقيت القاهرة")</label><input type="datetime-local" style="width:100%;padding:10px 12px;border:1px solid var(--line,#dce1ed);border-radius:8px;min-height:42px;background:var(--surface,#fff);color:inherit" name="localStart" required></div><div class="field"><label>@X("Duration in minutes","المدة بالدقائق")</label><input type="number" name="minutes" min="15" max="480" value="60" required></div><div class="field full"><label>@X("Place or meeting link","المكان أو رابط المقابلة")</label><input name="place" maxlength="300" required></div><div class="field full"><label>@X("Interview purpose and plan","هدف المقابلة وخطتها")</label><textarea name="note" maxlength="2000" required></textarea></div><div class="full"><button class="btn btn-primary">@X("Save internal plan","حفظ الخطة الداخلية")</button></div></form></details>
</div></div>
@{var offerData=(RecruitmentOfferView)ViewBag.Offers;}
<div class="card" style="margin-top:24px"><div class="card-h"><h2>@X("Internal offer register","سجل العروض الداخلي")</h2></div><div class="card-b"><p class="muted small">@X("Internal proposals only, not sent offers or signed contracts. A different HR user must approve. Acceptance/decline records need source evidence in the note. Nothing sends a message, creates an employee, starts payroll or authorizes payment. Candidate hiring status requires a recorded accepted offer.","مقترحات داخلية فقط وليست عروضاً مرسلة أو عقوداً موقعة. يلزم اعتماد مستخدم موارد بشرية آخر. تسجيل القبول أو الرفض يحتاج مرجع الدليل في الملاحظة. لا يرسل رسالة ولا ينشئ موظفاً ولا يبدأ راتباً ولا يعتمد دفعاً. حالة تعيين المرشح تتطلب عرضاً مسجلاً بموافقة المرشح.")</p>
@foreach(var offer in offerData.Offers){var candidate=Model.FirstOrDefault(x=>x.Id==offer.CandidateId);var events=offerData.Events.Where(x=>x.OfferId==offer.Id).ToList();var state=events.LastOrDefault()?.Kind??"Proposed";<div class="card" style="margin-top:16px"><div class="card-b"><h3>@candidate?.Name · @offer.RoleTitle</h3><div class="kv"><span><bdi>@offer.MonthlyBase.ToString("N2") @offer.Currency</bdi> · @X("monthly base, proposed","أساسي شهري مقترح")</span><b>@(state switch{"Proposed"=>X("Proposed","مقترح"),"Approved"=>X("Approved internally","معتمد داخلياً"),"Rejected"=>X("Rejected","مرفوض"),"Accepted"=>X("Acceptance recorded","مسجل قبول المرشح"),"Declined"=>X("Decline recorded","مسجل رفض المرشح"),_=>X("Withdrawn","مسحوب")})</b></div><p>@X("Start","البداية"): @T.Date(offer.StartOn) · @X("Valid through","صالح حتى"): @T.Date(offer.ValidUntil)</p><p class="muted">@offer.Terms</p><small class="faint">@offer.Actor · @T.Date(offer.At)</small>
@foreach(var ev in events){<p class="muted small">@T.Date(ev.At) · @ev.Actor · @(ev.Kind switch{"Approved"=>X("Approved internally","معتمد داخلياً"),"Rejected"=>X("Rejected","مرفوض"),"Accepted"=>X("Acceptance recorded","مسجل قبول المرشح"),"Declined"=>X("Decline recorded","مسجل رفض المرشح"),"Withdrawn"=>X("Withdrawn","مسحوب"),_=>ev.Kind}) · @ev.Note</p>}
@if(state is "Proposed" or "Approved"){<form method="post" action="/Talent/DecideOffer" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="offerId" value="@offer.Id"><div class="field full"><label>@X("Decision reason or evidence reference","سبب القرار أو مرجع الدليل")</label><textarea name="note" maxlength="4000" required></textarea></div><div class="full">@if(state=="Proposed"&&offer.CreatedByUserId!=Me.UserId){<button class="btn btn-primary" name="decision" value="Approved">@X("Approve proposal internally","اعتماد المقترح داخلياً")</button><button class="btn" name="decision" value="Rejected">@X("Reject proposal","رفض المقترح")</button>}@if(state=="Approved"){<button class="btn btn-primary" name="decision" value="Accepted">@X("Record candidate acceptance","تسجيل قبول المرشح")</button><button class="btn" name="decision" value="Declined">@X("Record candidate decline","تسجيل رفض المرشح")</button>}<button class="btn" name="decision" value="Withdrawn">@X("Withdraw","سحب")</button></div></form>}
</div></div>}
<details style="margin-top:20px"><summary>@X("Propose internal offer","اقتراح عرض داخلي")</summary><form method="post" action="/Talent/ProposeOffer" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><div class="field"><label>@X("Candidate at offer stage","مرشح في مرحلة العرض")</label><select name="candidateId">@foreach(var c in Model.Where(x=>x.Stage==CandidateStage.Offer)){<option value="@c.Id">@c.Name</option>}</select></div><div class="field"><label>@X("Role title","المسمى الوظيفي")</label><input name="roleTitle" maxlength="200" required></div><div class="field"><label>@X("Proposed monthly base","الأساسي الشهري المقترح")</label><input name="monthlyBase" type="number" min="0" max="1000000000" step="0.01" required></div><div class="field"><label>@X("Currency code","رمز العملة")</label><input name="currency" maxlength="3" pattern="[A-Z]{3}" placeholder="EGP" required></div><div class="field"><label>@X("Proposed start date","تاريخ البداية المقترح")</label><input name="startOn" type="date" required></div><div class="field"><label>@X("Offer valid through","صالح حتى")</label><input name="validUntil" type="date" required></div><div class="field full"><label>@X("Proposed terms and conditions, not a signed agreement","الشروط المقترحة، ليست اتفاقاً موقعاً")</label><textarea name="terms" maxlength="4000" required></textarea></div><div class="full"><button class="btn btn-primary">@X("Save proposal","حفظ المقترح")</button></div></form></details>
</div></div>

@{var candFiles=(List<CandidateFileInfo>)ViewBag.CandFiles;}
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Candidate CVs and documents","السير الذاتية ومستندات المرشحين")</h2></div><div class="card-b">
<p class="muted small">@X("Visible only to talent managers. PDF, JPG or PNG up to 2 MB, up to 10 files per candidate. The file type and size are checked; files are not scanned for malware and authenticity is not verified. Every upload and download is audited. Fictional demo files only.","تظهر لمديري المواهب فقط. ملفات PDF أو JPG أو PNG حتى 2 ميجابايت وبحد أقصى 10 ملفات لكل مرشح. يتم فحص نوع الملف وحجمه فقط ولا يتم فحص البرمجيات الخبيثة أو التحقق من الأصالة. يتم تدقيق كل رفع وتنزيل. ملفات توضيحية وهمية فقط.")</p>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Candidate","المرشح")</th><th>@X("Type","النوع")</th><th>@X("File","الملف")</th><th>@X("Size","الحجم")</th><th>@X("Uploaded","تاريخ الرفع")</th><th></th></tr></thead><tbody>
@foreach(var cf in candFiles){var who=Model.FirstOrDefault(x=>x.Id==cf.CandidateId);<tr><td>@(who?.Name??("#"+cf.CandidateId))</td><td>@(cf.Kind=="CV"?X("CV","سيرة ذاتية"):X("Document","مستند"))</td><td><a href="/Talent/CandidateFile/@cf.Token">@cf.FileName</a></td><td>@((cf.Size/1024)+1) KB</td><td>@T.Date(cf.At)</td><td><form method="post" action="/Talent/DeleteCandidateFile" asp-antiforgery="true"><input type="hidden" name="id" value="@cf.Id"><button class="btn btn-sm">@X("Remove","حذف")</button></form></td></tr>}
@if(candFiles.Count==0){<tr><td colspan="6">@X("No files uploaded.","لا توجد ملفات مرفوعة.")</td></tr>}
</tbody></table></div>
<form method="post" action="/Talent/UploadCandidateFile" enctype="multipart/form-data" asp-antiforgery="true" class="form-grid" style="margin-top:12px">
<div class="field"><label>@X("Candidate","المرشح")</label><select name="candidateId">@foreach(var c in Model){<option value="@c.Id">@c.Name</option>}</select></div>
<div class="field"><label>@X("Type","النوع")</label><select name="kind"><option value="CV">@X("CV","سيرة ذاتية")</option><option value="Document">@X("Document","مستند")</option></select></div>
<div class="field"><label>@X("File","الملف")</label><input class="input" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required></div>
<div class="field"><label>&nbsp;</label><button class="btn btn-primary">@X("Upload","رفع")</button></div></form></div></div>
