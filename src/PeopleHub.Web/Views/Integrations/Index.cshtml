@using PeopleHub.Application.Modules.Operations
@{ViewData["Title"]=T.IsAr?"كتالوج التكاملات":"Integration catalog";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;var rows=(List<IntegrationEntry>)ViewBag.Rows;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("Registry of external integrations and their status","سجل التكاملات الخارجية وحالتها")</p></div><a class="btn" href="/Retention">@X("Retention and legal hold","الاحتفاظ والتجميد القانوني")</a></div>
<p class="muted small">@X("This registry holds descriptions only. No password, key or token is stored or shown here: the reference label names the item in your approved secrets store. Enabling an entry records intent; no adapter is connected yet. Illustrative demo data.","يحتفظ هذا السجل بالأوصاف فقط. لا تُخزن أو تُعرض هنا أي كلمة مرور أو مفتاح أو رمز: تسمية المرجع تحدد العنصر في مخزن الأسرار المعتمد. التفعيل يسجل النية فقط ولا يوجد موصل متصل بعد. بيانات توضيحية.")</p>
<div class="card" style="margin-bottom:18px"><div class="card-b"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Name","الاسم")</th><th>@X("Purpose","الغرض")</th><th>@X("Owner","المالك")</th><th>@X("Version","الإصدار")</th><th>@X("Authentication","المصادقة")</th><th>@X("Credential reference","مرجع الاعتماد")</th><th>@X("Last rotation","آخر تدوير")</th><th>@X("Status","الحالة")</th><th></th></tr></thead><tbody>
@foreach(var r in rows){<tr><td>@r.Name</td><td>@r.Purpose</td><td>@r.OwnerName</td><td>@r.SupportedVersion</td><td>@r.AuthMethod</td><td>@(r.CredentialRef==""?"-":r.CredentialRef)</td><td>@(r.CredentialRotatedAt?.ToString("yyyy-MM-dd")??"-")</td><td>@Ui.Chip(r.Status=="Enabled"?X("Enabled","مفعّل"):X("Disabled","معطّل"),r.Status=="Enabled"?"green":"gray")</td>
<td><form method="post" action="/Integrations/Status" asp-antiforgery="true" style="display:inline"><input type="hidden" name="id" value="@r.Id"><input type="hidden" name="enabled" value="@(r.Status=="Enabled"?"false":"true")"><button class="btn btn-sm">@(r.Status=="Enabled"?X("Disable","تعطيل"):X("Enable","تفعيل"))</button></form>
@if(r.AuthMethod!="None"){<form method="post" action="/Integrations/Rotated" asp-antiforgery="true" style="display:inline-flex;gap:6px;margin-top:6px"><input type="hidden" name="id" value="@r.Id"><input class="input" name="credentialRef" maxlength="100" placeholder="@X("New reference label","تسمية المرجع الجديدة")" required><button class="btn btn-sm">@X("Record rotation","تسجيل التدوير")</button></form>}</td></tr>}
@if(rows.Count==0){<tr><td colspan="9">@X("No integrations registered.","لا توجد تكاملات مسجلة.")</td></tr>}
</tbody></table></div></div></div>
<div class="card"><div class="card-h"><h2>@X("Register an integration","تسجيل تكامل")</h2></div><div class="card-b">
<form method="post" action="/Integrations/Register" asp-antiforgery="true" class="form-grid">
<div class="field"><label>@X("Name","الاسم")</label><input class="input" name="name" required maxlength="100"></div>
<div class="field"><label>@X("Purpose","الغرض")</label><input class="input" name="purpose" required maxlength="300"></div>
<div class="field"><label>@X("Owner","المالك")</label><input class="input" name="owner" required maxlength="100"></div>
<div class="field"><label>@X("Supported version","الإصدار المدعوم")</label><input class="input" name="version" required maxlength="40"></div>
<div class="field"><label>@X("Authentication","المصادقة")</label><select class="input" name="authMethod">@foreach(var a in IntegrationRegistry.AuthMethods){<option>@a</option>}</select></div>
<div class="field"><label>@X("Credential reference (label only)","مرجع الاعتماد (تسمية فقط)")</label><input class="input" name="credentialRef" maxlength="100"></div>
<div class="field"><label>&nbsp;</label><button class="btn btn-primary">@X("Register (starts disabled)","تسجيل (يبدأ معطلاً)")</button></div></form></div></div>
