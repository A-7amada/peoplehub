@using PeopleHub.Application.Modules.Operations
@{ViewData["Title"]=T.IsAr?"جدول الاحتفاظ والتجميد القانوني":"Retention schedule and legal hold";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;var rules=(List<RetentionRule>)ViewBag.Rules;var holds=(List<LegalHold>)ViewBag.Holds;var review=(List<RetentionCandidate>)ViewBag.Review;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("Review list only. Nothing is deleted or anonymised here.","قائمة مراجعة فقط. لا يتم حذف أو إخفاء أي بيانات هنا.")</p></div></div>
<p class="muted small">@X("A period of 0 months means keep. The periods are your configuration, not legal advice: the demo has no validated Egyptian retention rule, so a labour lawyer must review them before real use. A held employee is left out of the review list until the hold is released.","الصفر يعني الاحتفاظ. الفترات من إعدادك وليست استشارة قانونية: لا توجد قاعدة احتفاظ مصرية معتمدة في العرض ويجب مراجعتها من محام عمالي قبل الاستخدام الفعلي. الموظف المجمد خارج قائمة المراجعة حتى رفع التجميد.")</p>
<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("Retention periods","فترات الاحتفاظ")</h2></div><div class="card-b"><table class="tbl"><thead><tr><th>@X("Category","الفئة")</th><th>@X("Months","الأشهر")</th><th></th></tr></thead><tbody>
@foreach(var r in rules){<tr><td>@(r.Category=="Employees"?X("Employees after resignation, termination or retirement","الموظفون بعد الاستقالة أو الإنهاء أو التقاعد"):X("Rejected candidates after application","المرشحون المرفوضون بعد التقديم"))</td><td><form method="post" action="/Retention/Rule" asp-antiforgery="true" style="display:inline-flex;gap:6px"><input type="hidden" name="category" value="@r.Category"><input class="input" type="number" min="0" max="1200" name="months" value="@r.Months" style="width:110px"><button class="btn btn-sm">@X("Save","حفظ")</button></form></td><td></td></tr>}
</tbody></table></div></div>
<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("Past retention, for review","تجاوزت مدة الاحتفاظ للمراجعة")</h2></div><div class="card-b"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Category","الفئة")</th><th>@X("Record","السجل")</th><th>@X("Since","منذ")</th></tr></thead><tbody>
@foreach(var c in review){<tr><td>@c.Category</td><td>@c.Label</td><td>@c.Since.ToString("yyyy-MM-dd")</td></tr>}
@if(review.Count==0){<tr><td colspan="3">@X("Nothing is past its period.","لا شيء تجاوز مدته.")</td></tr>}
</tbody></table></div></div></div>
<div class="card"><div class="card-h"><h2>@X("Legal holds","التجميد القانوني")</h2></div><div class="card-b"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Employee","الموظف")</th><th>@X("Reason","السبب")</th><th>@X("Placed","التاريخ")</th><th>@X("Status","الحالة")</th></tr></thead><tbody>
@foreach(var h in holds){<tr><td>#@h.EmployeeId</td><td>@h.Reason</td><td>@h.PlacedAt.ToString("yyyy-MM-dd")</td><td>@if(h.IsActive){<form method="post" action="/Retention/Release" asp-antiforgery="true" style="display:inline-flex;gap:6px"><input type="hidden" name="id" value="@h.Id"><input class="input" name="reason" maxlength="500" required placeholder="@X("Release reason","سبب الرفع")"><button class="btn btn-sm">@X("Release","رفع")</button></form>}else{<span>@X("Released","مرفوع") @h.ReleasedAt?.ToString("yyyy-MM-dd")</span>}</td></tr>}
@if(holds.Count==0){<tr><td colspan="4">@X("No holds.","لا يوجد تجميد.")</td></tr>}
</tbody></table></div>
<form method="post" action="/Retention/Hold" asp-antiforgery="true" class="form-grid" style="margin-top:14px"><div class="field"><label>@X("Employee number (id)","رقم الموظف (المعرف)")</label><input class="input" type="number" min="1" name="employeeId" required></div><div class="field"><label>@X("Reason","السبب")</label><input class="input" name="reason" maxlength="500" required></div><div class="field"><label>&nbsp;</label><button class="btn btn-primary">@X("Place hold","تجميد")</button></div></form></div></div>
