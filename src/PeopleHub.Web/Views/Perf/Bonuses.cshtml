@model List<PerfBonus>
@{ViewData["Title"]=T.IsAr?"مكافآت الأداء المعلقة":"Pending performance awards";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;var runs=(List<PayrollRun>)ViewBag.Runs;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Payroll staff explicitly apply a proposed award to a draft run. The normal HR/finance/final payroll approvals still apply. It is not a payment.", "مسؤول المرتبات يضيف المقترح صراحة لمسير مسودة ثم تمر عليه موافقات الموارد البشرية والمالية والاعتماد النهائي المعتادة. هذا ليس صرفًا.")</div></div></div>
@foreach(var b in Model){<div class="card" style="margin-bottom:14px"><div class="card-b"><b>@X("Employee", "الموظف") #@b.EmployeeId · @b.Amount.ToString("N2") EGP</b><p>@b.Reason</p><div class="faint small">@b.ProposedBy · <a href="/Perf/Appraisal/@b.AppraisalId">#@b.AppraisalId</a></div><form method="post" action="/Perf/ApplyBonus" asp-antiforgery="true" class="inline-form" style="margin-top:12px"><input type="hidden" name="bonusId" value="@b.Id"><select name="runId">@foreach(var r in runs.Where(r=>r.Status==PayrollStatus.Draft)){<option value="@r.Id">@r.Year-@r.Month</option>}</select><button class="btn btn-primary">@X("Apply once to draft", "إضافة مرة واحدة للمسودة")</button></form></div></div>}
@if(Model.Count==0){<div class="card"><div class="card-b">@T["common.none"]</div></div>}
