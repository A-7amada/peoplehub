@using PeopleHub.Application.Modules.Talent
@model (PipView View,int AppraisalId)
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Performance improvement milestones","مراحل خطة تحسين الأداء")</h2></div><div class="card-b"><p class="muted">@X("Explicit support goals and progress evidence, not an automatic disciplinary decision. The employee may record updates; their manager or HR reviews completion or cancellation. No score, salary or employment status changes. Dates and success measures are chosen by the reviewer.","أهداف دعم وأدلة تقدم محددة وليست قرارا تأديبيا تلقائيا. يسجل الموظف التحديثات ويراجع المدير أو الموارد البشرية الإتمام أو الإلغاء. لا تتغير الدرجة أو الراتب أو الحالة الوظيفية. يحدد المراجع المواعيد ومعايير النجاح.")</p>
@foreach(var m in Model.View.Milestones){<section style="border-top:1px solid var(--line);padding-top:16px;margin-top:16px"><h3>@m.Title</h3><p>@m.SuccessMeasure</p><p class="small muted">@T.Date(m.DueOn) · @X(m.Status,m.Status switch{"Open"=>"مفتوحة","Completed"=>"مكتملة",_=>"ملغاة"})</p><ul class="timeline">@foreach(var entry in Model.View.Progress.Where(x=>x.MilestoneId==m.Id)){<li><b>@X(entry.Kind,entry.Kind switch{"Created"=>"إنشاء","Update"=>"تحديث","Completed"=>"إتمام",_=>"إلغاء"}) @(entry.Progress?.ToString()+ (entry.Progress==null?"":"%"))</b><div>@entry.Note</div><div class="faint small">@entry.Actor · @entry.At.ToString("yyyy-MM-dd HH:mm") UTC</div></li>}</ul>
@if(m.Status=="Open"){<form method="post" action="/Perf/UpdateMilestone" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@Model.AppraisalId"><input type="hidden" name="milestoneId" value="@m.Id"><div class="field"><label>@X("Reported progress %","التقدم المبلغ عنه %")</label><input type="number" name="progress" min="0" max="100" required></div><div class="field"><label>@X("Action","الإجراء")</label><select name="action"><option value="Update">@X("Record progress","تسجيل التقدم")</option>@if(Model.View.CanReview){<option value="Completed">@X("Confirm completion (100%)","تأكيد الإتمام (100%)")</option><option value="Cancelled">@X("Cancel milestone","إلغاء المرحلة")</option>}</select></div><div class="field full"><label>@X("Evidence / reason","الدليل / السبب")</label><textarea name="note" required maxlength="2000"></textarea></div><div class="full"><button class="btn">@T["common.save"]</button></div></form>}</section>}
@if(Model.View.CanReview){<h3 style="margin-top:22px">@X("New milestone","مرحلة جديدة")</h3><form method="post" action="/Perf/AddMilestone" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@Model.AppraisalId"><div class="field"><label>@X("Title","العنوان")</label><input name="title" required maxlength="200"></div><div class="field"><label>@X("Due date","موعد الاستحقاق")</label><input type="date" name="dueOn" required></div><div class="field full"><label>@X("Measurable success criteria","معايير النجاح القابلة للقياس")</label><textarea name="measure" required maxlength="1000"></textarea></div><div class="field full"><label>@X("Reason and support offered","السبب والدعم المقدم")</label><textarea name="reason" required maxlength="2000"></textarea></div><div class="full"><button class="btn btn-primary">@T["common.add"]</button></div></form>}
</div></div>
