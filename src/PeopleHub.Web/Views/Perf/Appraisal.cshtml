@model AppraisalView
@{ var a = Model.A; ViewData["Title"] = T.Name(a.Employee!.FullName, a.Employee.FullNameAr); Func<string, string, string> X = (en, ar) => T.IsAr ? ar : en;
  bool closed = a.Cycle!.Status == CycleStatus.Closed; bool self = Model.CanSelf || (!Model.CanManage && !Model.CanCalibrate && a.EmployeeId == (int.TryParse(Context.User.FindFirst("emp")?.Value, out var meId) ? meId : -1));
  bool showMgr = !self || closed; bool devEdit = Model.CanManage || Model.CanCalibrate || self || Context.User.Claims.Any(x => x.Type == System.Security.Claims.ClaimTypes.Role && PermissionCache.Has(new[] { x.Value }, Perm.TalentManage)); var tools=(PerfTools)ViewBag.Tools; bool hr=Context.User.Claims.Any(x=>x.Type==System.Security.Claims.ClaimTypes.Role && PermissionCache.Has(new[]{x.Value},Perm.TalentManage)); int wsum = Model.Goals.Sum(g => g.Weight);
  string BandAr(string b) => b switch { "Outstanding" => "متميز", "Exceeds" => "يفوق التوقعات", "Meets" => "يحقق التوقعات", _ => "يحتاج تحسين" };
  string RecAr(string r) => r switch { "PromotionReview+Bonus" => "مراجعة ترقية ومكافأة", "Bonus" => "مكافأة أداء", "ImprovementPlan" => "خطة تحسين", _ => "لا إجراء" }; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@a.Cycle.Name · <a href="/Perf?cycle=@a.CycleId">@X("Back to cycle", "رجوع للدورة")</a></div></div>
 @if (Model.Final != null && showMgr) { <div class="actions">@Ui.Chip((T.IsAr ? BandAr(PerfCalc.Band(Model.Final.Value)) : PerfCalc.Band(Model.Final.Value)) + " · " + Model.Final.Value.ToString("0.00"), "violet")</div> }</div>
<div class="grid perf-detail">
<div>
 <div class="card"><div class="card-h"><h2>@X("Goals and KPIs", "الأهداف ومؤشرات الأداء")</h2><span class="faint small">@X("Weights total", "مجموع الأوزان") @wsum%</span></div>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Goal", "الهدف")</th><th>@X("Target", "المستهدف")</th><th>%</th><th>@X("Progress", "التقدم")</th><th>@X("Self", "ذاتي")</th><th>@X("Manager", "المدير")</th></tr></thead><tbody>
  @foreach (var g in Model.Goals) { <tr><td>@g.Title</td><td class="small">@g.Target</td><td class="num">@g.Weight</td>
   <td>@if ((Model.CanSelf || Model.CanManage)) { <form method="post" action="/Perf/Progress" asp-antiforgery="true" class="inline-form" style="margin:0"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="goalId" value="@g.Id"><input type="number" name="progress" min="0" max="100" value="@g.Progress" style="width:70px"><button class="btn btn-sm">@T["common.save"]</button></form> } else { <div class="bar"><span style="width:@g.Progress%"></span></div><span class="small">@g.Progress%</span> }</td>
   <td class="num">@if (Model.CanSelf) { <form method="post" action="/Perf/Progress" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="goalId" value="@g.Id"><input type="hidden" name="progress" value="@g.Progress"><input type="number" name="selfScore" min="1" max="5" value="@(g.SelfScore ?? 3)" style="width:58px"><button class="btn btn-sm">✓</button></form> } else { @(g.SelfScore?.ToString() ?? "-") }</td><td class="num">@(showMgr ? g.ManagerScore?.ToString() ?? "-" : "-")</td></tr> }
  @if (Model.Goals.Count == 0) { <tr><td colspan="6" class="empty">@T["common.none"]</td></tr> }</tbody></table></div>
  @if (Model.CanManage && !a.ManagerDone && wsum < 100) { <div class="card-b"><form method="post" action="/Perf/AddGoal" asp-antiforgery="true" class="grid g2"><input type="hidden" name="id" value="@a.Id">
   <div class="field"><label>@X("Goal", "الهدف")</label><input name="title" required></div><div class="field"><label>@X("Target (measure)", "المستهدف (القياس)")</label><input name="target"></div>
   <div class="field"><label>@X("Weight %", "الوزن %")</label><input type="number" name="weight" min="1" max="@(100 - wsum)" value="@(100 - wsum)"></div><div style="align-self:end"><button class="btn btn-primary">@T["common.add"]</button></div></form></div> }</div>
 <div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("Development plan", "خطة التطوير")</h2></div><div class="card-b">
  @foreach (var d in Model.Dev) { <form method="post" action="/Perf/ToggleDev" asp-antiforgery="true" style="margin:0;display:flex;gap:10px;align-items:center;padding:4px 0"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="itemId" value="@d.Id"><button class="btn btn-sm" @((devEdit && d.CourseId == null) ? "" : "disabled")>@(d.Done ? "☑" : "☐")</button><span style="@(d.Done ? "text-decoration:line-through" : "")">@d.Action</span><span class="faint small">@(d.Due?.ToString("yyyy-MM-dd"))</span></form> }
  @if (devEdit) { <form method="post" action="/Perf/AddDev" asp-antiforgery="true" class="inline-form" style="margin-top:10px"><input type="hidden" name="id" value="@a.Id"><input name="action" type="text" placeholder="@X("Action, course or mentoring", "إجراء أو دورة أو إرشاد")" required style="flex:1"><input type="date" name="due"><button class="btn btn-sm btn-primary">@T["common.add"]</button></form> }</div></div>
</div>
<div>
 <div class="card"><div class="card-h"><h2>@X("Self assessment", "التقييم الذاتي")</h2>@if (a.SelfDone) { @Ui.Chip(X("Submitted", "تم"), "green") }</div><div class="card-b">
  @if (Model.CanSelf) { <form method="post" action="/Perf/Self" asp-antiforgery="true"><input type="hidden" name="id" value="@a.Id"><div class="field"><label>@X("Overall (1 to 5)", "التقييم العام (1 إلى 5)")</label><input type="number" name="score" min="1" max="5" value="3"></div><div class="field"><label>@X("Comment", "تعليق")</label><textarea name="comment" rows="3"></textarea></div><button class="btn btn-primary">@X("Submit", "إرسال")</button></form> }
  else { <b>@(a.SelfScore?.ToString() ?? "-")</b><div class="muted small">@a.SelfComment</div> }</div></div>
 <div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("Manager rating", "تقييم المدير")</h2></div><div class="card-b">
  @if (Model.CanManage) { <form method="post" action="/Perf/Manager" asp-antiforgery="true"><input type="hidden" name="id" value="@a.Id">
   @foreach (var g in Model.Goals) { <div class="field"><label>@g.Title (@g.Weight%)</label><input type="number" name="g_@g.Id" min="1" max="5" value="@(g.ManagerScore ?? 3)"></div> }
   <div class="field"><label>@X("Overall (1 to 5)", "التقييم العام (1 إلى 5)")</label><input type="number" name="score" min="1" max="5" value="@(a.ManagerScore ?? 3)"></div><div class="field"><label>@X("Comment", "تعليق")</label><textarea name="comment" rows="3">@a.ManagerComment</textarea></div>
   <button class="btn btn-primary">@X("Save rating", "حفظ التقييم")</button></form> }
  else if (showMgr) { <b>@(a.ManagerScore?.ToString() ?? "-")</b><div class="muted small">@a.ManagerComment</div> } else { <div class="muted">@X("Visible after the cycle closes.", "تظهر بعد إغلاق الدورة.")</div> }</div></div>
 @if (showMgr && Model.Computed != null) { <div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("Result", "النتيجة")</h2></div><div class="card-b small">
  @X("Goals score", "درجة الأهداف"): <b>@(Model.GoalScore?.ToString("0.00") ?? "-")</b> · @X("Computed with cycle weights", "المحسوبة بأوزان الدورة"): <b>@Model.Computed.Value.ToString("0.00")</b>
  @if (a.CalibrationNote != "") { <div style="margin-top:6px">@X("Calibration", "المعايرة"): <b>@a.FinalScore?.ToString("0.00")</b> · @a.CalibrationNote</div> }
  @if (Model.Final != null && (!self || closed)) { <div style="margin-top:8px">@X("Advisory outcome", "النتيجة الاسترشادية"): <b>@(T.IsAr ? RecAr(PerfCalc.Recommendation(Model.Final.Value)) : PerfCalc.Recommendation(Model.Final.Value))</b><div class="faint">@X("A person decides on promotion, bonus or an improvement plan. Nothing changes salary automatically.", "القرار للإنسان في الترقية والمكافأة وخطة التحسين. لا شيء يغيّر الراتب تلقائياً.")</div></div> }</div></div> }
 @if (Model.CanCalibrate && a.ManagerDone) { <div class="card" style="margin-top:18px"><div class="card-h"><h2>@X("HR calibration", "معايرة الموارد البشرية")</h2></div><div class="card-b"><form method="post" action="/Perf/Calibrate" asp-antiforgery="true"><input type="hidden" name="id" value="@a.Id">
  <div class="field"><label>@X("Final score (1 to 5)", "الدرجة النهائية (1 إلى 5)")</label><input type="number" step="0.01" name="score" min="1" max="5" value="@((Model.Final ?? Model.Computed ?? 3).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"></div>
  <div class="field"><label>@X("Reason (required, audited)", "السبب (مطلوب ويُسجل)")</label><textarea name="note" rows="2" required></textarea></div><button class="btn btn-primary">@X("Save calibration", "حفظ المعايرة")</button></form></div></div> }
</div></div>

<partial name="_Extensions" model="Model" />

@if(closed){var responses=(List<PerformanceResponse>)ViewBag.Responses;bool owner=a.EmployeeId==Me.EmployeeId;<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Acknowledgement and appeal","الإقرار والتظلم")</h2></div><div class="card-b"><p class="muted small">@X("Acknowledgement means receipt, not agreement. An appeal decision never rewrites the closed score or changes payroll. A recommended change requires a separate reviewed correction.","الإقرار يعني الاستلام وليس الموافقة. قرار التظلم لا يعيد كتابة الدرجة المقفلة ولا يغير الراتب. التغيير الموصى به يحتاج تصحيحا منفصلا بعد المراجعة.")</p><ul class="timeline">@foreach(var response in responses){<li><b>@X(response.Kind,response.Kind switch{"Acknowledged"=>"إقرار بالاستلام","Appeal"=>"تظلم","Upheld"=>"تأييد النتيجة",_=>"توصية بالتغيير"})</b><div>@response.Note</div><div class="muted small">@T.Date(response.At) · @response.Actor</div></li>}</ul>
@if(owner&&Model.Final!=null){<form method="post" action="/Perf/Respond" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@a.Id"><div class="field"><label>@X("Response","الرد")</label><select name="kind">@if(!responses.Any(x=>x.Kind=="Acknowledged")){<option value="Acknowledged">@X("Acknowledge receipt","الإقرار بالاستلام")</option>}@if(!responses.Any(x=>x.Kind=="Appeal")){<option value="Appeal">@X("Submit appeal","تقديم تظلم")</option>}</select></div><div class="field"><label>@X("Note / reason","ملاحظة / سبب")</label><textarea name="note" required maxlength="2000"></textarea></div><div class="full"><button class="btn btn-primary">@T["common.save"]</button></div></form>}
@if(hr&&!owner){foreach(var appeal in responses.Where(x=>x.Kind=="Appeal"&&!responses.Any(y=>y.AppealId==x.Id))){<form method="post" action="/Perf/DecideAppeal" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="appealId" value="@appeal.Id"><div class="field"><label>@X("Appeal decision","قرار التظلم")</label><select name="decision"><option value="Upheld">@X("Uphold result","تأييد النتيجة")</option><option value="ChangeRecommended">@X("Recommend correction","التوصية بتصحيح")</option></select></div><div class="field"><label>@X("Reason","السبب")</label><textarea name="note" required maxlength="2000"></textarea></div><div class="full"><button class="btn">@T["common.save"]</button></div></form>}}
</div></div>}

<partial name="_Pip" model="((PipView)ViewBag.Pip,a.Id)" />

<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Closed-cycle performance history","سجل الأداء للدورات المغلقة")</h2></div><div class="card-b"><p class="muted small">@X("Up to 12 closed cycles in date order. Missing results stay unknown. Cycle weights and goals may differ, so scores are descriptive, not a normalized trend or a promotion decision.","حتى 12 دورة مغلقة بترتيب التاريخ. النتائج الناقصة تبقى غير معروفة. قد تختلف الأوزان والأهداف، فالدرجات وصفية وليست اتجاها موحدا أو قرار ترقية.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Cycle","الدورة")</th><th>@X("Ends","النهاية")</th><th>@X("Score","الدرجة")</th><th>@X("Open milestones","مراحل مفتوحة")</th><th>@X("Completed milestones","مراحل مكتملة")</th></tr></thead><tbody>@foreach(var row in (List<PerformanceTrend>)ViewBag.Trends){<tr><td><a href="/Perf/Appraisal/@row.AppraisalId">@row.Cycle</a></td><td>@T.Date(row.EndsOn)</td><td>@(row.Score?.ToString("0.00")??"-")</td><td>@row.OpenMilestones</td><td>@row.CompletedMilestones</td></tr>}</tbody></table></div></div></div>
