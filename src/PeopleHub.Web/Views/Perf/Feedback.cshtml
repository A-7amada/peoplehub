@model List<(Feedback360 F, PerfAppraisal A)>
@{ ViewData["Title"] = T.IsAr ? "تقييم 360" : "360 feedback"; Func<string,string,string> X=(e,a)=>T.IsAr?a:e; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Invited reviewers submit once. HR and the direct manager can see names and comments. The employee sees only the average after close. This is confidential, not anonymous.", "المقيم المدعو يرسل مرة واحدة. الموارد البشرية والمدير المباشر يريان الاسم والتعليق. الموظف يرى المتوسط فقط بعد الإغلاق. التقييم سري وليس مجهول الهوية.")</div></div></div>
<div class="grid g2">@foreach(var row in Model){var f=row.F;var a=row.A;<div class="card"><div class="card-h"><h2>@T.Name(a.Employee!.FullName,a.Employee.FullNameAr)</h2><span>@a.Cycle!.Name</span></div><div class="card-b">
@if(f.SubmittedAt==null && a.Cycle.Status==CycleStatus.Open){<form method="post" action="/Perf/SubmitFeedback" asp-antiforgery="true"><input type="hidden" name="id" value="@f.Id"><div class="field"><label>@X("Rating 1 to 5", "درجة 1 إلى 5")</label><input type="number" name="score" min="1" max="5" value="3" required></div><div class="field"><label>@X("Feedback", "ملاحظات")</label><textarea name="comment"></textarea></div><button class="btn btn-primary">@X("Submit once", "إرسال نهائي")</button></form>}else{<b>@(f.Score?.ToString()??"-") / 5</b><p>@f.Comment</p><span class="muted">@(f.SubmittedAt!=null?X("Submitted", "تم الإرسال"):X("Cycle no longer open", "الدورة غير مفتوحة"))</span>}</div></div>}
@if(Model.Count==0){<div class="card"><div class="card-b">@T["common.none"]</div></div>}</div>
