@using PeopleHub.Application.Modules.Talent
@model List<ReviewerInboxItem>
@{ ViewData["Title"] = T.IsAr ? "تقييم 360" : "360 feedback"; Func<string,string,string> X=(e,a)=>T.IsAr?a:e; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Invited reviewers submit once. Identity, comments and aggregates each require separate grants. Aggregate publication also requires an explicitly configured minimum and, for the subject, a closed cycle. This is not an anonymity guarantee.", "المقيم المدعو يرسل مرة واحدة. الهوية والتعليقات والمتوسطات تتطلب صلاحيات منفصلة. نشر المتوسط يتطلب حداً أدنى محدداً، ولصاحب التقييم دورة مغلقة أيضاً. هذا ليس ضماناً لإخفاء الهوية.")</div></div></div>
<div class="grid g2">@foreach(var f in Model){<div class="card"><div class="card-h"><h2>@T.Name(f.EmployeeName,f.EmployeeNameAr)</h2><span>@f.CycleName</span></div><div class="card-b">
@if(f.CanSubmit){<form method="post" action="/Perf/SubmitFeedback" asp-antiforgery="true"><input type="hidden" name="id" value="@f.Id"><div class="field"><label>@X("Rating 1 to 5", "درجة 1 إلى 5")</label><input type="number" name="score" min="1" max="5" value="3" required></div><div class="field"><label>@X("Feedback", "ملاحظات")</label><textarea name="comment"></textarea></div><button class="btn btn-primary">@X("Submit once", "إرسال نهائي")</button></form>}else{<b>@(f.Score?.ToString()??"-") / 5</b><p>@f.Comment</p><span class="muted">@(f.SubmittedAt!=null?X("Submitted", "تم الإرسال"):X("Cycle no longer open", "الدورة غير مفتوحة"))</span>}</div></div>}
@if(Model.Count==0){<div class="card"><div class="card-b">@T["common.none"]</div></div>}</div>
