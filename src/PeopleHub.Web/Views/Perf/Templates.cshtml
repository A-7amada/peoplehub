@model List<(CompetencyTemplate T, List<CompetencyItem> Items)>
@{ViewData["Title"]=T.IsAr?"قوالب الكفاءات":"Competency templates";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
<div class="page-head"><h1>@ViewData["Title"]</h1><a class="btn" href="/Perf">@X("Cycles", "الدورات")</a></div>
<div class="grid g2">@foreach(var row in Model){<div class="card"><div class="card-h"><h2>@row.T.Name</h2><span>@row.Items.Sum(i=>i.Weight)%</span></div><div class="card-b">@foreach(var i in row.Items){<p><b>@i.Title (@i.Weight%)</b><br><span class="muted">@i.Behaviour</span></p>}
<form method="post" action="/Perf/AddCompetency" asp-antiforgery="true"><input type="hidden" name="templateId" value="@row.T.Id"><div class="field"><label>@X("Competency", "الكفاءة")</label><input type="text" name="title" required></div><div class="field"><label>@X("Expected behaviour", "السلوك المتوقع")</label><input type="text" name="behaviour"></div><div class="field"><label>@X("Weight", "الوزن")</label><input type="number" name="weight" min="1" max="100" value="25"></div><button class="btn btn-primary">@T["common.add"]</button></form></div></div>}</div>
<div class="card" style="margin-top:18px"><div class="card-b"><form method="post" action="/Perf/AddTemplate" asp-antiforgery="true" class="inline-form"><input type="text" name="name" placeholder="@X("Template name", "اسم القالب")" required><button class="btn btn-primary">@X("New template", "قالب جديد")</button></form></div></div>
