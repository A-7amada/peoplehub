@model List<(CompetencyTemplate T, List<CompetencyItem> Items)>
@{ViewData["Title"]=T.IsAr?"قوالب الكفاءات":"Competency templates";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;}
<div class="page-head"><h1>@ViewData["Title"]</h1><a class="btn" href="/Perf">@X("Cycles", "الدورات")</a></div>
<p class="muted small">@X("A grade limit is optional and chosen by HR. Applying a complete 100% framework copies its behaviours and weights into the appraisal with immutable evidence. Later template additions do not change existing appraisals. The existing 1-5 rating scale is unchanged.","تحدد الموارد البشرية قيد الدرجة الوظيفية اختيارياً. تطبيق إطار مكتمل بوزن ١٠٠٪ ينسخ السلوكيات والأوزان إلى التقييم بدليل غير قابل للتعديل. الإضافات اللاحقة لا تغير التقييمات السابقة. يظل مقياس التقييم الحالي من ١ إلى ٥ كما هو.")</p><div class="grid g2">@foreach(var row in Model){<div class="card"><div class="card-h"><h2>@row.T.Name</h2><span>@row.Items.Sum(i=>i.Weight)% · @X("Grade","الدرجة") @(row.T.JobGrade?.ToString()??X("Unrestricted","بلا قيد"))</span></div><div class="card-b">@foreach(var i in row.Items){<p><b>@i.Title (@i.Weight%)</b><br><span class="muted">@i.Behaviour</span></p>}
<form method="post" action="/Perf/AddCompetency" asp-antiforgery="true"><input type="hidden" name="templateId" value="@row.T.Id"><div class="field"><label>@X("Competency", "الكفاءة")</label><input type="text" name="title" maxlength="200" required></div><div class="field"><label>@X("Expected behaviour", "السلوك المتوقع")</label><input type="text" name="behaviour" required maxlength="2000"></div><div class="field"><label>@X("Weight", "الوزن")</label><input type="number" name="weight" min="1" max="100" value="25"></div><button class="btn btn-primary">@T["common.add"]</button></form></div></div>}</div>
<div class="card" style="margin-top:18px"><div class="card-b"><form method="post" action="/Perf/AddTemplate" asp-antiforgery="true" class="inline-form"><input type="text" name="name" placeholder="@X("Template name", "اسم القالب")" required><label>@X("Optional job grade","الدرجة الوظيفية اختيارية") <input type="number" name="jobGrade" min="0" max="1000" style="width:110px"></label><button class="btn btn-primary">@X("New template", "قالب جديد")</button></form></div></div>
