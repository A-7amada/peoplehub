@model PayrollRun
@{
  var lines = (List<PayrollLine>)ViewBag.Lines; var hist = (List<ApprovalAction>)ViewBag.History; ViewData["Title"] = $"{T["nav.payroll"]} {Model.Year}-{Model.Month:00}";
  bool prep = Me.Can(Perm.PayPrepare); bool hrm = Me.Can(Perm.PayHr);
  bool fin = Me.Can(Perm.PayFinance); bool top = Me.Can(Perm.PayFinalize);
  var order = new[] { PayrollStatus.Draft, PayrollStatus.HRReviewed, PayrollStatus.FinanceApproved, PayrollStatus.Finalized, PayrollStatus.Paid };
  string F(decimal v) => v.ToString("N2");
}
<div class="page-head"><div><h1>@T["nav.payroll"] @Model.Year-@Model.Month.ToString("00")</h1><div class="sub">@Ui.Chip(T.E(Model.Status), Ui.StatusTone(Model.Status)) @if (!string.IsNullOrEmpty(Model.Note)) { <span class="muted"> · @Model.Note</span> }</div></div>
 <div class="actions">
  @if (Model.Status == PayrollStatus.Draft && prep) { <form method="post" action="/Payroll/Recalc" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@Model.Id"><button class="btn">@T["pay.recalc"]</button></form> }
  @if (Model.Status == PayrollStatus.Draft && hrm) { <form method="post" action="/Payroll/Review" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-primary">@T["pay.review"]</button></form> }
  @if (Model.Status == PayrollStatus.HRReviewed && fin) { <form method="post" action="/Payroll/FinanceApprove" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-primary">@T["pay.financeApprove"]</button></form> }
  @if (Model.Status == PayrollStatus.FinanceApproved && top) { <form method="post" action="/Payroll/Finalize" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-primary">@T["pay.finalize"]</button></form> }
  @if (Model.Status == PayrollStatus.Finalized && prep) { <form method="post" action="/Payroll/Paid" asp-antiforgery="true" style="margin:0"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-good">@T["pay.markPaid"]</button></form> }
  @if (Model.IsLocked && Me.Can(Perm.PayExport)) { <a class="btn" href="/Payroll/BankFile/@Model.Id">@Ui.Icon("download", 16) @T["pay.bankFile"]</a> }</div></div>
<div class="card" style="margin-bottom:18px"><div class="card-b" style="display:flex;gap:28px;flex-wrap:wrap;align-items:center"><div class="steps">@foreach (var o in order) { <span class="step @(o <= Model.Status ? "done" : o == Model.Status + 1 ? "cur" : "")">@T.E(o)</span> }</div>
 <div style="margin-inline-start:auto;display:flex;gap:28px"><div><div class="faint small">@T["pay.gross"]</div><b class="num">@T.Money(lines.Sum(l => l.Gross))</b></div><div><div class="faint small">@T["pay.deductions"]</div><b class="num">@T.Money(lines.Sum(l => l.TotalDeductions))</b></div><div><div class="faint small">@T["pay.net"]</div><b class="num" style="color:var(--brand)">@T.Money(lines.Sum(l => l.Net))</b></div></div></div></div>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th class="right">@T["pay.basic"]</th><th class="right">@T["pay.allowances"]</th><th class="right">@T["pay.overtime"]</th><th class="right">@T["pay.bonus"]</th><th class="right">@T["pay.gross"]</th><th class="right">@T["pay.attDed"]</th><th class="right">@T["pay.insurance"]</th><th class="right">@T["pay.tax"]</th><th class="right">@T["pay.advance"]</th><th class="right">@T["pay.other"]</th><th class="right">@T["pay.net"]</th><th></th></tr></thead><tbody>
@foreach (var l in lines) { <tr><td><a class="person" href="/Employees/Profile/@l.EmployeeId?tab=pay">@Ui.Avatar(l.Employee, T)<span><div class="nm">@T.Name(l.Employee!.FullName, l.Employee.FullNameAr)</div><div class="sb">@l.Employee.Code @(l.AbsentDays > 0 ? $"· {l.AbsentDays} {T["att.absent"]}" : "") @(l.LateMinutes > 0 ? $"· {l.LateMinutes} {T["att.min"]}" : "")</div></span></a></td>
 <td class="right num">@F(l.Basic)</td><td class="right num">@F(l.Allowances)</td><td class="right num">@F(l.Overtime)</td><td class="right num">@F(l.Bonus)</td><td class="right num"><b>@F(l.Gross)</b></td><td class="right num">@F(l.LateDeduction + l.AbsenceDeduction)</td><td class="right num">@F(l.Insurance)</td><td class="right num">@F(l.Tax)</td><td class="right num">@F(l.AdvanceInstallment)</td><td class="right num">@F(l.OtherDeduction)</td><td class="right num"><b style="color:var(--brand)">@F(l.Net)</b></td>
 <td class="right nowrap">@if (Me.Can(Perm.PaySlips) || (Me.EmployeeId == l.EmployeeId && Model.IsLocked)) { <a class="btn btn-sm" href="/Payroll/Slip/@l.Id">@T["pay.slip"]</a> }
  @if (Model.Status == PayrollStatus.Draft && prep) { <details class="more" style="display:inline-block"><summary>@T["att.edit"]</summary><form method="post" action="/Payroll/Adjust" asp-antiforgery="true" class="inline-form" style="position:absolute;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px;box-shadow:var(--shadow);z-index:3"><input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="lineId" value="@l.Id"><input type="number" step="0.01" name="bonus" value="@l.Bonus" style="width:90px" title="@T["pay.bonus"]"><input type="number" step="0.01" name="other" value="@(l.OtherDeduction - 150 < 0 ? 0 : l.OtherDeduction - 150)" style="width:90px" title="@T["pay.other"]"><input type="text" name="note" placeholder="@T["common.reason"]" required style="width:130px"><button class="btn btn-sm btn-primary">@T["common.save"]</button></form></details> }</td></tr>
 @if (!string.IsNullOrEmpty(l.AdjustmentNote)) { <tr><td colspan="13" class="faint small" style="padding-top:0">@T["pay.note"]: @l.AdjustmentNote</td></tr> } }
</tbody></table></div></div>
<div class="grid g2" style="margin-top:18px">
 <div class="card"><div class="card-h"><h2>@T["pay.history"]</h2></div><div class="card-b"><ul class="timeline">@foreach (var h in hist) { <li><b>@T.E(h.Action)</b> <span class="faint small">· @h.At.ToString("yyyy-MM-dd HH:mm")</span><div class="muted small">@h.Actor @h.Comment</div></li> }</ul></div></div>
 <div class="card"><div class="card-h"><h2>@T["pay.controls"]</h2></div><div class="card-b">
  @if ((Model.Status == PayrollStatus.HRReviewed || Model.Status == PayrollStatus.FinanceApproved) && (hrm || fin)) { <form method="post" action="/Payroll/SendBack" asp-antiforgery="true" class="inline-form" style="margin-bottom:12px"><input type="hidden" name="id" value="@Model.Id"><input type="text" name="reason" placeholder="@T["common.reason"]" required style="flex:1"><button class="btn btn-bad">@T["pay.sendBack"]</button></form> }
  @if (Model.Status == PayrollStatus.Finalized && Me.Can(Perm.PayReopen)) { <form method="post" action="/Payroll/Reopen" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@Model.Id"><input type="text" name="reason" placeholder="@T["common.reason"]" required style="flex:1"><button class="btn btn-bad">@T["pay.reopen"]</button></form> }
  <p class="muted small">@T["pay.rulesNote"]</p></div></div></div>
