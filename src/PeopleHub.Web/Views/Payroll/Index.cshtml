@using PeopleHub.Application.Modules.Payroll
@model List<PayrollRun>
@{ ViewData["Title"] = T["nav.payroll"]; DateTime now = ViewBag.Now; bool prep = Me.Can(Perm.PayPrepare); }
<div class="page-head">@if(Me.Can(Perm.EmpPay)&&Me.Can(Perm.EmpSalary)){<a class="btn" href="/SalaryStructures">@(T.IsAr?"هياكل الرواتب":"Salary structures")</a>}<div><h1>@T["nav.payroll"]</h1><div class="sub">@T["pay.sub"]</div></div><div class="actions"><a class="btn" href="/Payroll/MySlips">@Ui.Icon("file", 16) @T["pay.mySlips"]</a></div></div>
<div class="grid g-main">
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["pay.period"]</th><th>@T["common.status"]</th><th>@T["pay.workflow"]</th><th></th></tr></thead><tbody>
@foreach (var r in Model) { var order = new[] { PayrollStatus.Draft, PayrollStatus.HRReviewed, PayrollStatus.FinanceApproved, PayrollStatus.Finalized, PayrollStatus.Paid };
 <tr><td><b>@r.Year-@r.Month.ToString("00")</b><div class="faint small">@r.CreatedBy</div></td><td>@Ui.Chip(T.E(r.Status), Ui.StatusTone(r.Status))</td>
 <td><div class="steps">@foreach (var o in order) { <span class="step @(o <= r.Status ? "done" : o == r.Status + 1 ? "cur" : "")">@T.E(o)</span> }</div></td>
 <td class="right"><a class="btn btn-sm" href="/Payroll/Run/@r.Id">@T["common.open"] @Ui.Icon("arrow", 14)</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="4" class="empty">@T["common.none"]</td></tr> }</tbody></table></div></div>
@if (prep) { <div class="card" style="align-self:start"><div class="card-h"><h2>@T["pay.newRun"]</h2></div><div class="card-b"><form method="post" action="/Payroll/Create" asp-antiforgery="true">
 <div class="form-grid"><div class="field"><label>@T["adv.startYear"]</label><input type="number" name="year" value="@now.Year"></div><div class="field"><label>@T["adv.startMonth"]</label><input type="number" name="month" min="1" max="12" value="@now.Month"></div></div>
 <button class="btn btn-primary">@T["pay.create"]</button><p class="muted small">@T["pay.createHint"]</p></form></div></div> }
</div>
@if (Me.Can(Perm.AdmSettings)) { bool strict = ViewBag.Distinct == true; <div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"الفصل بين المعتمدين":"Separation of approvers")</h2></div><div class="card-b"><form method="post" action="/Payroll/DistinctApprovers" asp-antiforgery="true">
 <p class="muted small">@(T.IsAr?"الحالة: ":"Status: ")<b>@(strict ? (T.IsAr?"مفعل":"On") : (T.IsAr?"متوقف":"Off"))</b>. @(T.IsAr?"عند التفعيل يجب أن يكون مراجع الموارد البشرية ومعتمد المالية ومنفذ الإقفال أشخاصا مختلفين. معد الدورة ممنوع من الاعتماد دائما. الافتراضي متوقف، قابل للتغيير، توضيحي وغير مراجع من مختص.":"When on, the HR reviewer, the Finance approver and the finalizer must be three different people. The preparer is always kept apart from approval. Default is off, you can change it, illustrative and not reviewed by a specialist.")</p>
 <input type="hidden" name="on" value="@(strict ? "false" : "true")"><button class="btn btn-sm">@(strict ? (T.IsAr?"إيقاف":"Turn off") : (T.IsAr?"تفعيل":"Turn on"))</button></form></div></div> }
@if (Me.Can(Perm.AdmSettings)) { bool pr = ViewBag.Prorate == true; <div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"احتساب شهر الالتحاق":"Joining-month proration")</h2></div><div class="card-b"><form method="post" action="/Payroll/ProrateJoining" asp-antiforgery="true">
 <p class="muted small">@(T.IsAr?"الحالة: ":"Status: ")<b>@(pr ? (T.IsAr?"مفعل":"On") : (T.IsAr?"متوقف":"Off"))</b>. @(T.IsAr?"عند التفعيل يُحتسب الأساسي والبدلات الثابتة لموظف التحق خلال الشهر بعدد الأيام التقويمية من تاريخ الالتحاق حتى نهاية الشهر على 30. لا يشمل شهر الخروج. يطبق على الدورات التي تبنى أو يعاد حسابها بعد التغيير. الافتراضي متوقف، توضيحي وغير مراجع من مختص مرتبات.":"When on, basic pay and fixed allowances of someone hired during the month are paid for the calendar days from the hire date to month end, over 30. The leaving month is not covered. It applies to runs built or recalculated after the change. Default is off, illustrative and not reviewed by a payroll specialist.")</p>
 <input type="hidden" name="on" value="@(pr ? "false" : "true")"><button class="btn btn-sm">@(pr ? (T.IsAr?"إيقاف":"Turn off") : (T.IsAr?"تفعيل":"Turn on"))</button></form></div></div> }
