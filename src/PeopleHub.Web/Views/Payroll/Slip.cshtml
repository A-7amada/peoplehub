@model PayrollLine
@{ var run = (PayrollRun)ViewBag.Run; ViewData["Title"] = T["pay.slip"]; var e = Model.Employee!; string F(decimal v) => v.ToString("N2"); }
<div class="page-head no-print"><div><h1>@T["pay.slip"] @run.Year-@run.Month.ToString("00")</h1></div><div class="actions"><button class="btn" onclick="window.print()">@Ui.Icon("print", 16) @T["pay.print"]</button></div></div>
<div class="slip"><div class="slip-h"><div><div style="font-size:1.3rem;font-weight:700">PeopleHub Demo Co.</div><div style="opacity:.8">@T["pay.slip"] · @run.Year-@run.Month.ToString("00")</div></div>
 <div style="text-align:end"><div style="font-weight:700">@T.Name(e.FullName, e.FullNameAr)</div><div style="opacity:.8">@e.Code · @T.Name(e.Department!.Name, e.Department.NameAr)</div></div></div>
<div class="slip-b"><div><h3 style="margin-bottom:8px">@T["pay.earnings"]</h3><table><tr><td>@T["pay.basic"]</td><td class="num">@F(Model.Basic)</td></tr><tr><td>@T["pay.allowances"]</td><td class="num">@F(Model.Allowances)</td></tr><tr><td>@T["pay.overtime"] (@Model.OvertimeHours.ToString("0.#")h)</td><td class="num">@F(Model.Overtime)</td></tr><tr><td>@T["pay.bonus"]</td><td class="num">@F(Model.Bonus)</td></tr><tr><td><b>@T["pay.gross"]</b></td><td class="num"><b>@F(Model.Gross)</b></td></tr></table></div>
<div><h3 style="margin-bottom:8px">@T["pay.deductionsTitle"]</h3><table><tr><td>@T["pay.late"] (@Model.LateMinutes @T["att.min"])</td><td class="num">@F(Model.LateDeduction)</td></tr><tr><td>@T["pay.absence"] (@Model.AbsentDays)</td><td class="num">@F(Model.AbsenceDeduction)</td></tr><tr><td>@T["pay.insurance"]</td><td class="num">@F(Model.Insurance)</td></tr><tr><td>@T["pay.tax"]</td><td class="num">@F(Model.Tax)</td></tr><tr><td>@T["pay.advance"]</td><td class="num">@F(Model.AdvanceInstallment)</td></tr><tr><td>@T["pay.other"]</td><td class="num">@F(Model.OtherDeduction)</td></tr><tr><td><b>@T["pay.deductions"]</b></td><td class="num"><b>@F(Model.TotalDeductions)</b></td></tr></table></div></div>
<div class="slip-net"><span>@T["pay.net"]</span><span class="num">EGP @F(Model.Net)</span></div><div class="watermark">@T["pay.watermark"]</div></div>
