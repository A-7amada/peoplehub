@model CostCentreJournal
@{ViewData["Title"]=T.IsAr?"ملخص مراكز التكلفة":"Cost-centre summary";}
<div class="page-head"><h1>@ViewData["Title"] @Model.Year-@Model.Month.ToString("00")</h1><div class="actions"><a class="btn" href="/Payroll/Run/@Model.RunId">@T["nav.payroll"]</a>@if(Me.Can(Perm.PayExport)){<a class="btn" href="/PayrollJournals/Csv?id=@Model.RunId">CSV</a>}</div></div>
<div class="flash">@(T.IsAr?"ملخص داخلي تخطيطي بالجنيه المصري من بنود الدورة المقفلة، وليس قيداً محاسبياً مرحلاً أو تنفيذاً مالياً. لا يفترض أرقام حسابات أو يعيد توزيعاً تاريخياً لم يعرفه النظام. المبلغ الإجمالي = استقطاعات المقاصة + صافي مستحقات المرتبات. لا تشمل الأرقام تكلفة تأمين جهة العمل أو غيرها من التكاليف غير المحسوبة. السجلات بلا مركز محفوظ تبقى غير موزعة، ولا نستخدم مركز الموظف الحالي لملء التاريخ.":"Internal EGP planning summary from locked payroll lines, not a posted accounting journal or financial instruction. No account numbers or unknown historical allocations are invented. Gross expense = deductions clearing + net payroll payable. Employer insurance and other uncalculated costs are excluded. Lines without a captured cost centre stay unallocated; current employee details do not fill historical gaps.")</div>
<div class="card"><div class="card-h"><h2>@(T.IsAr?"دورة":"Run") #@Model.RunId · @(T.IsAr?"إصدار الحساب":"Calculation version") @Model.Version</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@(T.IsAr?"مركز التكلفة":"Cost centre")</th><th>@(T.IsAr?"عدد الموظفين":"Employees")</th><th>@(T.IsAr?"مصروف إجمالي":"Gross expense")</th><th>@(T.IsAr?"مقاصة الاستقطاعات":"Deductions clearing")</th><th>@(T.IsAr?"صافي مستحق":"Net payable")</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@(r.CostCenter=="[Unallocated / legacy]"&&T.IsAr?"غير موزع / قديم":r.CostCenter)</td><td>@r.EmployeeCount</td><td class="num">@r.Gross.ToString("N2")</td><td class="num">@r.Deductions.ToString("N2")</td><td class="num">@r.Net.ToString("N2")</td></tr>}<tr><th>@(T.IsAr?"الإجمالي EGP":"Total EGP")</th><th>@Model.Rows.Sum(x=>x.EmployeeCount)</th><th class="num">@Model.Rows.Sum(x=>x.Gross).ToString("N2")</th><th class="num">@Model.Rows.Sum(x=>x.Deductions).ToString("N2")</th><th class="num">@Model.Rows.Sum(x=>x.Net).ToString("N2")</th></tr></tbody></table></div></div>
