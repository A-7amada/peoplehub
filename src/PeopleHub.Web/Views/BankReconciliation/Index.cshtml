@using PeopleHub.Application.Modules.Payroll
@model List<PayrollBankResult>
@{var run=(PayrollRun)ViewBag.Run;var lines=(List<PayrollLine>)ViewBag.Lines;ViewData["Title"]=T.IsAr?"مطابقة البنك":"Bank reconciliation";string Identity(PayrollLine l)=>string.IsNullOrWhiteSpace(l.EmployeeCodeSnapshot)?(T.IsAr?"بند قديم، معرف الموظف #":"Legacy line, employee #")+l.EmployeeId:l.EmployeeCodeSnapshot+" "+T.Name(l.EmployeeNameSnapshot,l.EmployeeNameArSnapshot);string Outcome(string s)=>T.IsAr?(s=="Paid"?"سداد مسجل":s=="Returned"?"مرتجع":"مرفوض"):s;}
<div class="page-head"><h1>@ViewData["Title"] @run.Year-@run.Month.ToString("00")</h1><a class="btn" href="/Payroll/Run/@run.Id">@T["nav.payroll"]</a></div>
<div class="flash">@(T.IsAr?"أدلة يدوية من نتيجة البنك. لا ينفذ النظام تحويلاً ولا يؤكد صحة مرجع البنك ولا يغير حالة دورة المرتبات أو رصيد السلفة. القيم بالجنيه المصري من صافي الدورة المقفلة. المدفوع والمرتجع بقيمة الصافي كاملة، والمرفوض بصفر. المدفوع لا يتغير إلا بمرتجع موثق، ثم يمكن تسجيل محاولة جديدة. التسويات الجزئية والاستيراد الآلي غير مدعومين.":"Manual bank-result evidence only. This does not transfer money, verify a bank reference, change payroll status or change advance balances. EGP amounts come from the locked run's net pay. Paid and returned amounts must equal full net pay; rejected is zero. A recorded payment requires a documented return before another attempt. Partial settlements and automatic imports are not supported.")</div>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th>@T["pay.net"]</th><th>@(T.IsAr?"آخر نتيجة مسجلة":"Latest recorded result")</th></tr></thead><tbody>@foreach(var l in lines){var last=Model.LastOrDefault(x=>x.LineId==l.Id);<tr><td>@Identity(l)</td><td class="num">@l.Net.ToString("N2") EGP</td><td>@(last==null?(T.IsAr?"لم تسجل":"Not recorded"):Outcome(last.Outcome))</td></tr>}</tbody></table></div></div>
@if(run.IsLocked){<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"إضافة نتيجة موثقة":"Record documented result")</h2></div><div class="card-b"><form method="post" action="/BankReconciliation/Record" asp-antiforgery="true" class="form-grid"><input type="hidden" name="runId" value="@run.Id"><div class="field"><label>@T["req.employee"]</label><select name="lineId">@foreach(var l in lines.Where(x=>x.Net>0)){<option value="@l.Id">@Identity(l) · @l.Net.ToString("N2") EGP</option>}</select></div><div class="field"><label>@T["common.type"]</label><select name="outcome"><option value="Paid">@Outcome("Paid")</option><option value="Rejected">@Outcome("Rejected")</option><option value="Returned">@Outcome("Returned")</option></select></div><div class="field"><label>@(T.IsAr?"المبلغ (EGP)":"Amount (EGP)")</label><input type="number" min="0" step="0.01" name="amount" required></div><div class="field"><label>@(T.IsAr?"مرجع نتيجة البنك":"Bank-result reference")</label><input name="reference" maxlength="200" required></div><div class="field full"><label>@(T.IsAr?"دليل النتيجة وسبب التسجيل":"Result evidence and reason")</label><textarea name="note" maxlength="2000" required></textarea></div><div><button class="btn btn-primary">@T["common.save"]</button></div></form></div></div>}
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"السجل غير القابل للتعديل":"Append-only evidence history")</h2></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["req.employee"]</th><th>@(T.IsAr?"الإصدار":"Version")</th><th>@T["common.type"]</th><th>EGP</th><th>@(T.IsAr?"المرجع والدليل":"Reference and evidence")</th><th>UTC</th></tr></thead><tbody>@foreach(var r in Model.OrderByDescending(x=>x.Id)){<tr><td>@Identity(lines.Single(x=>x.Id==r.LineId))</td><td>@r.Version</td><td>@Outcome(r.Outcome)</td><td class="num">@r.Amount.ToString("N2")</td><td>@r.Reference<div class="muted">@r.Note</div><div class="small">@r.Actor</div></td><td>@r.At.ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div></div>
