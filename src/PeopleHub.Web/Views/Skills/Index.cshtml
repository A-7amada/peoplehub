@using PeopleHub.Application.Modules.Talent
@{ViewData["Title"]=T.IsAr?"المهارات والكفاءات":"Skills and competencies";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;bool mgr=Me.Can(Perm.TalentManage);
var skills=(List<Skill>)ViewBag.Skills;var mine=(List<SkillView>)ViewBag.Mine;var pending=(List<EmployeeSkill>)ViewBag.Pending;var depts=(List<Department>)ViewBag.Depts;var reqs=(List<SkillRequirement>)ViewBag.Reqs;var gaps=(List<SkillGap>?)ViewBag.Gaps;
Func<Skill?,string>N=s=>s==null?"":(T.IsAr&&!string.IsNullOrEmpty(s.NameAr)?s.NameAr:s.Name);}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("Skills inventory and coverage view","جرد المهارات وعرض التغطية")</p></div></div>
<p class="muted small">@X("Information only. Skill gaps show missing capabilities for planning; they never trigger an automated employment decision. Levels run from 1 to 5 (illustrative scale). Assessment-sourced levels and notes are visible only to talent managers.","للمعلومات فقط. تُظهر فجوات المهارات القدرات الناقصة للتخطيط ولا تؤدي إلى أي قرار توظيف آلي. المستويات من 1 إلى 5 (مقياس توضيحي). مستويات وملاحظات التقييم يراها مديرو المواهب فقط.")</p>
<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("My skills","مهاراتي")</h2></div><div class="card-b">
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Skill","المهارة")</th><th>@X("Level","المستوى")</th><th>@X("Source","المصدر")</th><th>@X("Status","الحالة")</th></tr></thead><tbody>
@foreach(var v in mine){<tr><td>@N(v.Row.Skill)</td><td>@(v.Restricted?"-":v.Row.Level.ToString())</td><td>@v.Row.Source</td><td>@(v.Row.Confirmed?X("Confirmed","معتمدة"):X("Awaiting approval","بانتظار الاعتماد"))</td></tr>}
@if(mine.Count==0){<tr><td colspan="4">@X("No skills recorded yet.","لا توجد مهارات مسجلة بعد.")</td></tr>}
</tbody></table></div>
<form method="post" action="/Skills/Record" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="source" value="Profile">
<div class="field"><label>@X("Skill","المهارة")</label><select class="input" name="skillId">@foreach(var s in skills.Where(x=>x.Active)){<option value="@s.Id">@N(s)</option>}</select></div>
<div class="field"><label>@X("Level (1-5)","المستوى (1-5)")</label><input class="input" type="number" name="level" min="1" max="5" value="3" required></div>
<div class="field"><label>@X("Note","ملاحظة")</label><input class="input" name="evidence" maxlength="1000"></div>
<div class="field"><label>&nbsp;</label><button class="btn">@X("Add to my profile","إضافة إلى ملفي")</button></div></form>
<p class="muted small">@X("A skill you add stays unconfirmed until your manager or a talent manager approves it.","تبقى المهارة غير معتمدة حتى يعتمدها مديرك أو مدير المواهب.")</p></div></div>
@if(pending.Count>0){<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("Skills awaiting approval","مهارات بانتظار الاعتماد")</h2></div><div class="card-b"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Employee","الموظف")</th><th>@X("Skill","المهارة")</th><th>@X("Level","المستوى")</th><th>@X("Source","المصدر")</th><th></th></tr></thead><tbody>
@foreach(var p in pending){<tr><td>#@p.EmployeeId</td><td>@N(p.Skill)</td><td>@(p.Source=="Assessment"&&!mgr?"-":p.Level.ToString())</td><td>@p.Source</td><td><form method="post" action="/Skills/Confirm" asp-antiforgery="true"><input type="hidden" name="id" value="@p.Id"><button class="btn">@X("Approve","اعتماد")</button></form></td></tr>}
</tbody></table></div></div></div>}
<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("Team skill coverage and gaps","تغطية المهارات والفجوات للفريق")</h2></div><div class="card-b">
@if(gaps==null){<p class="muted">@X("Team coverage is available to managers and HR.","عرض تغطية الفريق متاح للمديرين والموارد البشرية.")</p>}else{
<p class="muted small">@X("Counts confirmed skills for the employees you are allowed to see.","يحسب المهارات المعتمدة للموظفين المسموح لك برؤيتهم.")</p>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Department","الإدارة")</th><th>@X("Skill","المهارة")</th><th>@X("Required","المطلوب")</th><th>@X("Have","المتوفر")</th><th>@X("Missing","الناقص")</th></tr></thead><tbody>
@foreach(var g in gaps){<tr><td>@g.Department</td><td>@N(g.Requirement.Skill)</td><td>@g.Requirement.MinPeople @X("at level","بمستوى") @g.Requirement.MinLevel+</td><td>@g.Have</td><td>@(g.Missing>0?Ui.Chip(g.Missing.ToString(),"amber"):Ui.Chip("0","green"))</td></tr>}
@if(gaps.Count==0){<tr><td colspan="5">@X("No requirements defined for your scope.","لا توجد متطلبات ضمن نطاقك.")</td></tr>}
</tbody></table></div>}</div></div>
@if(mgr){<div class="card"><div class="card-h"><h2>@X("Taxonomy and requirements","التصنيف والمتطلبات")</h2></div><div class="card-b">
<form method="post" action="/Skills/AddSkill" asp-antiforgery="true" class="form-grid"><div class="field"><label>@X("Skill name","اسم المهارة")</label><input class="input" name="name" required maxlength="100"></div><div class="field"><label>@X("Arabic name","الاسم بالعربية")</label><input class="input" name="nameAr" maxlength="100"></div><div class="field"><label>@X("Category","الفئة")</label><input class="input" name="category" required maxlength="100"></div><div class="field"><label>&nbsp;</label><button class="btn">@X("Add skill","إضافة مهارة")</button></div></form>
<div class="tbl-wrap" style="margin-top:12px"><table class="tbl"><thead><tr><th>@X("Skill","المهارة")</th><th>@X("Category","الفئة")</th><th>@X("Active","نشطة")</th><th></th></tr></thead><tbody>
@foreach(var s in skills){<tr><td>@N(s)</td><td>@s.Category</td><td>@(s.Active?"yes":"no")</td><td><form method="post" action="/Skills/Retire" asp-antiforgery="true"><input type="hidden" name="id" value="@s.Id"><input type="hidden" name="active" value="@((!s.Active).ToString().ToLower())"><button class="btn">@(s.Active?X("Retire","إيقاف"):X("Reactivate","تفعيل"))</button></form></td></tr>}
</tbody></table></div>
<h3 style="margin-top:18px">@X("Department requirement","متطلب إدارة")</h3>
<form method="post" action="/Skills/Require" asp-antiforgery="true" class="form-grid"><div class="field"><label>@X("Skill","المهارة")</label><select class="input" name="skillId">@foreach(var s in skills.Where(x=>x.Active)){<option value="@s.Id">@N(s)</option>}</select></div><div class="field"><label>@X("Department","الإدارة")</label><select class="input" name="departmentId">@foreach(var d in depts){<option value="@d.Id">@d.Name</option>}</select></div><div class="field"><label>@X("Minimum level","الحد الأدنى للمستوى")</label><input class="input" type="number" name="minLevel" min="1" max="5" value="3"></div><div class="field"><label>@X("Minimum people","أقل عدد أشخاص")</label><input class="input" type="number" name="minPeople" min="1" max="1000" value="1"></div><div class="field"><label>&nbsp;</label><button class="btn">@X("Save requirement","حفظ المتطلب")</button></div></form>
@foreach(var r in reqs){<form method="post" action="/Skills/Unrequire" asp-antiforgery="true" class="inline-form" style="margin-top:6px"><input type="hidden" name="id" value="@r.Id"><span>@N(skills.FirstOrDefault(s=>s.Id==r.SkillId)) / @(depts.FirstOrDefault(d=>d.Id==r.DepartmentId)?.Name): @r.MinPeople @X("at level","بمستوى") @r.MinLevel+</span> <button class="btn">@X("Remove","حذف")</button></form>}
<h3 style="margin-top:18px">@X("Record assessment or training skill","تسجيل مهارة من تقييم أو تدريب")</h3>
<form method="post" action="/Skills/Record" asp-antiforgery="true" class="form-grid"><div class="field"><label>@X("Employee ID","رقم الموظف")</label><input class="input" type="number" name="employeeId" min="1" required></div><div class="field"><label>@X("Skill","المهارة")</label><select class="input" name="skillId">@foreach(var s in skills.Where(x=>x.Active)){<option value="@s.Id">@N(s)</option>}</select></div><div class="field"><label>@X("Level (1-5)","المستوى (1-5)")</label><input class="input" type="number" name="level" min="1" max="5" value="3" required></div><div class="field"><label>@X("Source","المصدر")</label><select class="input" name="source"><option>Assessment</option><option>Training</option></select></div><div class="field"><label>@X("Evidence note","ملاحظة الدليل")</label><input class="input" name="evidence" maxlength="1000"></div><div class="field"><label>&nbsp;</label><button class="btn">@X("Record","تسجيل")</button></div></form>
</div></div>}
