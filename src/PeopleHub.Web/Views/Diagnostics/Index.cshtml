@using PeopleHub.Application.Modules.Operations
@model List<RouteMetric>
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;ViewData["Title"]=X("Service diagnostics","تشخيص الخدمة");}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("In-memory observations since this process started. Resets on deploy or restart, not an uptime guarantee. Static files are excluded. Counts contain no employee IDs, paths, query strings or message contents.","قياسات في الذاكرة منذ بدء العملية وتصفّر مع إعادة التشغيل أو النشر، وليست ضمانا للاستمرارية. لا تشمل الملفات الثابتة أو أرقام الموظفين أو المسارات أو معاملات البحث أو محتوى الرسائل.")</p></div></div>
<div class="card" style="margin-bottom:18px"><div class="card-b"><a href="/health/live">@X("Liveness check","فحص تشغيل الخدمة")</a> · <a href="/health/ready">@X("Database readiness check","فحص جاهزية قاعدة البيانات")</a><p class="muted small">@X("Readiness checks database connectivity with a 3-second timeout. It does not certify background jobs, backups, mail delivery or external services. HTTP 5xx counts as an error; 4xx remains a client response. X-Correlation-ID matches the request trace in hosting logs.","يفحص الاتصال بقاعدة البيانات بمهلة 3 ثوان. لا يؤكد المهام الخلفية أو النسخ الاحتياطية أو وصول البريد أو الخدمات الخارجية. أخطاء 5xx فقط تحسب كأخطاء خدمة. معرّف X-Correlation-ID يطابق الطلب في سجلات الاستضافة.")</p></div></div>
@{var ops=(OperationsSnapshot)ViewBag.Ops;}
<div class="card" style="margin-bottom:18px"><div class="card-b"><h3 style="margin-top:0">@X("Operations summary","ملخص التشغيل")</h3><p class="muted small">@X("Counts computed from the database when this page opens. No names, employee IDs or request contents.","أعداد تحسب من قاعدة البيانات عند فتح الصفحة. دون أسماء أو أرقام موظفين أو محتوى الطلبات.")</p></div>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Pending approvals","اعتمادات معلقة")</th><th>@X("Pending","معلق")</th><th>@X("Oldest (days)","الأقدم (أيام)")</th></tr></thead><tbody>@foreach(var k in ops.Approvals){<tr><td>@(k.Kind switch{"Leave"=>X("Leave","إجازات"),"Overtime"=>X("Overtime","عمل إضافي"),"Correction"=>X("Attendance corrections","تصحيحات الحضور"),_=>X("Advances","سلف")})</td><td>@k.Pending</td><td>@k.OldestAgeDays</td></tr>}</tbody></table></div>
<div class="card-b"><b>@X("Integration outbox","صندوق الأحداث الصادرة")</b>: @X("pending","معلق") @ops.Outbox.Pending · @X("done","منجز") @ops.Outbox.Done · @X("dead-lettered","متعثر") @ops.Outbox.DeadLetter · @X("unread notifications","إشعارات غير مقروءة") @ops.UnreadNotifications</div></div>
@{var fe=PeopleHub.Infrastructure.Security.FieldEncryptionBackfill.Last;}
<div class="card" style="margin-bottom:18px"><div class="card-b"><b>@X("Sensitive-field encryption","تشفير الحقول الحساسة")</b>: @(fe.Enabled?X("on","مفعّل"):X("off (no key configured)","متوقف (لا يوجد مفتاح)")) · @X("plaintext values left at last start","قيم غير مشفرة عند آخر تشغيل") @fe.Remaining · @X("encrypted at last start","شُفّرت عند آخر تشغيل") @fe.Encrypted@(fe.KeyId==null?"":" · "+X("key id","معرّف المفتاح")+" "+fe.KeyId)<p class="muted small" style="margin:6px 0 0">@X("Counts only, no values. Covers TOTP seeds, national IDs, IBANs and payroll IBAN snapshots.","أعداد فقط دون قيم. تشمل بذور التحقق الثنائي والأرقام القومية وأرقام الآيبان ولقطات الآيبان في الرواتب.")</p></div></div>
@{var jobs=(List<JobStatus>)ViewBag.Jobs;var files=(StoredFiles)ViewBag.Files;}
<div class="card" style="margin-bottom:18px"><div class="card-b"><h3 style="margin-top:0">@X("Background jobs","المهام الخلفية")</h3><p class="muted small">@X("Run records are stored in the database and survive restarts. Jobs run inside the web process, so nothing runs while the free host is asleep. A run that died is released after its 10-minute lease and runs again at the next wake. Error shows the exception type only.","سجلات التشغيل محفوظة في قاعدة البيانات وتبقى بعد إعادة التشغيل. تعمل المهام داخل عملية الويب، فلا يعمل شيء أثناء نوم الاستضافة المجانية. المهمة التي توقفت تُحرر بعد مهلة 10 دقائق وتعمل مجددا عند الاستيقاظ التالي. يعرض الخطأ نوع الاستثناء فقط.")</p>
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Job","المهمة")</th><th>@X("Last status","آخر حالة")</th><th>@X("Last finished (UTC)","آخر انتهاء (UTC)")</th><th>@X("Runs","مرات التشغيل")</th><th>@X("Failures in a row","إخفاقات متتالية")</th><th>@X("Error type","نوع الخطأ")</th></tr></thead><tbody>@if(jobs.Count==0){<tr><td colspan="6" class="muted">@X("No run recorded yet. Jobs record their first run within 15 minutes of the app starting.","لا يوجد تشغيل مسجل بعد. تسجل المهام أول تشغيل خلال 15 دقيقة من بدء التطبيق.")</td></tr>}@foreach(var j in jobs){<tr><td><span dir="ltr">@j.Name</span></td><td>@j.LastStatus</td><td><time dir="ltr">@j.LastFinishedAt?.ToString("yyyy-MM-dd HH:mm")</time></td><td>@j.RunCount</td><td>@j.ConsecutiveFailures</td><td><span dir="ltr">@j.LastError</span></td></tr>}</tbody></table></div></div>
<div class="card-b"><b>@X("Stored files","الملفات المخزنة")</b>: @files.Count @X("files","ملفات") · @((files.Bytes/1024.0/1024.0).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)) MB @X("in the database. The free database has a size cap, so watch this number.","في قاعدة البيانات. قاعدة البيانات المجانية لها حد للحجم، فراقب هذا الرقم.")</div></div>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("Action (no private path)","الإجراء دون مسار خاص")</th><th>@X("Requests","الطلبات")</th><th>5xx</th><th>@X("In flight","قيد التنفيذ")</th><th>@X("Mean ms","المتوسط مللي ثانية")</th><th>@X("Max ms","الأقصى مللي ثانية")</th></tr></thead><tbody>@foreach(var r in Model){<tr><td dir="ltr">@r.Route</td><td>@r.Requests</td><td>@r.Errors</td><td>@r.InFlight</td><td>@r.MeanMilliseconds</td><td>@r.MaxMilliseconds</td></tr>}</tbody></table></div></div>
