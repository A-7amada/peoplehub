@model List<WorkflowDefinition>
@{ ViewData["Title"] = T["nav.workflows"]; var roles = (List<Role>)ViewBag.Roles; }
<div class="page-head"><div><h1>@T["nav.workflows"]</h1><div class="sub">@T["wf.sub"]</div></div></div>
<div class="grid g2">
@foreach (var w in Model) {
<div class="card"><div class="card-h"><h2>@T["req.kind." + w.Kind]</h2><span class="faint small">@T["wf.desc." + w.Kind]</span></div><div class="card-b">
 <ol class="wf">
 @for (var i = 0; i < w.Steps.Count; i++) { var s = w.Steps[i];
  <li><span class="num">@(i + 1)</span><div class="grow"><b>@T.Stage(s.Token)</b>
    <div class="faint small">@(s.Approver == ApproverType.DirectManager ? T["wf.managerHint"] : T["wf.roleHint"])@if (s.Threshold != null) { <span> · @T["wf.when"] @s.Threshold @T["wf.unit." + w.Kind]</span> }</div></div>
   <form method="post" action="/Admin/MoveStep" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@s.Id">
    <button class="btn btn-sm" name="dir" value="-1" title="up" disabled="@(i == 0)">↑</button><button class="btn btn-sm" name="dir" value="1" title="down" disabled="@(i == w.Steps.Count - 1)">↓</button>
    <button class="btn btn-sm btn-bad" formaction="/Admin/RemoveStep">@Ui.Icon("x", 14)</button></form></li> }
 </ol>
 <form method="post" action="/Admin/AddStep" asp-antiforgery="true" class="wf-add"><input type="hidden" name="kind" value="@w.Kind">
  <div class="form-grid"><div class="field"><label>@T["wf.approver"]</label><select name="type"><option value="@((int)ApproverType.Role)">@T["wf.byRole"]</option><option value="@((int)ApproverType.DirectManager)">@T["wf.byManager"]</option></select></div>
  <div class="field"><label>@T["wf.threshold"] (@T["wf.unit." + w.Kind])</label><input name="threshold" type="number" step="any" min="0" placeholder="@T["wf.always"]"></div></div>
  <div class="field"><label>@T["wf.roles"]</label><div class="inline-form">@foreach (var r in roles.Where(r => r.Code != Roles.Employee)) { <label class="check"><input type="checkbox" name="roles" value="@r.Code"> @T.RoleName(r.Code)</label> }</div></div>
  <button class="btn btn-primary btn-sm">@Ui.Icon("plus", 14) @T["wf.addStep"]</button></form>
</div></div> }
</div>
<div class="card" style="margin-top:18px"><div class="card-b faint small">@T["wf.note"]</div></div>

<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"إصدارات المسارات المستخدمة":"Observed workflow revisions")</h2></div><div class="card-b"><p class="muted">@(T.IsAr?"يحفظ كل طلب جديد بصمة تعريف المسار كما لوحظ عند إنشائه، إضافة إلى مساره الفعلي. التعديلات اللاحقة لا تعيد كتابة الطلبات القائمة. لا تختلق إصدارات للطلبات القديمة، وهذه ليست آلية مسودة ونشر منفصلة.":"New requests retain a hash of the definition observed at creation plus their resolved route. Later edits do not rewrite existing requests. Older requests have no invented revision. This is not a separate draft/publish workflow.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["common.type"]</th><th>@(T.IsAr?"لوحظ (UTC)":"Observed (UTC)")</th><th>SHA-256</th><th>@(T.IsAr?"التعريف المحفوظ":"Retained definition")</th></tr></thead><tbody>@foreach(var r in (List<WorkflowRevision>)ViewBag.Revisions){<tr><td>@r.Kind</td><td dir="ltr">@r.ObservedAt.ToString("yyyy-MM-dd HH:mm")</td><td><code title="@r.Hash">@r.Hash[..12]</code></td><td><details><summary>@(T.IsAr?"عرض":"View")</summary><pre dir="ltr" style="max-width:500px;white-space:pre-wrap;overflow-wrap:anywhere">@r.DefinitionJson</pre></details></td></tr>}</tbody></table></div></div></div>
