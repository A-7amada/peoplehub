@model List<WorkflowDefinition>
@{ ViewData["Title"] = T["nav.workflows"]; var roles = (List<Role>)ViewBag.Roles; }
<div class="page-head"><div><h1>@T["nav.workflows"]</h1><div class="sub">@T["wf.sub"]</div></div></div>
<div class="grid g2">
@foreach (var w in Model) {
<div class="card"><div class="card-h"><h2>@T["req.kind." + w.Kind]</h2><span class="faint small">@T["wf.desc." + w.Kind]</span></div><div class="card-b">
 <form method="post" action="/Admin/ApprovalComment" asp-antiforgery="true" class="inline-form"><input type="hidden" name="kind" value="@w.Kind"><label class="check"><input type="checkbox" name="required" value="true" checked="@(((HashSet<string>)ViewBag.RequiredComments).Contains(w.Kind))">@(T.IsAr?"تعليق إلزامي للموافقة":"Require an approval comment")</label><button class="btn btn-sm">@T["common.save"]</button></form><p class="faint small">@(T.IsAr?"يسري على القرارات التالية بما فيها الطلبات المعلقة. سبب الرفض إلزامي دائما. لا يغير القرارات السابقة.":"Applies to subsequent decisions, including pending requests. Rejection always requires a reason. Earlier decisions are unchanged.")</p>
 <form method="post" action="/Admin/ReminderPolicy" asp-antiforgery="true" class="inline-form"><input type="hidden" name="kind" value="@w.Kind"><label>@(T.IsAr?"تذكير بعد ساعات من المرحلة (0 إيقاف)":"Remind after elapsed stage hours (0 off)") <input type="number" min="0" max="8760" name="hours" value="@(((Dictionary<string,int>)ViewBag.ReminderHours)[w.Kind])" style="width:100px"></label><button class="btn btn-sm">@T["common.save"]</button></form><p class="faint small">@(T.IsAr?"يسري على المراحل المعلقة. ساعات متصلة وليست أيام عمل. تذكير داخلي يومي للمعتمد الحالي فقط، أثناء عمل الخدمة. لا بريد أو تصعيد تلقائي أو تغيير للمسار أو ضمان لموعد التسليم.":"Applies to pending stages. Continuous elapsed hours, not working days. At most daily in-app to current approvers while the service is awake. No email, automatic escalation, route change or delivery-time guarantee.")</p><ol class="wf">
 @for (var i = 0; i < w.Steps.Count; i++) { var s = w.Steps[i];
  <li><span class="num">@(i + 1)</span><div class="grow"><b>@T.Stage(s.Token)</b> <span class="chip">@(s.Approver!=ApproverType.Role?(T.IsAr?"معتمد واحد":"Single approver"):s.Rule==ApprovalRule.AnyRole?(T.IsAr?"أي حامل لدور":"Any role holder"):s.Rule==ApprovalRule.CapturedAny?(T.IsAr?"واحد من القائمة المحفوظة":"One captured participant"):s.Rule==ApprovalRule.All?(T.IsAr?"كل القائمة المحفوظة":"All captured participants"):(T.IsAr?$"عدد مطلوب: {s.RequiredCount}":$"Required count: {s.RequiredCount}"))</span>
    <div class="faint small">@(s.Approver==ApproverType.DepartmentManager?(T.IsAr?"يحفظ مدير قسم الموظف الحالي عند التقديم. غياب المدير أو كونه صاحب الطلب يمنع التقديم بدلا من تجاوز المرحلة.":"Captures the employee's department manager at submission. Missing manager or self-manager blocks submission rather than skipping this step."):s.Approver == ApproverType.DirectManager ? T["wf.managerHint"] : s.Rule!=ApprovalRule.AnyRole?(T.IsAr?"قائمة موظفين تحفظ عند التقديم. القاعدة الجماعية الموضحة أعلاه هي المطلوبة.":"Participant roster captured at submission. The group rule above determines completion."):T["wf.roleHint"])@if (s.Threshold != null) { <span> · @T["wf.when"] @s.Threshold @T["wf.unit." + w.Kind]</span> }</div></div>
   <form method="post" action="/Admin/MoveStep" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@s.Id">
    <button class="btn btn-sm" name="dir" value="-1" title="up" disabled="@(i == 0)">↑</button><button class="btn btn-sm" name="dir" value="1" title="down" disabled="@(i == w.Steps.Count - 1)">↓</button>
    <button class="btn btn-sm btn-bad" formaction="/Admin/RemoveStep">@Ui.Icon("x", 14)</button></form></li> }
 </ol>
 <form method="post" action="/Admin/AddStep" asp-antiforgery="true" class="wf-add"><input type="hidden" name="kind" value="@w.Kind">
  <div class="form-grid"><div class="field"><label>@T["wf.approver"]</label><select name="type"><option value="@((int)ApproverType.Role)">@T["wf.byRole"]</option><option value="@((int)ApproverType.DirectManager)">@T["wf.byManager"]</option><option value="@((int)ApproverType.DepartmentManager)">@(T.IsAr?"مدير القسم عند التقديم":"Department manager at submission")</option></select></div>
  <div class="field"><label>@T["wf.threshold"] (@T["wf.unit." + w.Kind])</label><input name="threshold" type="number" step="any" min="0" placeholder="@T["wf.always"]"></div></div>
  <div class="form-grid"><div class="field"><label>@(T.IsAr?"قاعدة اعتماد الأدوار":"Role approval rule")</label><select name="rule"><option value="0">@(T.IsAr?"أي حامل لدور (السلوك الحالي)":"Any role holder (existing behavior)")</option><option value="1">@(T.IsAr?"واحد من المعتمدين المسجلين":"Any one captured participant")</option><option value="2">@(T.IsAr?"جميع المعتمدين المسجلين":"All captured participants")</option><option value="3">@(T.IsAr?"عدد محدد من المعتمدين":"Configured participant count")</option></select></div><div class="field"><label>@(T.IsAr?"العدد المطلوب (للعدد المحدد فقط)":"Required count (configured count only)")</label><input name="requiredCount" type="number" min="1" max="1000"></div></div>
  <p class="faint small">@(T.IsAr?"القواعد الجماعية للأدوار فقط. تحفظ قائمة الموظفين العاملين ذوي الحسابات النشطة عند التقديم، دون صاحب الطلب. الموظف أو نائبه له صوت واحد فقط لكل مرحلة. لا تجاوز إداري للنصاب. يرفض التقديم إذا لم تكف القائمة. الرفض ينهي الطلب كله. إعادة التكليف لمقعد واحد لم يصوت بعد ولا تغير النصاب.":"Captured rules apply only to role steps. At submission, working employees with active accounts are captured, excluding the requester. Each human, including delegates, has one vote per stage. No admin quorum bypass. An insufficient roster blocks submission. Rejection ends the whole request. Reassignment replaces one unvoted seat without changing the required count.")</p>
  <div class="field"><label>@T["wf.roles"]</label><div class="inline-form">@foreach (var r in roles.Where(r => r.Code != Roles.Employee)) { <label class="check"><input type="checkbox" name="roles" value="@r.Code"> @T.RoleName(r.Code)</label> }</div></div>
  <button class="btn btn-primary btn-sm">@Ui.Icon("plus", 14) @T["wf.addStep"]</button></form>
</div></div> }
</div>
<div class="card" style="margin-top:18px"><div class="card-b faint small">@T["wf.note"]</div></div>

<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"إصدارات المسارات المستخدمة":"Observed workflow revisions")</h2></div><div class="card-b"><p class="muted">@(T.IsAr?"يحفظ كل طلب جديد بصمة تعريف المسار كما لوحظ عند إنشائه، إضافة إلى مساره الفعلي. التعديلات اللاحقة لا تعيد كتابة الطلبات القائمة. لا تختلق إصدارات للطلبات القديمة، وهذه ليست آلية مسودة ونشر منفصلة.":"New requests retain a hash of the definition observed at creation plus their resolved route. Later edits do not rewrite existing requests. Older requests have no invented revision. This is not a separate draft/publish workflow.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["common.type"]</th><th>@(T.IsAr?"لوحظ (UTC)":"Observed (UTC)")</th><th>SHA-256</th><th>@(T.IsAr?"التعريف المحفوظ":"Retained definition")</th></tr></thead><tbody>@foreach(var r in (List<WorkflowRevision>)ViewBag.Revisions){<tr><td>@r.Kind</td><td dir="ltr">@r.ObservedAt.ToString("yyyy-MM-dd HH:mm")</td><td><code title="@r.Hash">@r.Hash[..12]</code></td><td><details><summary>@(T.IsAr?"عرض":"View")</summary><pre dir="ltr" style="max-width:500px;white-space:pre-wrap;overflow-wrap:anywhere">@r.DefinitionJson</pre></details></td></tr>}</tbody></table></div></div></div>
