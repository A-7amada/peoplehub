@model PeopleHub.Web.Services.OperationsService
@{ ViewData["Title"] = T.IsAr ? "التشغيل وحماية البيانات" : "Operations and data safety"; Func<string,string,string> X=(en,ar)=>T.IsAr?ar:en; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Fictional portfolio demo. These controls do not certify production readiness.","عرض ببيانات خيالية. هذه الضوابط ليست شهادة جاهزية للإنتاج.")</div></div></div>
<div class="grid g2">
<section class="card"><div class="card-h"><h2>@X("Database","قاعدة البيانات")</h2>@Ui.Chip(Model.Provider,"violet")</div><div class="card-b"><p>@(Model.PersistenceConfigured ? X("Persistent storage is configured. Verify the provider dashboard and restore drills.","تم ضبط تخزين دائم. راجع لوحة المزود واختبارات الاستعادة.") : X("Ephemeral hosting: local data can still be lost on restart. Configure Postgres or a persistent disk.","الاستضافة مؤقتة: البيانات المحلية قد تضيع مع إعادة التشغيل. يلزم PostgreSQL أو قرص دائم."))</p><p>@X("Versioned EF migrations run before seeding. Existing data is not deliberately deleted.","ترحيلات EF مُرقّمة قبل بيانات البداية. لا يتم حذف البيانات الموجودة عمدًا.")</p></div></section>
<section class="card"><div class="card-h"><h2>@X("Backups and restore","النسخ والاستعادة")</h2></div><div class="card-b">
@{ <form method="post" action="/Admin/ExportDatabase" asp-antiforgery="true"><button class="btn btn-primary">@X("Download consistent data archive","تنزيل نسخة بيانات متسقة")</button></form> }
@* <p>@X("Use pg_dump with the direct database connection, not the pooler. Restore into a separate database before cutover.","استخدم pg_dump بالاتصال المباشر وليس pooler. استعد أولًا إلى قاعدة منفصلة قبل التحويل.")</p> *@
<p class="faint small">@X("Backups contain all records and authentication data. Keep them encrypted, private, and off the application host. See OPERATIONS.md for commands and limits.","النسخة تحتوي كل السجلات وبيانات المصادقة. احفظها مشفرة وخاصة وخارج سيرفر التطبيق. راجع OPERATIONS.md.")</p></div></section>
<section class="card"><div class="card-h"><h2>@X("Access protection","حماية الدخول")</h2></div><div class="card-b"><p>@X("Reset links are never shown on screen. Tokens are hashed and expire after one hour. Password changes invalidate old sessions. Repeated account requests are rate-limited.","روابط الاسترجاع لا تظهر على الشاشة. الرموز مخزنة كتجزئة وتنتهي خلال ساعة. تغيير كلمة المرور يلغي الجلسات القديمة. طلبات الحساب المتكررة محدودة.")</p></div></section>
<section class="card"><div class="card-h"><h2>@X("Mail delivery","إرسال البريد")</h2></div><div class="card-b"><p>@X("The outbox retries automatically while the app is awake. SMTP or the HTTPS provider needs credentials. Only explicitly allowed recipients can receive mail; fictional .local addresses are blocked.","صندوق الصادر يعيد المحاولة تلقائيًا أثناء عمل التطبيق. SMTP أو مزود HTTPS يحتاج بيانات تفعيل. الإرسال للمستلمين المسموحين صراحة فقط؛ عناوين .local الخيالية ممنوعة.")</p><p class="faint small">@X("Provider acceptance is not inbox delivery. A network timeout can still cause duplicates. Free hosting sleeps.","قبول المزود ليس تأكيد وصول. انقطاع الاتصال قد يسبب تكرارًا. الاستضافة المجانية تنام.")</p></div></section>
</div>
