@using PeopleHub.Application.Modules.Payroll
@model List<PayrollAdjustmentView>
@{ViewData["Title"]=T.IsAr?"تصحيحات مرتبات مرجعية":"Referenced payroll corrections";int target=ViewBag.Target;var sources=(List<PayrollLine>)ViewBag.Sources;}
<div class="page-head"><h1>@ViewData["Title"] #@target</h1><a class="btn" href="/Payroll/Run/@target">@T["nav.payroll"]</a></div>
<div class="flash">@(T.IsAr?"مقترح بمبلغ صريح وسبب من دورة مقفلة سابقة إلى مسودة لاحقة لنفس الموظف. يحتاج قرار مالية مستقل ثم تطبيق صريح على المكافأة أو الاستقطاع اليدوي. لا يغير التاريخ ولا يحسب فروقاً قانونية أو راتباً رجعياً تلقائياً ولا ينفذ دفعاً. إعادة حساب المسودة تحفظ الأرقام اليدوية. لا يمكن خفض الإجمالي اليدوي عن مبالغ التصحيحات المطبقة؛ عكس التصحيح غير متاح. راجع لقطة الحساب قبل الاعتماد.":"Explicit amount and reason from an earlier locked run to a later draft for the same employee. Independent Finance decision then explicit application to bonus or manual deduction. No historical rewrite, automatic retro calculation, legal validation or payment. Recalculation keeps manual totals. Manual totals cannot be reduced below applied correction amounts; correction reversal is not available. Review the calculation snapshot before approval.")</div>
@if(Me.Can(Perm.PayPrepare)){
<div class="card"><div class="card-h"><h2>@(T.IsAr?"مقترح تصحيح":"Propose correction")</h2></div><div class="card-b"><form method="post" action="/PayrollAdjustments/Propose" asp-antiforgery="true"><input type="hidden" name="id" value="@target"><div class="form-grid"><div class="field"><label>@(T.IsAr?"بند المصدر المقفل":"Locked source line")</label><select name="sourceLineId" required>@foreach(var l in sources){<option value="@l.Id">@(T.IsAr?"دورة":"Run") #@l.RunId · @(string.IsNullOrEmpty(l.EmployeeCodeSnapshot)?"Employee #"+l.EmployeeId:l.EmployeeCodeSnapshot) · @(T.IsAr?"بند":"Line") #@l.Id</option>}</select></div><div class="field"><label>@(T.IsAr?"نوع التصحيح":"Correction type")</label><select name="kind"><option value="Earning">@(T.IsAr?"إضافة للمكافأة":"Add to bonus")</option><option value="Deduction">@(T.IsAr?"إضافة لاستقطاع يدوي":"Add manual deduction")</option></select></div><div class="field"><label>@T["common.amount"] EGP</label><input type="number" name="amount" min="0.01" max="100000000" step="0.01" required></div><div class="field"><label>@T["common.reason"]</label><input name="reason" required maxlength="2000"></div></div><button class="btn btn-primary">@T["common.submit"]</button></form></div></div>}
@foreach(var v in Model){var p=v.Proposal;var last=v.Events.LastOrDefault();<div class="card"><div class="card-h"><h2>#@p.Id · @(p.Kind=="Earning"?(T.IsAr?"إضافة":"Earning"):(T.IsAr?"استقطاع":"Deduction")) · @p.Amount.ToString("N2") EGP</h2></div><div class="card-b"><p>@(T.IsAr?"موظف":"Employee") #@p.EmployeeId · @(T.IsAr?"دورة المصدر":"Source run") #@p.SourceRunId / @p.SourceVersion · @(T.IsAr?"بند":"Line") #@p.SourceLineId</p><p>@p.Reason</p><p class="muted">@p.Actor · @p.At.ToString("u")</p>@foreach(var e in v.Events){<p>@(e.Action=="Approved"?(T.IsAr?"معتمد":"Approved"):e.Action=="Rejected"?(T.IsAr?"مرفوض":"Rejected"):e.Action=="Cancelled"?(T.IsAr?"ملغي":"Cancelled"):(T.IsAr?"تم التطبيق":"Applied")) · @e.Actor · @e.At.ToString("u") · @e.Reason</p>}
@if(last==null&&Me.Can(Perm.PayFinance)&&p.ProposedByUserId!=Me.UserId&&p.EmployeeId!=Me.EmployeeId){<form method="post" action="/PayrollAdjustments/Decide" asp-antiforgery="true"><input type="hidden" name="id" value="@target"><input type="hidden" name="adjustmentId" value="@p.Id"><div class="field"><label>@T["common.reason"]</label><input name="reason" required maxlength="2000"></div><button class="btn" name="approve" value="true">@(T.IsAr?"اعتماد":"Approve")</button><button class="btn" name="approve" value="false">@(T.IsAr?"رفض":"Reject")</button></form>}
@if(last?.Action=="Approved"&&Me.Can(Perm.PayPrepare)){<form method="post" action="/PayrollAdjustments/Apply" asp-antiforgery="true"><input type="hidden" name="id" value="@target"><input type="hidden" name="adjustmentId" value="@p.Id"><div class="field"><label>@T["common.reason"]</label><input name="reason" required maxlength="2000"></div><button class="btn btn-primary">@(T.IsAr?"تطبيق على المسودة":"Apply to draft")</button></form>}
@if((last==null||last.Action=="Approved")&&Me.Can(Perm.PayPrepare)&&p.ProposedByUserId==Me.UserId){<form method="post" action="/PayrollAdjustments/Cancel" asp-antiforgery="true"><input type="hidden" name="id" value="@target"><input type="hidden" name="adjustmentId" value="@p.Id"><div class="field"><label>@T["common.reason"]</label><input name="reason" required maxlength="2000"></div><button class="btn">@(T.IsAr?"سحب المقترح قبل التطبيق":"Withdraw unapplied proposal")</button></form>}
</div></div>}
