@model List<RequestRow>
@if (Model.Count == 0) { <div class="empty">@T["common.none"]</div> } else {
<div class="tbl-wrap"><table class="tbl request-table"><thead><tr><th>@T["req.employee"]</th><th>@T["common.type"]</th><th>@T["req.details"]</th><th>@T["req.progress"]</th><th>@T["common.status"]</th><th></th></tr></thead><tbody>
@foreach (var r in Model) {
 var stages = r.Route.Split(',');
 <tr>
  <td><a class="person" href="/Employees/Profile/@r.Employee.Id">@Ui.Avatar(r.Employee, T)<span><div class="nm">@T.Name(r.Employee.FullName, r.Employee.FullNameAr)</div><div class="sb">@T.Date(r.CreatedAt)</div></span></a></td>
  <td><b>@T["req.kind." + r.Kind]</b>@if (r.TypeName != "") { <div class="faint small">@T.Name(r.TypeName, r.TypeNameAr)</div> }</td>
  <td class="small request-detail" style="max-width:300px"><bdi>@r.Detail</bdi> @if (r.AttachmentToken != null) { <a class="chip chip-blue" href="/Files/Get/@r.AttachmentToken" target="_blank">@Ui.Icon("download", 12) <bdi>@r.AttachmentName</bdi></a> } @if (!string.IsNullOrEmpty(r.Comment)) { <div class="faint">@r.Comment</div> }</td>
  <td>@if(r.GroupRequired>0){<p class="small">@(T.IsAr?"أصوات مكتملة:":"Votes received:") <bdi dir="ltr">@r.GroupVotes / @r.GroupRequired</bdi></p>}<div class="steps">@for (var i = 0; i < stages.Length; i++) { var cls = r.Status == RequestStatus.Approved || i < r.StageIndex ? "done" : r.Status == RequestStatus.Pending && i == r.StageIndex ? "cur" : r.Status == RequestStatus.Rejected && i == r.StageIndex ? "bad" : ""; <span class="step @cls">@T.Stage(stages[i])</span> }</div><div class="faint small">@(T.IsAr?"إصدار المسار:":"Workflow revision:") <code title="@r.WorkflowRevisionHash">@(r.WorkflowRevisionHash==null?(T.IsAr?"قديم، غير معروف":"Legacy, unknown"):r.WorkflowRevisionHash[..12])</code></div></td>
  <td>@Ui.Chip(T.E(r.Status), Ui.StatusTone(r.Status))
  @if(r.History.Count>0){<details><summary>@(T.IsAr?"سجل القرارات":"Decision history")</summary>@foreach(var h in r.History){<div class="small" style="white-space:normal;min-width:180px"><b>@(h.Action.StartsWith("AutoApproved:")?(T.IsAr?"اعتماد تلقائي من النظام: ":"Auto-approved by system: ")+T.Stage(h.Action[13..]):h.Action.StartsWith("Approved:")?T["status.Approved"]+": "+T.Stage(h.Action[9..]):h.Action.StartsWith("Rejected:")?T["status.Rejected"]:h.Action=="Cancelled"?T["status.Cancelled"]:h.Action.StartsWith("Reassigned:")?(T.IsAr?"إعادة تكليف":"Reassigned"):h.Action)</b><div>@h.Actor</div><time dir="ltr">@h.At.ToString("yyyy-MM-dd HH:mm") UTC</time><p>@(h.Action.StartsWith("AutoApproved:")?(T.IsAr?"لا يوجد معتمد مطابق لهذه الخطوة":"No matching approver for this step"):h.Comment)</p></div>}</details>}</td>
  <td class="right nowrap">
   @if(r.AssignedTo!=null){<p class="small" style="white-space:normal">@(T.IsAr?"المكلف الحالي:":"Assigned to:") <bdi>@r.AssignedTo</bdi></p>}
   @if(Me.Can(Perm.AdmFlows)&&r.Status==RequestStatus.Pending&&r.Stage!=null&&ViewBag.Assignees is List<ApprovalAssignee> users){<details style="margin-bottom:10px"><summary>@(T.IsAr?"إعادة تكليف المرحلة":"Reassign stage")</summary><form method="post" action="/Requests/Reassign" asp-antiforgery="true" style="white-space:normal;min-width:190px"><input type="hidden" name="kind" value="@r.Kind"><input type="hidden" name="id" value="@r.Id"><input type="hidden" name="stageIndex" value="@r.StageIndex">@if(r.PendingSeats is {Length:>0}){<label>@(T.IsAr?"المقعد المراد استبداله":"Participant seat to replace")<select name="participantEmployeeId" required>@foreach(var seat in r.PendingSeats){<option value="@seat">#@seat</option>}</select></label>}<select name="toUserId" required>@foreach(var u in users.Where(u=>u.EmployeeId!=r.Employee.Id)){<option value="@u.Id">@u.Email</option>}</select><input name="reason" required maxlength="2000" placeholder="@T["common.reason"]"><button class="btn btn-sm">@(T.IsAr?"إعادة التكليف":"Reassign")</button></form><p class="small" style="white-space:normal">@(T.IsAr?"للاعتماد الجماعي يستبدل مقعدا واحدا لم يصوت. لا يغير الأصوات أو النصاب. للمسارات القديمة يستبدل سلطة المرحلة. لا اعتماد تلقائي.":"For captured groups, replaces one unvoted seat, not votes or quorum. For legacy routes, replaces stage authority. Never approves automatically.")</p></details>}

   @if (r.CanAct) {
    <form method="post" action="/Requests/Approve" asp-antiforgery="true" class="inline-form" style="justify-content:flex-end"><input type="hidden" name="kind" value="@r.Kind"><input type="hidden" name="id" value="@r.Id"><input type="text" name="comment" placeholder="@(r.ApprovalCommentRequired?(T.IsAr?"تعليق إلزامي":"Required comment"):T["common.comment"])" required="@r.ApprovalCommentRequired" maxlength="2000" style="width:165px">
     <button class="btn btn-sm btn-good">@Ui.Icon("check", 14) @T["req.approve"]</button><button class="btn btn-sm btn-bad" formaction="/Requests/Reject">@Ui.Icon("x", 14) @T["req.reject"]</button></form>
   } else if (r.CanCancel) { <form method="post" action="/Requests/Cancel" asp-antiforgery="true" style="margin:0"><input type="hidden" name="kind" value="@r.Kind"><input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm">@T["req.cancel"]</button></form> }
   @if (r.Kind=="Leave" && r.Status==RequestStatus.Approved && (Me.EmployeeId==r.Employee.Id || Me.Can(Perm.LeaveAdmin))) {<form method="post" action="/Leave/CancelApproved" asp-antiforgery="true" class="inline-form"><input type="hidden" name="id" value="@r.Id"><input name="reason" required placeholder="@T["common.reason"]" style="width:120px"><button class="btn btn-sm btn-bad">@(T.IsAr?"إلغاء المعتمد":"Cancel approved")</button></form>}
  </td></tr> }
</tbody></table></div> }
