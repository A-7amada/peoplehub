@inject NotificationService Notes
@inject ApprovalService Appr
@{
    var ar = T.IsAr;
    var ctrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var auth = User.Identity?.IsAuthenticated == true;
    int unread = auth ? await Notes.UnreadCountAsync() : 0;
    int inbox = auth ? await Appr.PendingForMeAsync() : 0;
    var act = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    string On(string c, string? a = null) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) && (a == null || string.Equals(act,a,StringComparison.OrdinalIgnoreCase)) ? "on" : "";
    bool Can(string p) => Me.Can(p);
    var mainRole = Roles.All.FirstOrDefault(User.IsInRole) ?? User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).FirstOrDefault() ?? "Employee";
    var ret = Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@(ViewData["Title"] ?? T["app.name"]) · PeopleHub</title>
<link rel="icon" href="~/favicon.ico"><link rel="stylesheet" href="~/css/site.css?v=4">
</head>
<body>
@if (!auth) { @RenderBody() }
else {
<div class="app">
<aside class="sidebar">
  <div class="brand"><span class="brand-mark">@Ui.Icon("users", 20)</span> PeopleHub</div>
  <nav class="nav">
    <a class="@On("Home")" href="/">@Ui.Icon("home") @T["nav.dashboard"]</a>
    <div class="nav-label">@T["nav.people"]</div>
    <a class="@On("Employees")" href="@((Can(Perm.ScopeCompany) || Can(Perm.ScopeTeam)) ? "/Employees" : "/Employees/Profile")">@Ui.Icon("users") @T[(Can(Perm.ScopeCompany) || Can(Perm.ScopeTeam)) ? "nav.employees" : "nav.myProfile"]</a>
    <a class="@On("Organization")" href="/Organization">@Ui.Icon("org") @T["nav.organization"]</a>
    <div class="nav-label">@T["nav.time"]</div>
    <a class="@On("Attendance")" href="/Attendance">@Ui.Icon("clock") @T["nav.attendance"]</a>
    <a class="@On("Leave")" href="@(User.Claims.Any(c => c.Type == "emp") ? "/Leave" : "/Leave/Team")">@Ui.Icon("calendar") @T["nav.leave"]</a>
    <a class="@(act == "Delegations" ? "" : On("Requests"))" href="/Requests?scope=@(inbox > 0 ? "inbox" : "mine")">@Ui.Icon("inbox") @T["nav.requests"] @if (inbox > 0) { <span class="badge">@inbox</span> }</a>
    <a class="@On("Requests", "Delegations") nav-sub" href="/Requests/Delegations">@Ui.Icon("users") @T["nav.deleg"]</a>
    <div class="nav-label">@(T.IsAr ? "المواهب" : "Talent")</div>
    @if (Can(Perm.TalentManage)) { <a class="@On("Talent", "Recruitment")" href="/Talent/Recruitment">@Ui.Icon("users") @(T.IsAr ? "التوظيف" : "Recruitment")</a> }
    <a class="@On("Perf")" href="/Perf">@Ui.Icon("chart") @(T.IsAr ? "إدارة الأداء" : "Performance")</a>
    <a class="@On("Benefits")" href="/Benefits">@Ui.Icon("users") @(T.IsAr ? "المزايا" : "Benefits")</a>
    <a class="@On("Talent", "Training")" href="/Talent/Training">@Ui.Icon("clock") @(T.IsAr ? "التدريب" : "Training")</a>
    <div class="nav-label">@T["nav.finance"]</div>
    <a class="@On("Payroll")" href="/Payroll">@Ui.Icon("wallet") @T["nav.payroll"]</a>
    @if (Can(Perm.Reports)) { <a class="@On("Reports", "Index")" href="/Reports">@Ui.Icon("chart") @T["nav.reports"]</a> <a class="@On("Reports", "Builder") nav-sub" href="/Reports/Builder">@Ui.Icon("chart") @(T.IsAr ? "منشئ التقارير" : "Report builder")</a> }
    @if (Can(Perm.EmpPay)) { <a class="@On("Talent", "Settlement") nav-sub" href="/Talent/Settlement">@Ui.Icon("wallet") @(T.IsAr ? "نهاية الخدمة" : "End of service")</a> }
    @if (Can(Perm.Audit) || Can(Perm.AdmUsers) || Can(Perm.AdmRoles) || Can(Perm.AdmFlows) || Can(Perm.AdmSettings)) {
      <div class="nav-label">@T["nav.admin"]</div>
      @if (Can(Perm.Audit)) { <a class="@On("System", "Audit")" href="/System/Audit">@Ui.Icon("shield") @T["nav.audit"]</a> }
      @if (Can(Perm.AdmUsers)) { <a class="@On("Admin", "Users")" href="/Admin/Users">@Ui.Icon("key") @T["nav.users"]</a> }
      @if (Can(Perm.AdmRoles)) { <a class="@On("Admin", "Roles")" href="/Admin/Roles">@Ui.Icon("shield") @T["nav.roles"]</a> }
      @if (Can(Perm.AdmSettings)) { <a class="@On("Admin", "Settings")" href="/Admin/Settings">@Ui.Icon("shield") @(T.IsAr ? "الإعدادات" : "Settings")</a> }
      @if (Can(Perm.AdmFlows)) { <a class="@On("Admin", "Workflows")" href="/Admin/Workflows">@Ui.Icon("inbox") @T["nav.workflows"]</a> }
    }
    @if(Can(Perm.AdmSettings)){<a href="/Diagnostics">@Ui.Icon("chart") @(T.IsAr?"تشخيص الخدمة":"Service diagnostics")</a>}
  </nav>
  <div class="side-foot"><span class="demo-pill">@Ui.Icon("info", 14) @T["demo.pill"]</span><div style="margin-top:8px">@T["demo.fictional"]</div></div>
</aside>
<div class="main">
  <header class="topbar">
    <div class="grow"></div>
    <a class="icon-btn" href="/Account/Lang?to=@(ar ? "en" : "ar")&returnUrl=@Uri.EscapeDataString(ret)" title="@T["nav.lang"]" style="width:auto;padding:0 12px;gap:6px;display:flex;align-items:center;font-weight:600">@Ui.Icon("globe", 16) @T["nav.lang"]</a>
    <a class="icon-btn" href="/System/Notifications" title="@T["nav.notifications"]">@Ui.Icon("bell") @if (unread > 0) { <span class="dot">@unread</span> }</a>
    <div class="userbox">
      <span class="avatar" style="width:32px;height:32px;background:#eef0ff;color:#5b5bd6;font-size:13px">@User.Identity!.Name![..2].ToUpper()</span>
      <div><div class="nm">@User.Identity.Name</div><div class="rl">@T.RoleName(mainRole)</div></div>
    </div>
    <a class="icon-btn" href="/Account/Security" title="Security">@Ui.Icon("key")</a><form method="post" action="/Account/Logout" asp-antiforgery="true" style="margin:0"><button class="icon-btn" title="@T["nav.logout"]">@Ui.Icon("logout")</button></form>
  </header>
  <main class="content">
    <div class="demo-banner">@Ui.Icon("info", 16) <span>@T["demo.banner"]</span></div>
    @if (TempData["ok"] is string ok) { <div class="flash ok">@Ui.Icon("check", 18) @ok</div> }
    @if (TempData["err"] is string er) { <div class="flash err">@Ui.Icon("x", 18) @er</div> }
    @RenderBody()
  </main>
</div>
</div>
}
</body></html>
