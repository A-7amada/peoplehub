@inject NotificationService Notes
@inject ApprovalService Appr
@{
    var ar = T.IsAr;
    var ctrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var auth = User.Identity?.IsAuthenticated == true;
    int unread = auth ? await Notes.UnreadCountAsync() : 0;
    int inbox = auth ? await Appr.PendingForMeAsync() : 0;
    string On(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "on" : "";
    bool Any(string roles) => roles.Split(',').Any(User.IsInRole);
    var mainRole = Roles.All.FirstOrDefault(User.IsInRole) ?? "Employee";
    var ret = Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@(ViewData["Title"] ?? T["app.name"]) · PeopleHub</title>
<link rel="icon" href="~/favicon.ico"><link rel="stylesheet" href="~/css/site.css?v=3">
</head>
<body>
@if (!auth) { @RenderBody() }
else {
<div class="app">
<aside class="sidebar">
  <div class="brand"><span class="brand-mark">@Ui.Icon("users", 20)</span> PeopleHub</div>
  <nav class="nav">
    <a class="@On("Home")" href="/">@Ui.Icon("home") @T["nav.dashboard"]</a>
    <div class="nav-label">@T["nav.people"]</div>
    <a class="@On("Employees")" href="@(Any(Roles.Company + "," + Roles.DepartmentManager) ? "/Employees" : "/Employees/Profile")">@Ui.Icon("users") @T[Any(Roles.Company + "," + Roles.DepartmentManager) ? "nav.employees" : "nav.myProfile"]</a>
    <a class="@On("Organization")" href="/Organization">@Ui.Icon("org") @T["nav.organization"]</a>
    <div class="nav-label">@T["nav.time"]</div>
    <a class="@On("Attendance")" href="/Attendance">@Ui.Icon("clock") @T["nav.attendance"]</a>
    <a class="@On("Leave")" href="@(User.Claims.Any(c => c.Type == "emp") ? "/Leave" : "/Leave/Team")">@Ui.Icon("calendar") @T["nav.leave"]</a>
    <a class="@On("Requests")" href="/Requests?scope=@(inbox > 0 ? "inbox" : "mine")">@Ui.Icon("inbox") @T["nav.requests"] @if (inbox > 0) { <span class="badge">@inbox</span> }</a>
    <div class="nav-label">@T["nav.finance"]</div>
    <a class="@On("Payroll")" href="/Payroll">@Ui.Icon("wallet") @T["nav.payroll"]</a>
    @if (Any(Roles.Company + "," + Roles.DepartmentManager)) { <a class="@On("Reports")" href="/Reports">@Ui.Icon("chart") @T["nav.reports"]</a> }
    @if (Any(Roles.SystemAdmin + "," + Roles.HRManager + "," + Roles.TopManagement)) {
      <div class="nav-label">@T["nav.admin"]</div>
      <a class="@On("System")" href="/System/Audit">@Ui.Icon("shield") @T["nav.audit"]</a>
    }
    @if (Any(Roles.SystemAdmin)) { <a href="/System/Users">@Ui.Icon("key") @T["nav.users"]</a> }
  </nav>
  <div class="side-foot"><span class="demo-pill">@Ui.Icon("info", 14) @T["demo.pill"]</span><div style="margin-top:8px">@T["demo.fictional"]</div></div>
</aside>
<div class="main">
  <header class="topbar">
    <div class="grow"></div>
    <a class="icon-btn" href="/Account/Lang?to=@(ar ? "en" : "ar")&returnUrl=@Uri.EscapeDataString(ret)" title="@T["nav.lang"]" style="width:auto;padding:0 12px;gap:6px;display:flex;align-items:center;font-weight:600">@Ui.Icon("globe", 16) @T["nav.lang"]</a>
    <a class="icon-btn" href="/System/Notifications" title="@T["nav.notifications"]">@Ui.Icon("bell") @if (unread > 0) { <span class="dot">@unread</span> }</a>
    <div class="userbox">
      <span class="avatar" style="width:32px;height:32px;background:#eef0ff;color:#5b5bd6;font-size:13px">@User.Identity!.Name![..2].ToUpper()</span>
      <div><div class="nm">@User.Identity.Name</div><div class="rl">@T["role." + mainRole]</div></div>
    </div>
    <form method="post" action="/Account/Logout" asp-antiforgery="true" style="margin:0"><button class="icon-btn" title="@T["nav.logout"]">@Ui.Icon("logout")</button></form>
  </header>
  <main class="content">
    <div class="demo-banner">@Ui.Icon("info", 16) <span>@T["demo.banner"]</span></div>
    @if (TempData["ok"] is string ok) { <div class="flash ok">@Ui.Icon("check", 18) @ok</div> }
    @if (TempData["err"] is string er) { <div class="flash err">@Ui.Icon("x", 18) @er</div> }
    @RenderBody()
  </main>
</div>
</div>
}
</body></html>
