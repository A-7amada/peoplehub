@{ var ar = T.IsAr; var staff = User.FindFirst("platform")?.Value == "1"; var ret = Context.Request.Path.ToString(); }
<!doctype html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@(ViewData["Title"] ?? "Platform") · PeopleHub</title><link rel="icon" href="~/favicon.ico"><link rel="stylesheet" href="~/css/site.css?v=4"></head>
<body>
<div style="max-width:980px;margin:0 auto;padding:20px">
  <div class="demo-banner">@Ui.Icon("info", 16) <span>@T["demo.banner"]</span></div>
  <div style="display:flex;justify-content:space-between;align-items:center;margin:16px 0 22px">
    <div class="brand" style="color:inherit"><span class="brand-mark">@Ui.Icon("users", 20)</span> PeopleHub <span class="faint">· @(ar ? "إدارة المنصة" : "Platform admin")</span></div>
    <div style="display:flex;gap:8px;align-items:center">
      <a href="/Account/Lang?to=@(ar ? "en" : "ar")&returnUrl=@ret" class="btn btn-sm">@Ui.Icon("globe", 14) @T["nav.lang"]</a>
      @if (staff) { <form method="post" action="/Platform/Logout" asp-antiforgery="true"><button class="btn btn-sm">@(ar ? "تسجيل الخروج" : "Sign out")</button></form> }
    </div>
  </div>
  @if (TempData["ok"] is string ok) { <div class="flash ok">@ok</div> }
  @if (TempData["err"] is string er) { <div class="flash err">@er</div> }
  @RenderBody()
</div>
</body></html>
