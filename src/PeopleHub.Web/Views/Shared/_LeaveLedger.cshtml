@model List<LeaveTransaction>
@{ var leaveTypes=(List<LeaveType>)ViewBag.Types; string Kind(string k)=>T.IsAr?k switch {"Opening"=>"افتتاحي","Baseline"=>"رصيد مرحل","Adjustment"=>"تعديل","Approved"=>"اعتماد","Cancellation"=>"إلغاء",_=>k}:k; }
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"سجل حركات رصيد الإجازات":"Leave transaction ledger")</h2></div><div class="card-b"><p class="muted small">@(T.IsAr?"الرصيد يخصم عند الاعتماد النهائي، وليس عند تقديم الطلب. تاريخ ما قبل الترقية يظهر كرصيد افتتاحي ولا يعاد تخمينه.":"Balance is deducted at final approval, not submission. Pre-upgrade history is an opening baseline, not reconstructed transactions.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@(T.IsAr?"الوقت (UTC)":"Time (UTC)")</th><th>@T["common.type"]</th><th>@(T.IsAr?"التغير بالأيام":"Days delta")</th><th>@T["common.reason"]</th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="nowrap">@x.At.ToString("yyyy-MM-dd HH:mm")</td><td>@Kind(x.Kind) · @(leaveTypes.FirstOrDefault(t=>t.Id==x.LeaveTypeId) is {} lt?T.Name(lt.Name,lt.NameAr):$"#{x.LeaveTypeId}")</td><td>@x.Delta</td><td>@x.Reason</td></tr>}</tbody></table></div></div></div>
