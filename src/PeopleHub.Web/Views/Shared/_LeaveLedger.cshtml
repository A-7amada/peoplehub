@model List<LeaveTransaction>
<div class="card" style="margin-top:18px"><div class="card-h"><h2>@(T.IsAr?"سجل حركات رصيد الإجازات":"Leave transaction ledger")</h2></div><div class="card-b"><p class="muted small">@(T.IsAr?"الرصيد يخصم عند الاعتماد النهائي، وليس عند تقديم الطلب. تاريخ ما قبل الترقية يظهر كرصيد افتتاحي ولا يعاد تخمينه.":"Balance is deducted at final approval, not submission. Pre-upgrade history is an opening baseline, not reconstructed transactions.")</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@(T.IsAr?"الوقت":"Time")</th><th>@T["common.type"]</th><th>@(T.IsAr?"التغير بالأيام":"Days delta")</th><th>@T["common.reason"]</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.At.ToString("yyyy-MM-dd HH:mm")</td><td>@T.E(x.Kind) #@x.LeaveTypeId</td><td>@x.Delta</td><td>@x.Reason</td></tr>}</tbody></table></div></div></div>
