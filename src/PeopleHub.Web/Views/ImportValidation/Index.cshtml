@using PeopleHub.Application.Modules.Employees
@model EmployeeImportPreview
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;ViewData["Title"]=X("Employee CSV dry-run validation","فحص ملف الموظفين دون استيراد");}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Validation only. No employee records are created or changed.","فحص فقط. لا يتم إنشاء سجلات موظفين أو تغييرها.")</div></div></div>
<div class="card"><div class="card-b"><p>@X("Upload a UTF-8 CSV up to 256 KiB and 200 data rows with this exact header. Existing code/email matches are conflicts, not updates. Department, branch and job-title IDs must already exist. Dates use yyyy-MM-dd. Quoted commas and escaped quotes are supported. Multiline/control-containing values are invalid.","ارفع ملف CSV بترميز UTF-8 بحد أقصى ٢٥٦ كيلوبايت و٢٠٠ صف بيانات بهذا العنوان بالضبط. تطابق الكود أو البريد الموجود تعارض وليس تحديثاً. يجب أن تكون معرفات القسم والفرع والمسمى موجودة. التواريخ بصيغة yyyy-MM-dd. يدعم الفواصل داخل علامات الاقتباس وعلامات الاقتباس المكررة. القيم متعددة الأسطر أو التي تحتوي رموز تحكم غير صالحة.")</p>
<pre dir="ltr" style="white-space:pre-wrap;overflow-wrap:anywhere">@EmployeeImportValidation.Header</pre>
<p class="muted small">@X("Do not include salary, bank, national-ID or other columns. The dry-run does not store the file; staging keeps only these eight columns until commit or discard. Results are not an approval or a guarantee of later import. Mapping, employment policies, account creation, balances, history reconciliation, historical reconciliation and rollback of committed batches remain unimplemented here. Revalidate after any source or system change.","لا تضف أعمدة الراتب أو البنك أو الرقم القومي أو غيرها. الفحص لا يخزن الملف، والتجهيز يحتفظ بهذه الأعمدة الثمانية فقط حتى التنفيذ أو الحذف. النتيجة ليست اعتماداً أو ضماناً للاستيراد لاحقاً. ربط الحقول وسياسات التوظيف وإنشاء الحسابات والأرصدة ومطابقة التاريخ ووالتراجع عن دفعات منفذة غير منفذة هنا. أعد الفحص بعد أي تغيير في المصدر أو النظام.")</p>
<form method="post" action="/ImportValidation/Preview" enctype="multipart/form-data" asp-antiforgery="true"><div class="field"><label>@X("Employee CSV, validation only","ملف الموظفين CSV، فحص فقط")</label><input type="file" name="file" accept=".csv,text/csv" required></div><button class="btn btn-primary">@X("Validate without importing","فحص دون استيراد")</button></form>
<form method="post" action="/ImportValidation/Stage" enctype="multipart/form-data" asp-antiforgery="true" style="margin-top:16px"><div class="field"><label>@X("Stage the same CSV for import (only if every row is valid; nothing is created until you commit)","جهّز نفس الملف للاستيراد (فقط إذا كانت كل الصفوف سليمة، ولا يُنشأ شيء حتى تنفذ)")</label><input type="file" name="file" accept=".csv,text/csv" required></div><button class="btn">@X("Stage for import","تجهيز للاستيراد")</button></form></div></div>
@if(Model!=null){<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Dry-run result","نتيجة الفحص")</h2></div><div class="card-b"><p>@X("Rows","الصفوف"): @Model.Rows.Count · @X("Rows with no detected issue","صفوف دون مشكلة مكتشفة"): @Model.ValidRows · @X("Employees written","موظفون تمت كتابتهم"): 0</p><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@X("CSV row","صف CSV")</th><th>@X("Code","الكود")</th><th>@X("Name","الاسم")</th><th>@X("Email","البريد")</th><th>@X("Checks","نتيجة الفحص")</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Row</td><td>@row.Code</td><td style="overflow-wrap:anywhere">@row.Name</td><td style="overflow-wrap:anywhere">@row.Email</td><td>@if(row.Errors.Count==0){@X("No detected issue, not imported","لا مشكلة مكتشفة، لم يتم الاستيراد")}else{<ul>@foreach(var error in row.Errors){<li>@(error switch{"columns"=>X("Expected eight columns","مطلوب ثمانية أعمدة"),"controls"=>X("Control characters or multiline values","رموز تحكم أو قيم متعددة الأسطر"),"code"=>X("Code required, at most 50 characters","الكود مطلوب، بحد أقصى ٥٠ حرفاً"),"name"=>X("Name required, names at most 200 characters","الاسم مطلوب، الأسماء بحد أقصى ٢٠٠ حرف"),"email"=>X("Invalid email format","صيغة بريد غير صالحة"),"hireDate"=>X("Invalid hire date","تاريخ تعيين غير صالح"),"department"=>X("Unknown department ID","معرف قسم غير موجود"),"branch"=>X("Unknown branch ID","معرف فرع غير موجود"),"jobTitle"=>X("Unknown job-title ID","معرف مسمى غير موجود"),"existingCode"=>X("Code already exists","الكود موجود بالفعل"),"existingEmail"=>X("Email already exists","البريد موجود بالفعل"),"duplicateCode"=>X("Repeated code in this file","كود مكرر داخل الملف"),"duplicateEmail"=>X("Repeated email in this file","بريد مكرر داخل الملف"),_=>X("Invalid value","قيمة غير صالحة")})</li>}</ul>}</td></tr>}</tbody></table></div></div></div>}
