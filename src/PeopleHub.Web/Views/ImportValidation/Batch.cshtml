@model EmployeeImportBatch
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;ViewData["Title"]=X("Employee import batch #","دفعة استيراد الموظفين رقم ")+Model.Id;var recon=ViewBag.Recon as ImportReconciliation;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@(Model.Status=="RolledBack"?X("Rolled back. The imported people were terminated and their records are kept.","تم التراجع. أُنهيت خدمة الموظفين المستوردين وسجلاتهم محفوظة."):Model.Status=="Staged"?X("Staged and waiting. No employee has been created yet.","مجهزة وبانتظار القرار. لم يتم إنشاء أي موظف بعد."):X("Committed. These employees were created from the staged rows.","تم التنفيذ. أُنشئ هؤلاء الموظفون من الصفوف المجهزة."))</div></div></div>
<div class="card"><div class="card-b">
<p>@X("Rows","الصفوف"): @Model.RowCount · @X("Staged by","جهزها"): <span dir="ltr">@Model.CreatedBy</span> · <time dir="ltr">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</time></p>
@if(Model.Status=="Staged"){<p class="muted small">@X("Commit creates all employees or none. Every row is checked again first. Employees are created without accounts, salary, bank or identity data, and existing people are never updated. A committed batch can be rolled back, which terminates the imported people and never deletes them.","التنفيذ ينشئ كل الموظفين أو لا ينشئ أحدا، ويُفحص كل صف مرة أخرى قبله. يُنشأ الموظفون دون حسابات أو راتب أو بيانات بنكية أو هوية، ولا يتم تحديث أي شخص موجود. يمكن التراجع عن دفعة منفذة، ويؤدي ذلك إلى إنهاء خدمة الموظفين المستوردين دون حذفهم.")</p>
<form method="post" action="/ImportValidation/Commit" asp-antiforgery="true" style="display:inline"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-primary">@X("Commit import","تنفيذ الاستيراد")</button></form>
<form method="post" action="/ImportValidation/Discard" asp-antiforgery="true" style="display:inline"><input type="hidden" name="id" value="@Model.Id"><button class="btn">@X("Discard batch","حذف الدفعة")</button></form>}
else{<p>@X("Committed by","نفذها"): <span dir="ltr">@Model.CommittedBy</span> · <time dir="ltr">@Model.CommittedAt?.ToString("yyyy-MM-dd HH:mm") UTC</time></p>
@if(recon!=null){<p>@X("Reconciliation","المطابقة"): @X("staged","مجهز") @recon.Staged · @X("employees found","موظفون موجودون") @recon.Linked · @X("missing","مفقودون") @recon.Missing</p>}}
@if(Model.Status=="Committed"){<form method="post" action="/ImportValidation/Rollback" asp-antiforgery="true" style="margin-top:12px"><input type="hidden" name="id" value="@Model.Id"><div class="field"><label>@X("Rollback reason (required). Terminates the imported people, never deletes them.","سبب التراجع (مطلوب). يُنهي خدمة الموظفين المستوردين ولا يحذفهم.")</label><input name="reason" required maxlength="300"></div><button class="btn">@X("Roll back (terminate imported people)","تراجع (إنهاء خدمة المستوردين)")</button></form>}
@if(Model.Status=="RolledBack"){<p>@X("Rolled back by","تراجع بواسطة"): <span dir="ltr">@Model.RolledBackBy</span> · <time dir="ltr">@Model.RolledBackAt?.ToString("yyyy-MM-dd HH:mm") UTC</time> · @Model.RollbackReason</p>}
<p><a href="/ImportValidation">@X("Back to validation","العودة إلى الفحص")</a></p>
</div></div>
