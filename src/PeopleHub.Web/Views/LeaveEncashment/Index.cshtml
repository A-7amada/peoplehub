@model List<LeaveEncashment>
@{ViewData["Title"]=T.IsAr?"صرف رصيد الإجازات":"Leave encashment";Func<string,string,string>X=(e,a)=>T.IsAr?a:e;var types=(List<LeaveType>)ViewBag.Types;var max=(Dictionary<int,decimal>)ViewBag.Max;int year=ViewBag.Year;}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p class="sub">@X("Approval record for paying out unused days","سجل اعتماد لصرف الأيام غير المستخدمة")</p></div><a class="btn" href="/Leave">@T["nav.leave"]</a></div>
<p class="muted small">@X("This records days only. No payout amount is computed and payroll is not changed: the rate and the payroll link need your decision and a payroll specialist. A type is off until you set a yearly maximum above 0. A different person must decide each request. Illustrative, not legally validated.","يسجل هذا الأيام فقط. لا يحسب مبلغا ولا يغير المرتبات: السعر وربط المرتبات يحتاجان قرارك ومختصا في المرتبات. النوع متوقف حتى تحدد حدا سنويا أكبر من صفر. يجب أن يقرر شخص مختلف في كل طلب. توضيحي وغير معتمد قانونيا.")</p>
<div class="card" style="margin-bottom:18px"><div class="card-h"><h2>@X("Yearly maximum per leave type (days)","الحد السنوي لكل نوع إجازة (أيام)")</h2></div><div class="card-b"><table class="tbl"><tbody>
@foreach(var t in types){<tr><td>@(T.IsAr?t.NameAr:t.Name)</td><td><form method="post" action="/LeaveEncashment/Max" asp-antiforgery="true" style="display:inline-flex;gap:6px"><input type="hidden" name="leaveTypeId" value="@t.Id"><input class="input" type="number" step="0.5" min="0" max="366" name="days" value="@max[t.Id].ToString(System.Globalization.CultureInfo.InvariantCulture)" style="width:110px"><button class="btn btn-sm">@X("Save","حفظ")</button></form></td></tr>}
</tbody></table></div></div>
<div class="card" style="margin-bottom:18px"><div class="card-b"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>@X("Employee","الموظف")</th><th>@X("Type","النوع")</th><th>@X("Year","السنة")</th><th>@X("Days","الأيام")</th><th>@X("Status","الحالة")</th><th></th></tr></thead><tbody>
@foreach(var r in Model){<tr><td>@r.Id</td><td>#@r.EmployeeId</td><td>@(types.FirstOrDefault(t=>t.Id==r.LeaveTypeId)?.Code)</td><td>@r.Year</td><td>@r.Days.ToString("0.#")</td><td>@r.Status</td>
<td>@if(r.Status=="Requested"){<form method="post" action="/LeaveEncashment/Decide" asp-antiforgery="true" style="display:inline-flex;gap:6px"><input type="hidden" name="id" value="@r.Id"><input class="input" name="note" maxlength="500" required placeholder="@X("Note","ملاحظة")"><button class="btn btn-sm" name="approve" value="true">@X("Approve","اعتماد")</button><button class="btn btn-sm" name="approve" value="false">@X("Reject","رفض")</button></form><form method="post" action="/LeaveEncashment/Cancel" asp-antiforgery="true" style="display:inline"><input type="hidden" name="id" value="@r.Id"><button class="btn btn-sm">@X("Cancel","إلغاء")</button></form>}</td></tr>}
@if(Model.Count==0){<tr><td colspan="7">@X("No requests.","لا توجد طلبات.")</td></tr>}
</tbody></table></div></div></div>
<div class="card"><div class="card-h"><h2>@X("New request","طلب جديد")</h2></div><div class="card-b"><form method="post" action="/LeaveEncashment/Request" asp-antiforgery="true" class="form-grid">
<div class="field"><label>@X("Employee number (id)","رقم الموظف (المعرف)")</label><input class="input" type="number" min="1" name="employeeId" required></div>
<div class="field"><label>@X("Leave type","نوع الإجازة")</label><select class="input" name="leaveTypeId">@foreach(var t in types){<option value="@t.Id">@(T.IsAr?t.NameAr:t.Name)</option>}</select></div>
<div class="field"><label>@X("Year","السنة")</label><input class="input" type="number" name="year" value="@year" required></div>
<div class="field"><label>@X("Days","الأيام")</label><input class="input" type="number" step="0.5" min="0.5" name="days" required></div>
<div class="field"><label>&nbsp;</label><button class="btn btn-primary">@X("Request","طلب")</button></div></form></div></div>
