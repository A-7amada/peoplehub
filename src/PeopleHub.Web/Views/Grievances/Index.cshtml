@model GrievanceView
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;ViewData["Title"]=X("Internal grievance intake","طلبات التظلم الداخلية");bool manage=Me.Can(Perm.RelationsManage);}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><div class="sub">@X("Employee statements and explicit responses, separate from investigation cases.","بيانات الموظفين والردود الموجهة لهم، منفصلة عن قضايا التحقيق.")</div></div></div>
<div class="card"><div class="card-b"><p>@X("Your submission is visible to accounts with the separate relations-management grant, not general HR or your manager by default. This is not anonymous. Responses below are written for you to read; private investigation notes and files are not shared here.","يظهر طلبك للحسابات التي تملك صلاحية إدارة علاقات الموظفين، ولا يظهر تلقائياً للموارد البشرية العامة أو مديرك. الطلب ليس مجهول الهوية. الردود أدناه مخصصة لاطلاعك، ولا تتم مشاركة ملاحظات التحقيق أو ملفاته الخاصة هنا.")</p><p class="muted small">@X("Internal demo records only. No email, emergency response, response deadline, legal decision, served notice, sanction, employee-status change or payroll effect. Submission does not create a case or grant case access. Do not use for emergencies. Appeal and legal-review processes remain separate.","سجلات تجريبية داخلية فقط. لا تُرسل رسائل بريد، ولا توجد استجابة طوارئ أو مهلة رد أو قرار قانوني أو إخطار مُبلّغ أو جزاء أو تغيير لحالة الموظف أو الراتب. لا ينشئ الطلب قضية أو يمنح وصولاً للقضايا. لا تستخدمه للطوارئ. التظلم من القرارات والمراجعة القانونية يظلان منفصلين.")</p></div></div>
@foreach(var g in Model.Submissions){<div class="card" style="margin-top:20px"><div class="card-h"><h2>#@g.Id · @g.Title</h2></div><div class="card-b"><p class="small faint">@X("Submitted by employee","مقدم من الموظف") #@g.EmployeeId · @g.Actor · @T.Date(g.At)</p><p style="white-space:pre-wrap;overflow-wrap:anywhere">@g.Statement</p><h3>@X("Responses visible to the submitter","الردود الظاهرة لمقدم الطلب")</h3>@foreach(var r in Model.Responses.Where(x=>x.GrievanceId==g.Id)){<div style="border-inline-start:3px solid var(--brand);padding:10px 16px;margin:10px 0"><p style="white-space:pre-wrap;overflow-wrap:anywhere">@r.Note</p><small class="faint">@r.Actor · @T.Date(r.At)</small></div>}
@if(manage&&g.SubmittedByUserId!=Me.UserId&&g.EmployeeId!=Me.EmployeeId){<form method="post" action="/Grievances/Respond" asp-antiforgery="true" class="form-grid"><input type="hidden" name="id" value="@g.Id"><div class="field full"><label>@X("Response, visible to this employee. Do not include private investigation notes.","رد يظهر لهذا الموظف. لا تضف ملاحظات التحقيق الخاصة.")</label><textarea name="note" maxlength="8000" required></textarea></div><div><button class="btn">@X("Record employee-visible response","تسجيل الرد الظاهر للموظف")</button></div></form>}
</div></div>}
@if(Model.CanSubmit){<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Submit your grievance","تقديم طلب تظلم")</h2></div><div class="card-b"><p class="muted small">@X("Recorded statements cannot be edited or deleted through this workflow. Submit only information intended for relations managers.","لا يمكن تعديل البيانات المسجلة أو حذفها من هذا المسار. أرسل فقط المعلومات المقصود إتاحتها لمسؤولي العلاقات.")</p><form method="post" action="/Grievances/Submit" asp-antiforgery="true" class="form-grid"><div class="field full"><label>@X("Title","العنوان")</label><input name="title" maxlength="200" required></div><div class="field full"><label>@X("Your statement and source references","بيانك ومراجع المصادر")</label><textarea name="statement" maxlength="8000" required></textarea></div><div><button class="btn btn-primary">@X("Submit internal grievance","تقديم التظلم الداخلي")</button></div></form></div></div>}
