@model GrievanceView
@{Func<string,string,string>X=(e,a)=>T.IsAr?a:e;bool manage=Me.Can(Perm.RelationsManage);}
<div class="card" style="margin-top:20px"><div class="card-h"><h2>@X("Internal response appeals","الاعتراضات الداخلية على الردود")</h2></div><div class="card-b">
<p class="muted small">@X("One immutable appeal per response, by the original submitter. An independent relations manager may uphold the response or recommend reconsideration. Neither changes the original statement or response, executes a sanction, serves notice or determines legal rights. No deadline or automatic escalation is promised. Legal and discipline appeal processes remain separate.","اعتراض واحد غير قابل للتعديل لكل رد، من مقدم الطلب الأصلي. يمكن لمسؤول علاقات مستقل تأييد الرد أو التوصية بإعادة النظر. لا يغير ذلك البيان أو الرد الأصلي، ولا ينفذ جزاءً أو يبلّغ إخطاراً أو يقرر حقوقاً قانونية. لا توجد مهلة أو إحالة تلقائية مضمونة. تظل التظلمات القانونية والتأديبية مسارات منفصلة.")</p>
@foreach(var g in Model.Submissions){
@foreach(var response in Model.Responses.Where(x=>x.GrievanceId==g.Id)){var appeal=Model.Appeals.FirstOrDefault(x=>x.ResponseId==response.Id);
@if(appeal==null&&Model.CanSubmit&&g.SubmittedByUserId==Me.UserId&&g.EmployeeId==Me.EmployeeId){<form method="post" action="/Grievances/Appeal" asp-antiforgery="true" class="form-grid"><input type="hidden" name="responseId" value="@response.Id"><div class="field full"><label>@X("Appeal response","اعتراض على الرد") #@response.Id · @X("Grievance","طلب") #@g.Id · @T.Date(response.At)</label><textarea name="note" maxlength="8000" required></textarea></div><div><button class="btn">@X("Record internal response appeal","تسجيل اعتراض داخلي على الرد")</button></div></form>}
@if(appeal!=null){var decision=Model.Decisions.FirstOrDefault(x=>x.AppealId==appeal.Id);<div class="card" style="margin-top:12px"><div class="card-b"><b>@X("Appeal of response","اعتراض على الرد") #@response.Id · @X("Grievance","طلب") #@g.Id</b><p style="white-space:pre-wrap;overflow-wrap:anywhere">@appeal.Note</p><small class="faint">@appeal.Actor · @T.Date(appeal.At)</small>
@if(decision!=null){<h4>@(decision.Decision=="ResponseUpheld"?X("Response upheld","تأييد الرد"):X("Reconsideration recommended, not executed","توصية بإعادة النظر، غير منفذة"))</h4><p style="white-space:pre-wrap;overflow-wrap:anywhere">@decision.Note</p><small class="faint">@decision.Actor · @T.Date(decision.At)</small>}
else if(manage&&g.EmployeeId!=Me.EmployeeId&&g.SubmittedByUserId!=Me.UserId&&response.ActorUserId!=Me.UserId){<form method="post" action="/Grievances/DecideAppeal" asp-antiforgery="true" class="form-grid" style="margin-top:12px"><input type="hidden" name="appealId" value="@appeal.Id"><div class="field"><label>@X("Independent disposition","الرد المستقل على الاعتراض")</label><select name="decision"><option value="ResponseUpheld">@X("Uphold response","تأييد الرد")</option><option value="ReconsiderationRecommended">@X("Recommend reconsideration only","التوصية بإعادة النظر فقط")</option></select></div><div class="field full"><label>@X("Reason visible to the submitter, no private investigation details","سبب يظهر لمقدم الطلب، دون تفاصيل التحقيق الخاصة")</label><textarea name="note" maxlength="8000" required></textarea></div><div><button class="btn">@X("Record disposition","تسجيل الرد على الاعتراض")</button></div></form>}
else{<p class="muted">@X("Awaiting independent relations-manager review","بانتظار مراجعة مسؤول علاقات مستقل")</p>}
</div></div>}}}
</div></div>
