@model List<AuditLog>
@{ ViewData["Title"] = T["nav.audit"]; string? entity = ViewBag.Entity; }
<div class="page-head"><div><h1>@T["nav.audit"]</h1><div class="sub">@T["audit.sub"]</div></div>
<div class="actions"><div class="seg">@foreach (var k in new[] { "", "Employee", "Attendance", "LeaveBalance", "PayrollRun", "PayrollLine", "Leave" }) { <a class="@((entity ?? "") == k ? "on" : "")" href="?entity=@k">@(k == "" ? T["common.all"] : k)</a> }</div></div></div>
<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>@T["audit.when"]</th><th>@T["audit.who"]</th><th>@T["audit.action"]</th><th>@T["audit.entity"]</th><th>@T["req.details"]</th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td class="num nowrap small">@a.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td class="small">@a.User</td><td>@Ui.Chip(a.Action, "blue")</td><td class="small">@a.Entity <span class="faint">@a.EntityId</span></td><td class="small muted" style="max-width:480px">@a.Details</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="empty">@T["common.none"]</td></tr> }</tbody></table></div></div>
