@model List<(int Id, string TitleKey, string Details, string? Link, DateTime CreatedAt, bool IsRead)>
@{ ViewData["Title"] = T["nav.notifications"]; }
<div class="page-head"><div><h1>@T["nav.notifications"]</h1><div class="sub">@T["notif.sub"]</div></div></div>
<div class="card"><div class="card-b tight">@if (Model.Count == 0) { <div class="empty">@T["common.none"]</div> } else { <table class="tbl"><tbody>
@foreach (var n in Model) { <tr><td style="width:36px">@if (!n.IsRead) { <span class="chip chip-violet" style="padding:0 6px">&nbsp;</span> }</td><td><b>@T[n.TitleKey]</b><div class="muted small">@n.Details</div></td><td class="right faint small">@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td class="right">@if (n.Link != null) { <a class="btn btn-sm" href="@n.Link">@T["common.open"]</a> }</td></tr> }</tbody></table> }</div></div>
